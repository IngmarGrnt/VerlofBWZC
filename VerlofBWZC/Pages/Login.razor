@page "/login"
@inject PersonApiService PersonApi
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject VerlofBWZC.Services.JwtAuthenticationStateProvider AuthProvider
@inject VerlofBWZC.Services.TokenService Tokens
@inject VerlofBWZC.Services.AppInstallService Install
@inject DialogService DialogService
@using Radzen
@using Radzen.Blazor
@using VerlofBWZC.DataContracts.DTO
@using VerlofBWZC.Services

<div class="login-container">
    <div class="login-card">
        <h3 class="text-center mb-2">Inloggen</h3>
        <EditForm Model="loginModel" OnValidSubmit="HandleLogin">
            <div class="mb-3">
                <RadzenTextBox @bind-Value="loginModel.Email" Name="Email" Placeholder="E-mail" Style="width:100%" Disabled="@busy" />
            </div>
            <div class="mb-3">
                <RadzenPassword @bind-Value="loginModel.Password" Name="Password" Placeholder="Wachtwoord" Style="width:100%" Disabled="@busy" />
            </div>
            <div class="login-remember">
                <RadzenCheckBox @bind-Value="loginModel.RememberMe" Name="RememberMe" Disabled="@busy" />
                <RadzenLabel Text="Ingelogd blijven op dit toestel" Component="RememberMe" />
                <div class="login-remember-hint">30 dagen, telkens verlengd als je de app gebruikt. Niet aanvinken op een gedeelde pc.</div>
            </div>
            <RadzenButton ButtonType="ButtonType.Submit" Text="Inloggen" Icon="login" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Large"
                          IsBusy="@busy" BusyText="Bezig met inloggen…" Style="width:100%" />
            @if (busy)
            {
                @* Feedback tijdens het wachten; na een paar seconden uitleg (server op Azure kan nog opstarten) *@
                <div class="login-wait" role="status" aria-live="polite">
                    @(slow ? "Dit duurt even langer: de server wordt mogelijk opgestart. Even geduld…" : "Je gegevens worden gecontroleerd…")
                </div>
            }
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="login-error" role="alert"><i class="rzi">error</i> @errorMessage</div>
            }
        </EditForm>
        <div class="text-center mt-3">
            <a href="/registreren" class="reg-link">Nog geen account? Registreren</a>
            @if (installReady && !Install.Current.Standalone)
            {
                @* Op elk toestel: de Verlofplanner als app installeren (installatievraag of uitleg) *@
                <div class="mt-2">
                    <button type="button" class="reg-link login-install" @onclick="InstallAppAsync">
                        <i class="bi bi-phone" aria-hidden="true"></i> Installeer als app
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private LoginDTO loginModel = new();
    private string? errorMessage;
    private bool busy;
    private bool slow;

    private bool installReady;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        await Install.InitAsync();
        installReady = true;
        StateHasChanged();
    }

    private async Task InstallAppAsync()
    {
        if (Install.Current.CanPrompt)
            await Install.PromptAsync();
        else
            await InstallHelpDialog.ShowAsync(DialogService, Install.Current);
    }

    // "Ingelogd blijven" standaard aan op een gsm of in de geïnstalleerde app, uit op een pc
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await JS.InvokeAsync<AppInstallService.State>("bwzcInstall.state");
            loginModel.RememberMe = state.Mobile || state.Standalone;
        }
        catch
        {
            loginModel.RememberMe = false;
        }
    }

    private async Task HandleLogin()
    {
        if (busy) return;
        errorMessage = null;
        busy = true;
        slow = false;
        StateHasChanged(); // meteen tonen dat er iets gebeurt

        // Na 3 seconden extra uitleg tonen
        using var cts = new CancellationTokenSource();
        _ = Task.Delay(3000, cts.Token).ContinueWith(t =>
        {
            if (t.IsCanceled) return;
            slow = true;
            InvokeAsync(StateHasChanged);
        }, TaskScheduler.Default);

        try
        {
            // Oude (demo-)sessie wissen en afmelden: een nieuwe login begint altijd zonder demo modus
            await Tokens.LogoutAsync();
            var result = await PersonApi.LoginAsync(loginModel);
            if (result.Ok && !string.IsNullOrWhiteSpace(result.Value?.Token))
            {
                await AuthProvider.MarkUserAsAuthenticated(result.Value.Token, result.Value.RefreshToken, loginModel.RememberMe);
                // Tijdelijk of zwak wachtwoord: eerst een nieuw kiezen (knop blijft "bezig" tot de pagina wisselt)
                Navigation.NavigateTo(result.Value.MustChangePassword ? "/wachtwoord-wijzigen" : "/");
                return;
            }
            errorMessage = result.Error ?? "Ongeldige inloggegevens.";
        }
        catch
        {
            errorMessage = "De server is niet bereikbaar. Probeer het straks opnieuw.";
        }
        finally
        {
            cts.Cancel();
        }
        busy = false;
        slow = false;
    }
}
