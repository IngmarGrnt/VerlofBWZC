@page "/login"
@inject PersonApiService PersonApi
@inject NavigationManager Navigation
@using Radzen
@using Radzen.Blazor
@using VerlofBWZC.DataContracts.DTO
@using VerlofBWZC.Services

<div class="d-flex justify-content-center align-items-center min-vh-100">
    <div class="card p-4 shadow" style="min-width: 320px; max-width: 400px; width: 100%;">
        <h3 class="text-center mb-2">Inloggen</h3>
        <EditForm Model="loginModel" OnValidSubmit="HandleLogin">
            <div class="mb-3">
                <RadzenTextBox @bind-Value="loginModel.Email" Name="Email" Placeholder="E-mail" Style="width:100%" />
            </div>
            <div class="mb-3">
                <RadzenPassword @bind-Value="loginModel.Password" Name="Password" Placeholder="Wachtwoord" Style="width:100%" />
            </div>
            <RadzenButton ButtonType="ButtonType.Submit" Text="Login" Style="width:100%" />
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="text-danger mt-3 text-center">@errorMessage</div>
            }
        </EditForm>
    </div>
</div>

@code {
    [Inject] IJSRuntime JS { get; set; }

    private LoginDTO loginModel = new();
    private string errorMessage;

    public class TokenResponse { public string token { get; set; } }

   

    private async Task HandleLogin()
    {
        errorMessage = null;
        var result = await PersonApi.LoginAsync(loginModel);
        if (result != null)
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "authToken", result.token);
            Navigation.NavigateTo("/");
        }
        else
        {
            errorMessage = "Ongeldige inloggegevens.";
        }
    }

   
}
