@using System.Globalization
@using Radzen
@using Radzen.Blazor
@using VerlofBWZC.Handler
@using VerlofBWZC.DataContracts.DTO
@using VerlofBWZC.Services

@page "/workcalendar"
@inject HttpClient Http
@inject NotificationService NotificationService
@inject IJSRuntime JS
@inject PersonApiService PersonApi
<h3>WerkKalender</h3>

<div style="display: flex; align-items: center; margin-bottom: 1.5rem;">
    <RadzenDropDown @bind-Value="SelectedYear"
                    Data="@Years"
                    Placeholder="Selecteer een jaar"
                    Style="width:200px; margin-right: 1.5rem;"
                    Change="OnYearChanged" />
    <div class="rz-button rz-button-info rz-border-radius-6 rz-shadow-6" style="display: flex; align-items: center; padding: 0.5rem 1.2rem; border: none;">
        <span style="color: white; font-size: 1.1rem;">
            verlofdagen geselecteerd in @SelectedYear
        </span>
        <RadzenBadge Variant="Variant.Filled"
                     BadgeStyle="BadgeStyle.Info"
                     Text="@(SelectedYearDayOffCount.ToString())"
                     Style="margin-left: 1rem; font-size: 2rem; font-weight: bold; background: transparent; color: white; box-shadow: none; border: none;" />
    </div>

   
</div>

<RadzenDataGrid Data="@monthGroups" TItem="MonthGroup" ShowPagingSummary="false" ShowPagination="false" ShowColumnPicker="false">
    <Columns>
        <RadzenDataGridColumn TItem="MonthGroup" Property="MonthName" Title="Maand" Width="90px" />
        <RadzenDataGridColumn TItem="MonthGroup" Title="Werkdagen">
            <Template Context="data">
                <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                    @foreach (var day in data.WorkDays)
                    {
                        var isSelected = selectedDays.Any(d => d.Date == day.Date && d.Shift == day.Shift);

                        <RadzenButton Variant="@(isSelected? Variant.Filled: Variant.Outlined)"
                                      ButtonStyle="@(isSelected
                                                  ? ButtonStyle.Info
                                                  : (day.Shift == "D" ? ButtonStyle.Primary : ButtonStyle.Secondary))"
                                  Text="@($"{day.Shift}{" "}{day.Date:dd-MM}")"
                                  Click="@(args => OnDayClicked(day))">
                    </RadzenButton>
                    }
                </div>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>
@if (SelectedYear == CurrentDayOffYear)
{
    <RadzenButton Style="margin-top:2rem;" Text="Opslaan" ButtonStyle="ButtonStyle.Success" Click="@SaveSelectedDays" />
}


@code {



    public class WorkDay
    {
        public DateTime Date { get; set; }
        public string Shift { get; set; }
    }

    public class MonthGroup
    {
        public string MonthName { get; set; }
        public List<WorkDay> WorkDays { get; set; } = new();
    }

    public class DayOffDTO{
        public DateTime Date { get; set; }
    }

    // NOG IN DTO STEKEN
    private List<DayOffDTO> personDaysOff = new();
    private List<MonthGroup> monthGroups = new();
    private List<WorkDay> selectedDays = new();
    // private WorkDay? selectedDay;
    // private PersonBaseDTO? person;

    string userId;
    private int SelectedYear { get; set; } = DateTime.Now.Year+1;
    private List<int> Years { get; set; } = new();
    private int CurrentDayOffYear = DateTime.Now.AddYears(1).Year;
    private int SelectedYearDayOffCount => selectedDays.Count(d => d.Date.Year == SelectedYear);


    protected override async Task OnInitializedAsync()
    {
        await LoadWorkDays();
        
        //Haal token op
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        userId = JwtUtils.GetUserIdFromToken(token);

       // Verlofdagen ophalen
        await GetDaysOff();

        //Jarenlijst vullen
        int startYear = DateTime.Now.Year-1;
        int endYear = DateTime.Now.Year + 10;
        Years = Enumerable.Range(startYear, endYear - startYear + 1).Reverse().ToList();

    }

    private async Task GetDaysOff()
    {
        if (int.TryParse(userId, out var persoonId))
        {
            personDaysOff = await Http.GetFromJsonAsync<List<DayOffDTO>>($"api/calender/person-days-off/{persoonId}");

            // Vul selectedDays met de juiste shift per dag
            selectedDays.Clear();
            foreach (var dayOff in personDaysOff)
            {
                // Zoek alle workdays op deze datum (kan dag- en nachtdienst zijn)
                var workDay = monthGroups
                    .SelectMany(mg => mg.WorkDays)
                    .FirstOrDefault(wd => wd.Date.Date == dayOff.Date.Date);

                if (workDay != null)
                {
                    selectedDays.Add(new WorkDay { Date = workDay.Date, Shift = workDay.Shift });
                }
            }
        }
    }

    private async Task OnYearChanged(object value)
    {
        if (value is int year)
        {
            SelectedYear = year;
            await LoadWorkDays();
            await GetDaysOff();
            StateHasChanged();
        }
    }

    private async Task LoadWorkDays()
    {
        var workDays = await Http.GetFromJsonAsync<List<WorkDay>>($"api/calender?teamName=Ploeg1&year={SelectedYear}");
        monthGroups = workDays
            .GroupBy(wd => wd.Date.Month)
            .Select(g => new MonthGroup
            {
                MonthName = CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(g.Key),
                WorkDays = g.OrderBy(wd => wd.Date).ToList()
            })
            .OrderBy(g => g.WorkDays.First().Date.Month)
            .ToList();
    }

    private void GetDayOffs()
    {
        // Logica om verlofdagen op te halen en selectedDays bij te werken
    }


    private void OnDayClicked(WorkDay day)
    {

        var existing = selectedDays.FirstOrDefault(d => d.Date == day.Date && d.Shift == day.Shift);
        if (existing == null)
            selectedDays.Add(day);
        else
            selectedDays.Remove(existing);
    }


    private async Task SaveSelectedDays()
    {
        var persoonId = userId;
        var payload = new
        {
            PersoonId = persoonId,
            Days = selectedDays
        };
        var response = await Http.PostAsJsonAsync("api/calender/add-dayoff", payload);

        if (response.IsSuccessStatusCode)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Opgeslagen",
                Detail = "Geselecteerde dagen zijn opgeslagen.",
                Duration = 2000
            });
        }
        else
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Fout",
                Detail = "Opslaan mislukt.",
                Duration = 2000
            });
        }
    }
    
}
