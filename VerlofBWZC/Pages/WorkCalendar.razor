@using System.Globalization
@using Radzen
@using Radzen.Blazor

@page "/workcalendar"
@inject HttpClient Http
@inject NotificationService NotificationService
@inject IJSRuntime JS

<h3>WorkCalendar</h3>

<RadzenDataGrid Data="@monthGroups" TItem="MonthGroup" ShowPagingSummary="false" ShowPagination="false" ShowColumnPicker="false">
    <Columns>
        <RadzenDataGridColumn TItem="MonthGroup" Property="MonthName" Title="Maand" Width="90px" />
        <RadzenDataGridColumn TItem="MonthGroup" Title="Werkdagen">
            <Template Context="data">
                <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                    @foreach (var day in data.WorkDays)
                    {
                        <RadzenButton Variant="Variant.Outlined"
                                      ButtonStyle="@(day.Shift == "D" ? ButtonStyle.Primary : ButtonStyle.Secondary)"
                                      Text="@($"{day.Shift}{day.Date:dd-MM}")"
                                      Click="@(args => OnDayClicked(day))">
                        </RadzenButton>
                        
                    }
                </div>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@if (selectedDays.Count > 0)
{
    <RadzenCard Style="max-width: 500px; margin-top: 2rem;">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <b>Geselecteerde dagen</b>
            <RadzenBadge Style="font-size:1.1rem;" Color="Color.Primary" Value="@selectedDays.Count" />
        </div>
        <ul class="list-group">
            @foreach (var day in selectedDays.OrderBy(x => x.Date).ThenBy(x => x.Shift))
            {
                <li class="list-group-item d-flex align-items-center">
                    <RadzenIcon Icon="event" Style="vertical-align:middle; color:#1976d2;" />
                    <span class="ms-2">@day.Date.ToString("dd-MM-yyyy") (@day.Shift)</span>
                </li>
            }
        </ul>
    </RadzenCard>
}

@code {
    public class WorkDay
    {
        public DateTime Date { get; set; }
        public string Shift { get; set; }
    }

    public class MonthGroup
    {
        public string MonthName { get; set; }
        public List<WorkDay> WorkDays { get; set; } = new();
    }

    private List<MonthGroup> monthGroups = new();
    private WorkDay? selectedDay;

    private List<WorkDay> selectedDays = new();
    protected override async Task OnInitializedAsync()
    {
        var workDays = await Http.GetFromJsonAsync<List<WorkDay>>("api/calender?teamName=Ploeg1&year=2026");

        monthGroups = workDays
            .GroupBy(wd => wd.Date.Month)
            .Select(g => new MonthGroup
            {
                MonthName = CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(g.Key),
                WorkDays = g.OrderBy(wd => wd.Date).ToList()
            })
            .OrderBy(g => g.WorkDays.First().Date.Month)
            .ToList();
    }


    private void OnDayClicked(WorkDay day)
    {
        // JS.InvokeVoidAsync("console.log", $"Geklikt op: {day.Date:dd-MM-yyyy} ({day.Shift})");
        // NotificationService.Notify(new NotificationMessage
        // {
        //     Severity = NotificationSeverity.Info,
        //     Summary = "Dag geselecteerd",
        //     Detail = $"{day.Date:dd-MM-yyyy} ({day.Shift})",
        //     Duration = 2000
        // });

        var existing = selectedDays.FirstOrDefault(d => d.Date == day.Date && d.Shift == day.Shift);
        if (existing == null)
            selectedDays.Add(day);
        else
            selectedDays.Remove(existing);
    }
    
}
