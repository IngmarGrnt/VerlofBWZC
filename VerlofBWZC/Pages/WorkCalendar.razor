@using System.Globalization
@using Radzen
@using Radzen.Blazor
@using System.Net.Http.Headers
@using VerlofBWZC.DataContracts
@using VerlofBWZC.DataContracts.DTO
@using VerlofBWZC.DataContracts.DTO.Calendar
@using VerlofBWZC.DataContracts.DTO.Holiday
@using VerlofBWZC.DataContracts.DTO.Access
@using VerlofBWZC.Handler
@using VerlofBWZC.Services
@using System.Text

@page "/workcalendar"
@inject HttpClient Http
@inject NotificationService NotificationService
@inject IJSRuntime JS
@inject PersonApiService PersonApi

<h1>WerkKalender</h1>
@if(monthGroups == null || !monthGroups.Any())
{
    <h2><em>Loading...</em></h2>
    return;
}
else
{
    <div class="workcalendar-header">
        @if (CanSaveWork)
        {
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap">
                <RadzenButton Text="Opslaan" ButtonStyle="ButtonStyle.Success" Click="@SaveSelectedDays" />
            </RadzenStack>
        }
        <RadzenDropDown @bind-Value="SelectedYear"
                        Data="@Years"
                        Placeholder="Selecteer een jaar"
                        Style="width:200px;"
                        Change="OnYearChanged" />

        <!-- Export actions -->
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenButton Text="Export PDF" ButtonStyle="ButtonStyle.Light" Click="@ExportToPdfAsync" />
            <RadzenButton Text="Export .ics (Agenda)" ButtonStyle="ButtonStyle.Light" Click="@ExportIcsAsync" />
        </RadzenStack>

        <div class="rz-button rz-button-info rz-border-radius-6 rz-shadow-6">
            <span style="color: white; font-size: 1.1rem;">
                verlofdagen geselecteerd in @SelectedYear 
            </span>
            <RadzenBadge Variant="Variant.Filled"
                         BadgeStyle="BadgeStyle.Info"
                         Text="@(SelectedYearDayOffCount.ToString())"
                         Class="rz-badge" />
        </div>

        <!-- Single legend at the top, next to the selected-days info -->
        <div class="workcalendar-legend">
            <div class="legend-item">
                <span class="legend-swatch holiday-btn-vacation"></span>
                <span>Paars = Vakantie</span>
            </div>
            <div class="legend-item">
                <span class="legend-swatch holiday-btn-feestdag"></span>
                <span>Geel = Feestdagen</span>
            </div>
            <div class="legend-item">
                <span class="legend-swatch holiday-btn-weekend"></span>
                <span>Grijs = Weekend</span>
            </div>
            <div class="legend-item">
                <span class="legend-swatch legend-swatch-info"></span>
                <span>Cyan = Verlofdagen</span>
            </div>
        </div>
    </div>

    <!-- Wrap the area we want to export to PDF -->
    <div id="workcalendar-export">
        <RadzenDataGrid Data="@monthGroups" TItem="MonthGroup" ShowPagingSummary="false" ShowPagination="false" ShowColumnPicker="false">
            <Columns>
                <RadzenDataGridColumn TItem="MonthGroup" Property="MonthName" Title="Maand" Width="90px" />
                <RadzenDataGridColumn TItem="MonthGroup" Title="Werkdagen">
                    <Template Context="data">
                        <div style="display: flex; flex-wrap: wrap; gap: 6px; ">
                            @foreach (var day in data.WorkDays)
                            {
                                var isSelected = selectedDays.Any(d => d.Date == day.Date && d.Shift == day.Shift);

                                // Alleen als NIET geselecteerd: kleurklasse bepalen
                                string holidayTypeClass = "";
                                if (!isSelected)
                                {
                                    if (PublicHolidays.Any(h => h.StartDate.Date == day.Date.Date))
                                        holidayTypeClass = "holiday-btn-feestdag";
                                    else if (SchoolHolidays.Any(h => h.StartDate.Date <= day.Date.Date && h.EndDate.Date >= day.Date.Date))
                                        holidayTypeClass = "holiday-btn-vacation";
                                    else if (day.Date.DayOfWeek == DayOfWeek.Saturday || day.Date.DayOfWeek == DayOfWeek.Sunday)
                                        holidayTypeClass = "holiday-btn-weekend";
                                }

                                <RadzenButton Variant="@(isSelected? Variant.Filled: Variant.Outlined)"
                                              ButtonStyle="@(isSelected ? ButtonStyle.Info : (day.Shift == "D" ? ButtonStyle.Primary : ButtonStyle.Secondary))"
                                              Text="@($"{day.Shift} {day.Date:ddd} {day.Date:dd}")"
                                              Click="@(args => OnDayClicked(day))"
                                              Style="margin-bottom: 1px"
                                              class="@($"{holidayTypeClass} workcalendar-day-btn")">
                                </RadzenButton>
                            }
                        </div>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>

        <!-- Holidays grid (hidden when exporting one-page) -->
        <div id="holidays-grid">
            <RadzenDataGrid Data="@(GetAllHolidaysForGrid())" 
                            TItem="HolidayGridRow" 
                            ShowPagingSummary="false" 
                            ShowPagination="false" 
                            Style="margin-top:2rem;">
                <Columns>
                    <RadzenDataGridColumn TItem="HolidayGridRow" Property="DateText" Title="Datum" Width="220px" />
                    <RadzenDataGridColumn TItem="HolidayGridRow" Property="Name" Title="Naam" Width="300px" />
                    <RadzenDataGridColumn TItem="HolidayGridRow" Property="Type" Title="Type" Width="140px" />
                </Columns>
            </RadzenDataGrid>
        </div>
    </div>
}


@code {
    private List<DayOffDTO> personDaysOff = new();
    private List<MonthGroup> monthGroups = new();
    private List<WorkDay> selectedDays = new();

    // Permissions from ManagerPanel rules
    private CalendarPermissionsDTO? _perms;
    // private bool CanSaveWork => SelectedYear == CurrentDayOffYear && (_perms?.CanSaveWorkCalendar ?? true);
    private bool CanSaveWork => (_perms?.CanSaveWorkCalendar ?? true);

    string userId;
    private int SelectedYear { get; set; } = DateTime.Now.Year+1;
    private List<int> Years { get; set; } = new();
    private int CurrentDayOffYear = DateTime.Now.AddYears(1).Year;
    private int SelectedYearDayOffCount => selectedDays.Count(d => d.Date.Year == SelectedYear);

    private List<PublicHolidayDTO> PublicHolidays { get; set; } = new();
    private List<SchoolHolidayDTO> SchoolHolidays { get; set; } = new();
    
    private class HolidayGridRow
    {
        public string DateText { get; set; }
        public string Name { get; set; }
        public string Type { get; set; }
        public DateTime? SortDate { get; set; } // Voor sortering
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadWorkDays();
        
        //Haal token op
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        userId = JwtUtils.GetUserIdFromToken(token);

        // Haal de weergavenaam op
        await ResolvePersonNameAsync();

        // Permissions ophalen op basis van claims (team/speciality) en huidig jaar
        await LoadPermissions();

        await LoadHolidaysAndVacations();
        // Verlofdagen ophalen
        await GetDaysOff();

        //Jarenlijst vullen
        int startYear = DateTime.Now.Year-1;
        int endYear = DateTime.Now.Year + 10;
        Years = Enumerable.Range(startYear, endYear - startYear + 1).Reverse().ToList();
    }

    private async Task LoadPermissions()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");

            using var req = new HttpRequestMessage(HttpMethod.Get, $"api/access/calendar-permissions?year={SelectedYear}");
            if (!string.IsNullOrEmpty(token))
                req.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var resp = await Http.SendAsync(req);
            if (resp.IsSuccessStatusCode)
            {
                _perms = await resp.Content.ReadFromJsonAsync<CalendarPermissionsDTO>();
            }
            else
            {
                _perms = null;
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "Permissies",
                    Detail = $"Permissies laden mislukt ({(int)resp.StatusCode}).",
                    Duration = 4000
                });
            }
        }
        catch (Exception ex)
        {
            _perms = null;
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Permissies",
                Detail = ex.Message,
                Duration = 4000
            });
        }
    }

    private async Task GetDaysOff()
    {
        if (int.TryParse(userId, out var persoonId))
        {
            personDaysOff = await Http.GetFromJsonAsync<List<DayOffDTO>>($"api/calender/person-days-off/{persoonId}");

            // Vul selectedDays met de juiste shift per dag
            selectedDays.Clear();
            foreach (var dayOff in personDaysOff)
            {
                // Zoek alle workdays op deze datum (kan dag- en nachtdienst zijn)
                var workDay = monthGroups
                    .SelectMany(mg => mg.WorkDays)
                    .FirstOrDefault(wd => wd.Date.Date == dayOff.Date.Date);

                if (workDay != null)
                {
                    selectedDays.Add(new WorkDay { Date = workDay.Date, Shift = workDay.Shift });
                }
            }
        }
    }
    private async Task LoadHolidaysAndVacations()
    {
        PublicHolidays = await Http.GetFromJsonAsync<List<PublicHolidayDTO>>($"api/holidays/public/{SelectedYear}") ?? new();
        SchoolHolidays = await Http.GetFromJsonAsync<List<SchoolHolidayDTO>>($"api/holidays/school/{SelectedYear}") ?? new();
    }

    private async Task OnYearChanged(object value)
    {
        if (value is int year)
        {
            SelectedYear = year;
            await LoadWorkDays();
            await GetDaysOff();
            await LoadHolidaysAndVacations();
            await LoadPermissions();
            StateHasChanged();
        }
    }

    private async Task LoadWorkDays()
    {
        var workDays = await Http.GetFromJsonAsync<List<WorkDay>>($"api/calender?teamName=Ploeg1&year={SelectedYear}");
        monthGroups = workDays
            .GroupBy(wd => wd.Date.Month)
            .Select(g => new MonthGroup
            {
                MonthName = CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(g.Key),
                WorkDays = g.OrderBy(wd => wd.Date).ToList()
            })
            .OrderBy(g => g.WorkDays.First().Date.Month)
            .ToList();
    }

    private void OnDayClicked(WorkDay day)
    {
        var existing = selectedDays.FirstOrDefault(d => d.Date == day.Date && d.Shift == day.Shift);
        if (existing == null)
            selectedDays.Add(day);
        else
            selectedDays.Remove(existing);
    }

    private async Task SaveSelectedDays()
    {
        var persoonId = userId;
        var payload = new
        {
            PersoonId = persoonId,
            Days = selectedDays
        };
        var response = await Http.PostAsJsonAsync("api/calender/add-dayoff", payload);

        if (response.IsSuccessStatusCode)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Opgeslagen",
                Detail = "Geselecteerde verlofdagen zijn opgeslagen.",
                Duration = 2000
            });
        }
        else
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Fout",
                Detail = "Opslaan van verlofdagen mislukt.",
                Duration = 2000
            });
        }
    }

    // Export the visible calendar + tables as PDF
    private async Task<bool> EnsureExportJsAsync()
    {
        try
        {
            var ok = await JS.InvokeAsync<bool>("hasExportFns");
            if (!ok)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "Export",
                    Detail = "Export scripts not loaded. Refresh the page (Ctrl+F5) and try again.",
                    Duration = 3000
                });
            }
            return ok;
        }
        catch
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Export",
                Detail = "Export scripts unavailable. Refresh the page (Ctrl+F5) and try again.",
                Duration = 3000
            });
            return false;
        }
    }

    // Export the visible calendar + tables as PDF
    private string? PersonName;

    private async Task ExportToPdfAsync()
    {
        if (!await EnsureExportJsAsync()) return;

        var displayName = string.IsNullOrWhiteSpace(PersonName) ? "Gebruiker" : PersonName;
        var title = $"{displayName} - {SelectedYear}";

        await JS.InvokeVoidAsync(
            "exportElementToPdf",
            "workcalendar-export",
            $"WerkKalender-{SelectedYear}.pdf",
            title,            // titleText (was missing)
            "landscape",      // orientation must be "landscape" or "portrait"
            true,             // fitOnePage
            true,             // compress
            "#holidays-grid", // hideSelector
            6                 // marginMm
        );
    }
    private async Task ResolvePersonNameAsync()
    {
        try
        {
            if (int.TryParse(userId, out var id))
            {
                var person = await PersonApi.GetPersonByIdAsync(id);
                if (person != null)
                {
                    var first = person.FirstName?.Trim() ?? "";
                    var last = person.LastName?.Trim() ?? "";
                    PersonName = string.Join(" ", new[] { first, last }.Where(s => !string.IsNullOrWhiteSpace(s)));
                }
            }
        }
        catch
        {
            // Laat PersonName fallbacken in ExportToPdfAsync ("Gebruiker")
        }
    }


    // Export selected days as an .ics calendar (double-click to import)
    private async Task ExportIcsAsync()
    {
        if (!await EnsureExportJsAsync()) return;

        var days = selectedDays
            .Where(d => d.Date.Year == SelectedYear)
            .OrderBy(d => d.Date)
            .ToList();

        if (days.Count == 0)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Info,
                Summary = "Geen data",
                Detail = $"Geen geselecteerde verlofdagen in {SelectedYear}.",
                Duration = 2500
            });
            return;
        }

        var utcNow = DateTime.UtcNow.ToString("yyyyMMdd'T'HHmmss'Z'");
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("BEGIN:VCALENDAR");
        sb.AppendLine("VERSION:2.0");
        sb.AppendLine("PRODID:-//VerlofBWZC//WerkKalender//NL");
        sb.AppendLine("CALSCALE:GREGORIAN");
        sb.AppendLine("METHOD:PUBLISH");

        foreach (var d in days)
        {
            var start = d.Date.Date;
            var end = start.AddDays(1);
            var uid = $"{Guid.NewGuid()}@verlofbwzc";
            var summary = $"Verlof ({d.Shift})";

            sb.AppendLine("BEGIN:VEVENT");
            sb.AppendLine($"UID:{uid}");
            sb.AppendLine($"DTSTAMP:{utcNow}");
            sb.AppendLine($"DTSTART;VALUE=DATE:{start:yyyyMMdd}");
            sb.AppendLine($"DTEND;VALUE=DATE:{end:yyyyMMdd}");
            sb.AppendLine($"SUMMARY:{summary}");
            sb.AppendLine("END:VEVENT");
        }

        sb.AppendLine("END:VCALENDAR");

        await JS.InvokeVoidAsync("downloadFile", $"Verlof-{SelectedYear}.ics", "text/calendar", sb.ToString());
    }



    private List<HolidayGridRow> GetAllHolidaysForGrid()
    {
        var holidays = PublicHolidays
            .Where(h => h.StartDate.Year == SelectedYear)
            .GroupBy(h => new
            {
                Name = h.Name?.FirstOrDefault(n => n.Language == "NL")?.Text
                    ?? h.Name?.FirstOrDefault()?.Text
                    ?? "",
                h.StartDate
            })
            .Select(g => new HolidayGridRow
            {
                DateText = g.Key.StartDate.ToString("dd-MM-yyyy"),
                Name = g.Key.Name,
                Type = "Feestdag",
                SortDate = g.Key.StartDate
            })
            .OrderBy(r => r.SortDate)
            .ToList();

        // Schoolvakanties groeperen op naam en overlappende periodes
        var vacationGroups = new List<(string Name, DateTime Start, DateTime End)>();
        var processed = new HashSet<int>();

        for (int i = 0; i < SchoolHolidays.Count; i++)
        {
            if (processed.Contains(i)) continue;

            var current = SchoolHolidays[i];
            var name = current.Name?.FirstOrDefault(n => n.Language == "NL")?.Text
                ?? current.Name?.FirstOrDefault()?.Text
                ?? "";

            // Vind alle overlappende vakanties met dezelfde naam
            var group = new List<int> { i };
            var minStart = current.StartDate;
            var maxEnd = current.EndDate;

            for (int j = 0; j < SchoolHolidays.Count; j++)
            {
                if (i == j || processed.Contains(j)) continue;

                var other = SchoolHolidays[j];
                var otherName = other.Name?.FirstOrDefault(n => n.Language == "NL")?.Text
                    ?? other.Name?.FirstOrDefault()?.Text
                    ?? "";

                // Zelfde naam en overlappende periode
                if (name == otherName &&
                    other.StartDate <= maxEnd &&
                    other.EndDate >= minStart)
                {
                    group.Add(j);
                    minStart = minStart < other.StartDate ? minStart : other.StartDate;
                    maxEnd = maxEnd > other.EndDate ? maxEnd : other.EndDate;
                }
            }

            // Markeer alle als verwerkt
            foreach (var idx in group)
                processed.Add(idx);

            vacationGroups.Add((name, minStart, maxEnd));
        }

        var vacations = vacationGroups
            .Where(g => !string.IsNullOrWhiteSpace(g.Name))
            .Select(g => new HolidayGridRow
            {
                DateText = $"van {g.Start:dd-MM-yyyy} tot {g.End:dd-MM-yyyy}",
                Name = g.Name,
                Type = "Schoolvakantie",
                SortDate = g.Start
            })
            .OrderBy(r => r.SortDate)
            .ToList();

        return holidays.Concat(vacations).ToList();
    }
}
