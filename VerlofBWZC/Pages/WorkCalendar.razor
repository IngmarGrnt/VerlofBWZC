@using System.Globalization
@using Radzen
@using Radzen.Blazor
@using System.Net.Http.Headers
@using VerlofBWZC.DataContracts
@using VerlofBWZC.DataContracts.DTO
@using VerlofBWZC.DataContracts.DTO.Calendar
@using VerlofBWZC.DataContracts.DTO.Holiday
@using VerlofBWZC.DataContracts.DTO.Access
@using VerlofBWZC.DataContracts.DTO.Leave
@using VerlofBWZC.Handler
@using VerlofBWZC.Services
@using System.Text
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@page "/workcalendar"
@inject HttpClient Http
@inject NotificationService NotificationService
@inject IJSRuntime JS
@inject PersonApiService PersonApi

<PageTitle>Werkkalender</PageTitle>

@* Waarschuwen bij verlaten van de pagina met niet-opgeslagen wijzigingen *@
<NavigationLock ConfirmExternalNavigation="@isDirty" OnBeforeInternalNavigation="OnBeforeInternalNavigation" />

@if (monthGroups == null || !monthGroups.Any())
{
    <h1>Werkkalender</h1>
    <p class="wc-loading">Werkkalender laden…</p>
    return;
}

<div class="wc">
    <!-- Kop: titel, jaar, acties -->
    <div class="wc-header">
        <div class="wc-title">
            <h1>Werkkalender</h1>
            <div class="wc-year" role="group" aria-label="Jaar kiezen">
                <button type="button" class="wc-year-btn" aria-label="Vorig jaar" disabled="@(SelectedYear <= MinYear)" @onclick="() => ChangeYear(-1)">
                    <i class="rzi">chevron_left</i>
                </button>
                <span class="wc-year-label">@SelectedYear</span>
                <button type="button" class="wc-year-btn" aria-label="Volgend jaar" disabled="@(SelectedYear >= MaxYear)" @onclick="() => ChangeYear(1)">
                    <i class="rzi">chevron_right</i>
                </button>
            </div>
            @if (isDirty)
            {
                <span class="wc-dirty"><i class="rzi">edit</i> Niet opgeslagen</span>
            }
        </div>
        <div class="wc-actions">
            <RadzenButton Text="PDF" Icon="picture_as_pdf" ButtonStyle="ButtonStyle.Light" Click="@ExportToPdfAsync" title="Exporteren als PDF" />
            <RadzenButton Text="Agenda" Icon="event" ButtonStyle="ButtonStyle.Light" Click="@ExportIcsAsync" title="Exporteren als .ics-bestand voor je agenda" />
            @if (CanSaveWork)
            {
                <RadzenButton Text="Opslaan" Icon="save" ButtonStyle="ButtonStyle.Primary" Click="@SaveSelectedDays" />
            }
        </div>
    </div>

    <div id="workcalendar-export">
        <!-- Samenvatting -->
        <div class="wc-summary">
            <div class="wc-stat">
                <div class="wc-stat-label">Verlof in @SelectedYear</div>
                <div class="wc-stat-value">
                    @SelectedYearDayOffCount
                    @if (LeaveAllowance is int max)
                    {
                        <span class="wc-stat-of">/ @max</span>
                    }
                </div>
                @if (LeaveAllowance is int allowance)
                {
                    var remaining = allowance - SelectedYearDayOffCount;
                    <div class="wc-bar"><div class="@(remaining < 0 ? "wc-bar-fill wc-bar-over" : "wc-bar-fill")" style="@($"width:{Percent(SelectedYearDayOffCount, allowance)}%")"></div></div>
                    <div class="@(remaining < 0 ? "wc-stat-note wc-over" : "wc-stat-note wc-ok")">
                        @(remaining >= 0 ? $"nog {remaining} over" : $"{-remaining} te veel")
                    </div>
                }
                else
                {
                    <div class="wc-stat-note">verlofshiften aangeduid</div>
                }
            </div>
            @if (QuarterLimits != null)
            {
                @for (var q = 1; q <= 3; q++)
                {
                    var quarter = q;
                    var usedQ = QuarterUsage(quarter);
                    var maxQ = QuarterLimits.MaxFor(quarter);
                    <div class="@(usedQ > maxQ ? "wc-stat wc-stat-over" : "wc-stat")">
                        <div class="wc-stat-label">KW@(quarter) <span class="wc-stat-period">@QuarterPeriod(quarter)</span></div>
                        <div class="wc-stat-value">@usedQ <span class="wc-stat-of">/ @maxQ</span></div>
                        <div class="wc-bar"><div class="@(usedQ > maxQ ? "wc-bar-fill wc-bar-over" : "wc-bar-fill")" style="@($"width:{Percent(usedQ, maxQ)}%")"></div></div>
                        <div class="@(usedQ > maxQ ? "wc-stat-note wc-over" : "wc-stat-note")">
                            @(usedQ > maxQ ? $"{usedQ - maxQ} boven het maximum" : $"nog {maxQ - usedQ} over")
                        </div>
                    </div>
                }
            }
            @foreach (var c in Categories)
            {
                var used = CategoryUsage(c.Id);
                var notConsecutive = c.MustBeConsecutive && !IsConsecutive(c.Id);
                <div class="@(notConsecutive ? "wc-stat wc-stat-over" : "wc-stat")">
                    <div class="wc-stat-label" title="@(c.MustBeConsecutive ? "Deze shiften moeten aansluitend zijn" : null)"><span class="wc-swatch" style="@($"background:{c.Color}")"></span>@c.Name@if (c.MustBeConsecutive)
                        {
                            <span class="wc-stat-period">aansluitend</span>
                        }</div>
                    <div class="wc-stat-value">@used <span class="wc-stat-of">/ @c.MaxShifts</span></div>
                    <div class="wc-bar"><div class="wc-bar-fill" style="@($"width:{Percent(used, c.MaxShifts)}%; background:{c.Color}")"></div></div>
                    <div class="@(notConsecutive ? "wc-stat-note wc-over" : "wc-stat-note")">@(notConsecutive ? "niet aansluitend" : c.MaxShifts - used >= 0 ? $"nog {c.MaxShifts - used} over" : "")</div>
                </div>
            }
        </div>

        <!-- Aanduiden als + legende -->
        <div class="wc-toolbar wc-no-export">
            @if (Categories.Any() && CanSaveWork)
            {
                <div class="wc-categories" role="group" aria-label="Aanduiden als">
                    <span class="wc-toolbar-label">Aanduiden als</span>
                    <button type="button" class="@(ActiveCategoryId == null ? "wc-pill wc-pill-active" : "wc-pill")"
                            style="@(ActiveCategoryId == null ? "background:var(--rz-info); border-color:var(--rz-info); color:#fff;" : "border-color:var(--rz-info); color:var(--rz-info-dark);")"
                            aria-pressed="@(ActiveCategoryId == null ? "true" : "false")"
                            @onclick="() => ActiveCategoryId = null">
                        Gewoon verlof
                    </button>
                    @foreach (var c in Categories)
                    {
                        var isActive = ActiveCategoryId == c.Id;
                        <button type="button" class="@(isActive ? "wc-pill wc-pill-active" : "wc-pill")"
                                style="@(isActive ? $"background:{c.Color}; border-color:{c.Color}; color:#fff;" : $"border-color:{c.Color}; color:{c.Color};")"
                                aria-pressed="@(isActive ? "true" : "false")"
                                @onclick="() => ActiveCategoryId = c.Id">
                            @c.Name
                        </button>
                    }
                </div>
            }
            <div class="wc-legend">
                <span><span class="wc-dot-inline wc-dot-holiday"></span>Feestdag</span>
                <span><span class="wc-dot-inline wc-dot-school"></span>Schoolvakantie</span>
                <span><span class="wc-weekend-swatch"></span>Weekend</span>
                <span><span class="wc-swatch" style="background:var(--rz-info)"></span>Verlof</span>
            </div>
        </div>
        @if (Categories.Any() && CanSaveWork)
        {
            <div class="wc-hint wc-no-export">
                @(ActiveCategoryId == null
                    ? "Klik op een shift om verlof aan of uit te zetten."
                    : "Klik op een shift om deze categorie te geven; nog eens klikken zet de shift weer uit.")
            </div>
        }

        <!-- Maanden -->
        <div class="wc-months">
            @foreach (var month in monthGroups)
            {
                var monthCount = month.WorkDays.Count(wd => selectedDays.Any(d => d.Date.Date == wd.Date.Date && d.Shift == wd.Shift));
                <section class="wc-month">
                    <header class="wc-month-header">
                        <span class="wc-month-name">@Capitalize(month.MonthName)</span>
                        <span class="@(monthCount > 0 ? "wc-month-count wc-month-count-active" : "wc-month-count")">@monthCount verlof</span>
                    </header>
                    <div class="wc-chips">
                        @foreach (var day in month.WorkDays)
                        {
                            var selected = selectedDays.FirstOrDefault(d => d.Date == day.Date && d.Shift == day.Shift);
                            var category = selected?.LeaveCategoryId is int catId ? Categories.FirstOrDefault(c => c.Id == catId) : null;
                            var holidayName = PublicHolidayName(day.Date);
                            var schoolName = holidayName == null ? SchoolHolidayName(day.Date) : null;
                            var isWeekend = day.Date.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;

                            <button type="button"
                                    class="@ChipClass(selected != null, category != null, isWeekend)"
                                    style="@(category != null ? $"background:{category.Color}; border-color:{category.Color};" : null)"
                                    title="@ChipTitle(day, category, holidayName, schoolName)"
                                    aria-pressed="@(selected != null ? "true" : "false")"
                                    @onclick="() => OnDayClicked(day)">
                                <span class="wc-chip-day">@day.Date.ToString("dd")</span>
                                <span class="wc-chip-meta">@day.Shift · @day.Date.ToString("ddd", Nl)</span>
                                @if (holidayName != null)
                                {
                                    <span class="wc-dot wc-dot-holiday"></span>
                                }
                                else if (schoolName != null)
                                {
                                    <span class="wc-dot wc-dot-school"></span>
                                }
                            </button>
                        }
                    </div>
                </section>
            }
        </div>
    </div>

    <!-- Feestdagen en schoolvakanties (niet in de PDF) -->
    <div id="holidays-grid" class="wc-holidays">
        <RadzenPanel AllowCollapse="true" Collapsed="true">
            <HeaderTemplate>
                <span class="wc-holidays-title"><i class="rzi">celebration</i> Feestdagen en schoolvakanties @SelectedYear</span>
            </HeaderTemplate>
            <ChildContent>
                <RadzenDataGrid Data="@(GetAllHolidaysForGrid())"
                                TItem="HolidayGridRow"
                                ShowPagingSummary="false"
                                ShowPagination="false">
                    <Columns>
                        <RadzenDataGridColumn TItem="HolidayGridRow" Property="DateText" Title="Datum" Width="240px" />
                        <RadzenDataGridColumn TItem="HolidayGridRow" Property="Name" Title="Naam" />
                        <RadzenDataGridColumn TItem="HolidayGridRow" Property="Type" Title="Type" Width="160px" />
                    </Columns>
                </RadzenDataGrid>
            </ChildContent>
        </RadzenPanel>
    </div>
</div>


@code {
    private static readonly CultureInfo Nl = new("nl-BE");

    private List<DayOffDTO> personDaysOff = new();
    private List<MonthGroup> monthGroups = new();
    private List<WorkDay> selectedDays = new();

    // Permissions from ManagerPanel rules
    private CalendarPermissionsDTO? _perms;
    private bool CanSaveWork => (_perms?.CanSaveWorkCalendar ?? true);

    string userId;
    private int SelectedYear { get; set; } = DateTime.Now.Year + 1;
    private int MinYear => DateTime.Now.Year - 1;
    private int MaxYear => DateTime.Now.Year + 10;
    private int SelectedYearDayOffCount => selectedDays.Count(d => d.Date.Year == SelectedYear);

    // Niet-opgeslagen wijzigingen
    private bool isDirty;

    // Verlofcategorieën (bv. Groot verlof max 8) voor ploeg/specialiteit van de gebruiker
    private List<LeaveCategoryDTO> Categories { get; set; } = new();
    private int? ActiveCategoryId;
    private string? PersonTeam;

    // Verlofaantal per jaar (ingesteld bij Personen); null = geen limiet
    private int? LeaveAllowance;

    // Kwartaalmaxima (KW1 jan-apr, KW2 mei-aug, KW3 sep-dec), ingesteld bij Verlofregels (standaard 14/16/14)
    private QuarterLimitDTO? QuarterLimits;

    private int QuarterUsage(int quarter) =>
        selectedDays.Count(d => d.Date.Year == SelectedYear && QuarterLimitDTO.QuarterOf(d.Date) == quarter);

    private static string QuarterPeriod(int quarter) => quarter switch { 1 => "jan–apr", 2 => "mei–aug", _ => "sep–dec" };

    // Waarschuwingen na het aanduiden van een shift: verlofaantal en kwartaalmaximum (opslaan blijft mogelijk)
    private void WarnIfOverLimits(DateTime date)
    {
        if (LeaveAllowance is int max && SelectedYearDayOffCount > max)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Verlofaantal overschreden",
                Detail = $"Je hebt {SelectedYearDayOffCount} verlofshiften aangeduid in {SelectedYear}, maar je verlofaantal is {max}.",
                Duration = 5000
            });
        }

        if (QuarterLimits != null && date.Year == SelectedYear)
        {
            var quarter = QuarterLimitDTO.QuarterOf(date);
            var used = QuarterUsage(quarter);
            var maxQ = QuarterLimits.MaxFor(quarter);
            if (used > maxQ)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = $"KW{quarter} overschreden",
                    Detail = $"Je hebt {used} verlofshiften in KW{quarter} ({QuarterPeriod(quarter)}), het maximum is {maxQ}.",
                    Duration = 5000
                });
            }
        }
    }

    private async Task LoadQuarterLimits()
    {
        try
        {
            QuarterLimits = await Http.GetFromJsonAsync<QuarterLimitDTO>($"api/quarter-limits/mine?year={SelectedYear}");
        }
        catch
        {
            QuarterLimits = null;
        }
    }

    private int CategoryUsage(int categoryId) =>
        selectedDays.Count(d => d.LeaveCategoryId == categoryId && d.Date.Year == SelectedYear);

    // Aansluitend: alle shiften van de categorie vormen één reeks in het werkrooster (vrije dagen ertussen tellen niet)
    private bool IsConsecutive(int categoryId)
    {
        var roster = monthGroups.SelectMany(m => m.WorkDays)
            .OrderBy(w => w.Date).ThenBy(w => w.Shift == "D" ? 0 : 1)
            .ToList();
        var positions = roster
            .Select((w, i) => (w, i))
            .Where(x => selectedDays.Any(d => d.Date == x.w.Date && d.Shift == x.w.Shift && d.LeaveCategoryId == categoryId))
            .Select(x => x.i)
            .ToList();
        return positions.Count <= 1 || positions.Max() - positions.Min() + 1 == positions.Count;
    }

    private static int Percent(int value, int max) => max <= 0 ? 0 : Math.Min(100, (int)Math.Round(100.0 * value / max));

    private static string Capitalize(string s) => string.IsNullOrEmpty(s) ? s : char.ToUpper(s[0]) + s[1..];

    private static string ChipClass(bool selected, bool hasCategory, bool isWeekend) =>
        "wc-chip"
        + (selected ? (hasCategory ? " wc-chip-category" : " wc-chip-selected") : "")
        + (!selected && isWeekend ? " wc-chip-weekend" : "");

    private static string ChipTitle(WorkDay day, LeaveCategoryDTO? category, string? holiday, string? school)
    {
        var parts = new List<string>
        {
            $"{day.Date.ToString("dddd d MMMM", Nl)} · {(day.Shift == "D" ? "dagshift" : "nachtshift")}"
        };
        if (category != null) parts.Add(category.Name);
        if (holiday != null) parts.Add($"Feestdag: {holiday}");
        if (school != null) parts.Add($"Schoolvakantie: {school}");
        return string.Join(" · ", parts);
    }

    private string? PublicHolidayName(DateTime date)
    {
        var h = PublicHolidays.FirstOrDefault(h => h.StartDate.Date == date.Date);
        return h == null ? null : (h.Name?.FirstOrDefault(n => n.Language == "NL")?.Text ?? h.Name?.FirstOrDefault()?.Text ?? "Feestdag");
    }

    private string? SchoolHolidayName(DateTime date)
    {
        var h = SchoolHolidays.FirstOrDefault(h => h.StartDate.Date <= date.Date && h.EndDate.Date >= date.Date);
        return h == null ? null : (h.Name?.FirstOrDefault(n => n.Language == "NL")?.Text ?? h.Name?.FirstOrDefault()?.Text ?? "Schoolvakantie");
    }

    private List<PublicHolidayDTO> PublicHolidays { get; set; } = new();
    private List<SchoolHolidayDTO> SchoolHolidays { get; set; } = new();

    private class HolidayGridRow
    {
        public string DateText { get; set; }
        public string Name { get; set; }
        public string Type { get; set; }
        public DateTime? SortDate { get; set; } // Voor sortering
    }

    protected override async Task OnInitializedAsync()
    {
        //Haal token op
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        userId = JwtUtils.GetUserIdFromToken(token);

        // Haal de weergavenaam en ploeg op (ploeg bepaalt het werkrooster)
        await ResolvePersonNameAsync();

        await LoadWorkDays();

        // Permissions ophalen op basis van claims (team/speciality) en huidig jaar
        await LoadPermissions();
        await LoadCategories();
        await LoadQuarterLimits();

        await LoadHolidaysAndVacations();
        // Verlofdagen ophalen
        await GetDaysOff();
    }

    private async Task LoadPermissions()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");

            using var req = new HttpRequestMessage(HttpMethod.Get, $"api/access/calendar-permissions?year={SelectedYear}");
            if (!string.IsNullOrEmpty(token))
                req.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var resp = await Http.SendAsync(req);
            if (resp.IsSuccessStatusCode)
            {
                _perms = await resp.Content.ReadFromJsonAsync<CalendarPermissionsDTO>();
            }
            else
            {
                _perms = null;
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "Permissies",
                    Detail = $"Permissies laden mislukt ({(int)resp.StatusCode}).",
                    Duration = 4000
                });
            }
        }
        catch (Exception ex)
        {
            _perms = null;
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Permissies",
                Detail = ex.Message,
                Duration = 4000
            });
        }
    }

    private async Task GetDaysOff()
    {
        if (int.TryParse(userId, out var persoonId))
        {
            personDaysOff = await Http.GetFromJsonAsync<List<DayOffDTO>>($"api/calender/person-days-off/{persoonId}");

            // Vul selectedDays met de juiste shift per dag (en eventuele verlofcategorie)
            selectedDays.Clear();
            foreach (var dayOff in personDaysOff)
            {
                var workDays = monthGroups.SelectMany(mg => mg.WorkDays).Where(wd => wd.Date.Date == dayOff.Date.Date);
                // Opgeslagen shift heeft voorrang; oudere records zonder shift nemen de eerste shift van die dag
                var workDay = workDays.FirstOrDefault(wd => wd.Shift == dayOff.Shift) ?? workDays.FirstOrDefault();

                if (workDay != null)
                {
                    selectedDays.Add(new WorkDay { Date = workDay.Date, Shift = workDay.Shift, LeaveCategoryId = dayOff.LeaveCategoryId });
                }
            }
            isDirty = false;
        }
    }

    private async Task LoadHolidaysAndVacations()
    {
        PublicHolidays = await Http.GetFromJsonAsync<List<PublicHolidayDTO>>($"api/holidays/public/{SelectedYear}") ?? new();
        SchoolHolidays = await Http.GetFromJsonAsync<List<SchoolHolidayDTO>>($"api/holidays/school/{SelectedYear}") ?? new();
    }

    private async Task ChangeYear(int delta)
    {
        var year = SelectedYear + delta;
        if (year < MinYear || year > MaxYear) return;

        if (isDirty && !await JS.InvokeAsync<bool>("confirm", "Je hebt niet-opgeslagen wijzigingen. Toch van jaar wisselen?"))
            return;

        SelectedYear = year;
        await LoadWorkDays();
        await GetDaysOff();
        await LoadHolidaysAndVacations();
        await LoadPermissions();
        await LoadCategories();
        await LoadQuarterLimits();
        StateHasChanged();
    }

    private async Task OnBeforeInternalNavigation(LocationChangingContext context)
    {
        if (isDirty && !await JS.InvokeAsync<bool>("confirm", "Je hebt niet-opgeslagen wijzigingen. Pagina toch verlaten?"))
            context.PreventNavigation();
    }

    private async Task LoadWorkDays()
    {
        var team = string.IsNullOrWhiteSpace(PersonTeam) ? "Ploeg1" : PersonTeam;
        var workDays = await Http.GetFromJsonAsync<List<WorkDay>>($"api/calender?teamName={team}&year={SelectedYear}");
        monthGroups = workDays
            .GroupBy(wd => wd.Date.Month)
            .Select(g => new MonthGroup
            {
                MonthName = Nl.DateTimeFormat.GetMonthName(g.Key),
                WorkDays = g.OrderBy(wd => wd.Date).ToList()
            })
            .OrderBy(g => g.WorkDays.First().Date.Month)
            .ToList();
    }

    private async Task LoadCategories()
    {
        try
        {
            Categories = await Http.GetFromJsonAsync<List<LeaveCategoryDTO>>($"api/leave-categories/mine?year={SelectedYear}") ?? new();
        }
        catch
        {
            Categories = new();
        }

        if (ActiveCategoryId != null && Categories.All(c => c.Id != ActiveCategoryId))
            ActiveCategoryId = null;
    }

    private void OnDayClicked(WorkDay day)
    {
        var existing = selectedDays.FirstOrDefault(d => d.Date == day.Date && d.Shift == day.Shift);

        // Gewoon verlof: shift aan/uit zetten
        if (ActiveCategoryId == null)
        {
            if (existing == null)
            {
                selectedDays.Add(new WorkDay { Date = day.Date, Shift = day.Shift });
                WarnIfOverLimits(day.Date);
            }
            else
                selectedDays.Remove(existing);
            isDirty = true;
            return;
        }

        // Categorie actief: nog eens klikken op een shift met deze categorie zet de shift volledig uit
        if (existing?.LeaveCategoryId == ActiveCategoryId)
        {
            selectedDays.Remove(existing);
            isDirty = true;
            return;
        }

        var category = Categories.First(c => c.Id == ActiveCategoryId);
        if (day.Date.Year == SelectedYear && CategoryUsage(category.Id) >= category.MaxShifts)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = category.Name,
                Detail = $"Je kan maximaal {category.MaxShifts} shiften als '{category.Name}' aanduiden.",
                Duration = 4000
            });
            return;
        }

        if (existing == null)
        {
            selectedDays.Add(new WorkDay { Date = day.Date, Shift = day.Shift, LeaveCategoryId = category.Id });
            WarnIfOverLimits(day.Date);
        }
        else
            existing.LeaveCategoryId = category.Id;
        isDirty = true;
    }

    private async Task SaveSelectedDays()
    {
        // Categorieën die aansluitend moeten zijn maar dat niet zijn: niet opslaan
        var notConsecutive = Categories.Where(c => c.MustBeConsecutive && !IsConsecutive(c.Id)).ToList();
        foreach (var c in notConsecutive)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = c.Name,
                Detail = $"De shiften van '{c.Name}' moeten aansluitend zijn (één ononderbroken reeks werkshiften).",
                Duration = 6000
            });
        }
        if (notConsecutive.Count > 0)
            return;

        var persoonId = userId;
        var payload = new
        {
            PersoonId = persoonId,
            Days = selectedDays
        };
        var response = await Http.PostAsJsonAsync("api/calender/add-dayoff", payload);

        if (response.IsSuccessStatusCode)
        {
            isDirty = false;
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Opgeslagen",
                Detail = "Je verlofdagen zijn opgeslagen.",
                Duration = 2000
            });
        }
        else
        {
            // Bij een validatiefout (bv. te veel shiften in een categorie) de reden van de server tonen
            // 400 (validatie) of 403 (bv. demo modus): de reden van de server tonen als die er is
            var serverText = response.StatusCode is System.Net.HttpStatusCode.BadRequest or System.Net.HttpStatusCode.Forbidden
                ? await response.Content.ReadAsStringAsync()
                : null;
            var reason = string.IsNullOrWhiteSpace(serverText) ? "Opslaan van verlofdagen mislukt." : serverText;
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Fout",
                Detail = reason,
                Duration = 5000
            });
        }
    }

    // Export the visible calendar + tables as PDF
    private async Task<bool> EnsureExportJsAsync()
    {
        try
        {
            var ok = await JS.InvokeAsync<bool>("hasExportFns");
            if (!ok)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "Export",
                    Detail = "Export scripts not loaded. Refresh the page (Ctrl+F5) and try again.",
                    Duration = 3000
                });
            }
            return ok;
        }
        catch
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Export",
                Detail = "Export scripts unavailable. Refresh the page (Ctrl+F5) and try again.",
                Duration = 3000
            });
            return false;
        }
    }

    private string? PersonName;

    private async Task ExportToPdfAsync()
    {
        if (!await EnsureExportJsAsync()) return;

        var displayName = string.IsNullOrWhiteSpace(PersonName) ? "Gebruiker" : PersonName;
        var title = $"{displayName} - {SelectedYear}";

        await JS.InvokeVoidAsync(
            "exportElementToPdf",
            "workcalendar-export",
            $"WerkKalender-{SelectedYear}.pdf",
            title,            // titleText
            "landscape",      // orientation must be "landscape" or "portrait"
            true,             // fitOnePage
            true,             // compress
            "#holidays-grid, .wc-no-export", // hideSelector
            6                 // marginMm
        );
    }

    private async Task ResolvePersonNameAsync()
    {
        try
        {
            if (int.TryParse(userId, out var id))
            {
                var person = await PersonApi.GetPersonByIdAsync(id);
                if (person != null)
                {
                    PersonTeam = person.Team;
                    LeaveAllowance = person.LeaveAllowance;
                    var first = person.FirstName?.Trim() ?? "";
                    var last = person.LastName?.Trim() ?? "";
                    PersonName = string.Join(" ", new[] { first, last }.Where(s => !string.IsNullOrWhiteSpace(s)));
                }
            }
        }
        catch
        {
            // Laat PersonName fallbacken in ExportToPdfAsync ("Gebruiker")
        }
    }

    // Export selected days as an .ics calendar (double-click to import)
    private async Task ExportIcsAsync()
    {
        if (!await EnsureExportJsAsync()) return;

        var days = selectedDays
            .Where(d => d.Date.Year == SelectedYear)
            .OrderBy(d => d.Date)
            .ToList();

        if (days.Count == 0)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Info,
                Summary = "Geen data",
                Detail = $"Geen geselecteerde verlofdagen in {SelectedYear}.",
                Duration = 2500
            });
            return;
        }

        var utcNow = DateTime.UtcNow.ToString("yyyyMMdd'T'HHmmss'Z'");
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("BEGIN:VCALENDAR");
        sb.AppendLine("VERSION:2.0");
        sb.AppendLine("PRODID:-//VerlofBWZC//WerkKalender//NL");
        sb.AppendLine("CALSCALE:GREGORIAN");
        sb.AppendLine("METHOD:PUBLISH");

        foreach (var d in days)
        {
            var start = d.Date.Date;
            var end = start.AddDays(1);
            var uid = $"{Guid.NewGuid()}@verlofbwzc";
            var category = d.LeaveCategoryId is int catId ? Categories.FirstOrDefault(c => c.Id == catId) : null;
            var summary = category != null ? $"{category.Name} ({d.Shift})" : $"Verlof ({d.Shift})";

            sb.AppendLine("BEGIN:VEVENT");
            sb.AppendLine($"UID:{uid}");
            sb.AppendLine($"DTSTAMP:{utcNow}");
            sb.AppendLine($"DTSTART;VALUE=DATE:{start:yyyyMMdd}");
            sb.AppendLine($"DTEND;VALUE=DATE:{end:yyyyMMdd}");
            sb.AppendLine($"SUMMARY:{summary}");
            sb.AppendLine("END:VEVENT");
        }

        sb.AppendLine("END:VCALENDAR");

        await JS.InvokeVoidAsync("downloadFile", $"Verlof-{SelectedYear}.ics", "text/calendar", sb.ToString());
    }

    private List<HolidayGridRow> GetAllHolidaysForGrid()
    {
        var holidays = PublicHolidays
            .Where(h => h.StartDate.Year == SelectedYear)
            .GroupBy(h => new
            {
                Name = h.Name?.FirstOrDefault(n => n.Language == "NL")?.Text
                    ?? h.Name?.FirstOrDefault()?.Text
                    ?? "",
                h.StartDate
            })
            .Select(g => new HolidayGridRow
            {
                DateText = g.Key.StartDate.ToString("dd-MM-yyyy"),
                Name = g.Key.Name,
                Type = "Feestdag",
                SortDate = g.Key.StartDate
            })
            .OrderBy(r => r.SortDate)
            .ToList();

        // Schoolvakanties groeperen op naam en overlappende periodes
        var vacationGroups = new List<(string Name, DateTime Start, DateTime End)>();
        var processed = new HashSet<int>();

        for (int i = 0; i < SchoolHolidays.Count; i++)
        {
            if (processed.Contains(i)) continue;

            var current = SchoolHolidays[i];
            var name = current.Name?.FirstOrDefault(n => n.Language == "NL")?.Text
                ?? current.Name?.FirstOrDefault()?.Text
                ?? "";

            // Vind alle overlappende vakanties met dezelfde naam
            var group = new List<int> { i };
            var minStart = current.StartDate;
            var maxEnd = current.EndDate;

            for (int j = 0; j < SchoolHolidays.Count; j++)
            {
                if (i == j || processed.Contains(j)) continue;

                var other = SchoolHolidays[j];
                var otherName = other.Name?.FirstOrDefault(n => n.Language == "NL")?.Text
                    ?? other.Name?.FirstOrDefault()?.Text
                    ?? "";

                // Zelfde naam en overlappende periode
                if (name == otherName &&
                    other.StartDate <= maxEnd &&
                    other.EndDate >= minStart)
                {
                    group.Add(j);
                    minStart = minStart < other.StartDate ? minStart : other.StartDate;
                    maxEnd = maxEnd > other.EndDate ? maxEnd : other.EndDate;
                }
            }

            // Markeer alle als verwerkt
            foreach (var idx in group)
                processed.Add(idx);

            vacationGroups.Add((name, minStart, maxEnd));
        }

        var vacations = vacationGroups
            .Where(g => !string.IsNullOrWhiteSpace(g.Name))
            .Select(g => new HolidayGridRow
            {
                DateText = $"van {g.Start:dd-MM-yyyy} tot {g.End:dd-MM-yyyy}",
                Name = g.Name,
                Type = "Schoolvakantie",
                SortDate = g.Start
            })
            .OrderBy(r => r.SortDate)
            .ToList();

        return holidays.Concat(vacations).ToList();
    }
