@page "/teamcalendar"
@using Radzen
@using Radzen.Blazor
@using System.Text
@using VerlofBWZC.DataContracts.DTO
@using VerlofBWZC.DataContracts.DTO.Calendar
@using VerlofBWZC.Handler
@using VerlofBWZC.Services
@inject HttpClient Http
@inject IJSRuntime JS
@inject PersonApiService PersonApi
@inject NotificationService NotificationService
<h1>Teamkalender</h1>

@if (!MonthGroups.Any())
{
    <h2><em>Loading...</em></h2>
    return;

}
else
{
    <div class="teamcalendar-toolbar">
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="1rem" Style="width:100%; margin-bottom:1rem">
            <!-- Left group -->
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                @if (CanSave)
                {
                    <RadzenButton Text="Opslaan" Icon="save" Click="@SaveTeamDaysOff" />
                }
                @if (CanExport)
                {
                    <RadzenButton Text="Exporteren naar CSV" Icon="download" Click="@ExportToCsv" />
                }
                <RadzenDropDown @bind-Value="SelectedYear"
                                Data="@Years"
                                Placeholder="Selecteer een jaar"
                                Style="width:200px"
                                Change="OnYearChanged" />
            </RadzenStack>

            <!-- Samenvatting rechts onderaan -->
            <div class="rz-mt-2" style="display:flex; justify-content:flex-end; align-items:center; gap:.5rem;">
                <span class="rz-text-secondary">Totaal werkdagen (jaar):</span>
                <RadzenBadge Text="@YearTotalWorkDays.ToString()" BadgeStyle="BadgeStyle.Primary" Variant="Variant.Filled" />

                <span class="rz-text-secondary" style="margin-left:1rem;">Quota per shift:</span>
                <RadzenBadge Text="@DailyQuota.ToString()" BadgeStyle="BadgeStyle.Info" Variant="Variant.Filled" />

                <span class="rz-text-secondary" style="margin-left:1rem;">Min. verlof per persoon:</span>
                <RadzenBadge Text="@MinimumLeavePerPersonText" BadgeStyle="BadgeStyle.Success" Variant="Variant.Filled" />
            </div>

            <!-- Right group -->
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenButton Text="Alles uitklappen" Icon="unfold_more" Click="@ExpandAllMonths" ButtonStyle="ButtonStyle.Base" />
                <RadzenButton Text="Alles inklappen" Icon="unfold_less" Click="@CollapseAllMonths" ButtonStyle="ButtonStyle.Base" />
            </RadzenStack>
        </RadzenStack>
    </div>

    <!-- Bovenliggende grid: Maanden -->
    <RadzenDataGrid @ref="monthsGrid"
                    Data="@MonthGroups"
                    TItem="MonthGroup"
                    ShowPagingSummary="false"
                    ShowPagination="false"
                    ShowColumnPicker="false"
                    AllowSorting="false"
                    AllowFiltering="false"
                    ExpandMode="DataGridExpandMode.Multiple">
        <Template Context="mg">
            <!-- Onderliggende grid: Werkdagen in de maand -->
            <RadzenDataGrid Data="@mg.Days"
                            TItem="WorkDay"
                            ShowPagingSummary="false"
                            ShowPagination="false"
                            ShowColumnPicker="false"
                            AllowSorting="false"
                            AllowFiltering="false">
                <Columns>
                    <RadzenDataGridColumn TItem="WorkDay" Property="Date" Title="Datum" Width="110px" Frozen="true" FrozenPosition="FrozenColumnPosition.Left">
                        <Template Context="wd">
                            @wd.Date.ToString("ddd dd-MM")
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="WorkDay" Property="Shift" Title="Shift" Width="70px" Frozen="true" FrozenPosition="FrozenColumnPosition.Left">
                        <Template Context="wd">
                            <RadzenBadge Text="@wd.Shift"
                                         BadgeStyle="@(wd.Shift == "D" ? BadgeStyle.Primary : BadgeStyle.Secondary)"
                                         Variant="Variant.Filled"
                                         Class="oval-badge"
                                         Style="font-size:1rem;" />
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="WorkDay" Title="Aantal" Width="70px" Frozen="true" FrozenPosition="FrozenColumnPosition.Left">
                        <Template Context="wd">
                            @{
                                var count = GetTotalSelectedDays(wd);
                                var quota = Math.Max(1, TeamMembers.Count / 4); // 24 -> 6, 23/22 -> 5, ...
                                var style = count > quota
                                ? "background: var(--rz-danger); color: white;"
                                : count == quota
                                ? "background: var(--rz-warning); color: black;"
                                : "background: var(--rz-info); color: white;";
                            }
                            <span class="oval-btn-count" style="@style">@count</span>
                        </Template>
                    </RadzenDataGridColumn>

                    @foreach (var mc in MemberColumns.Select((member, idx) => new { member, idx }))
                    {
                        <RadzenDataGridColumn TItem="WorkDay"
                                              Width="50px"
                                              Frozen="@(mc.idx == -1)"
                                              FrozenPosition="FrozenColumnPosition.Left">
                            <HeaderTemplate>
                                @if (mc.member != null)
                                {
                                    <table class="header-table" style="width:100%;height:100%;">
                                        <tr>
                                            <td style="text-align:center;vertical-align:bottom;">
                                                <span class="header-initials"
                                                      title="@($"{mc.member.FirstName} {mc.member.LastName}")">
                                                    @GetInitials(mc.member)
                                                </span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="text-align:center;vertical-align:top;">
                                                <RadzenBadge Text="@GetSelectedDayCount(mc.member.Id).ToString()"
                                                             BadgeStyle="@GetMemberBadgeStyle(mc.member.Id)"
                                                             Variant="Variant.Filled"
                                                             Class="oval-badge header-badge" />
                                            </td>
                                        </tr>
                                    </table>
                                }
                            </HeaderTemplate>
                            <Template Context="wd">
                                @if (mc.member != null)
                                {
                                    var isDayOff = selectedDays.Any(d => d.PersonId == mc.member.Id && d.Date.Date == wd.Date.Date && d.Shift == wd.Shift);
                                    
                                    @if(CanSave)
                                    {
                                        <RadzenButton Size="ButtonSize.Small"
                                                      Variant="@(isDayOff ? Variant.Filled : Variant.Outlined)"
                                                      ButtonStyle="@(isDayOff ? ButtonStyle.Info : ButtonStyle.Warning)"
                                                      Text=""
                                                      Icon="@(isDayOff ? "check" : null)"
                                                      Class="oval-btn"
                                        Click="@(args => OnDayClicked(mc.member.Id, wd))" />
                                    }
                                    else
                                    {
                                        <RadzenButton Size="ButtonSize.Small"
                                                      Variant="@(isDayOff ? Variant.Filled : Variant.Outlined)"
                                                      ButtonStyle="@(isDayOff ? ButtonStyle.Info : ButtonStyle.Warning)"
                                                      Text=""
                                                      Icon="@(isDayOff ? "check" : null)"
                                                      Class="oval-btn"
                                                      />
                                    }


                                }
                            </Template>
                        </RadzenDataGridColumn>
                    }
                </Columns>
            </RadzenDataGrid>
        </Template>
        <Columns>
            <RadzenDataGridColumn TItem="MonthGroup" Title="Maand" Width="220px">
                <Template Context="mg">
                    @mg.MonthName
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MonthGroup" Title="Werkdagen" Width="120px">
                <Template Context="mg">
                    @mg.Days.Count 
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}

@code {
    private int SelectedYear { get; set; } = DateTime.Now.Year + 1;
    private List<int> Years { get; set; } = Enumerable.Range(DateTime.Now.Year - 1, 11).ToList();

    private List<WorkDay> WorkDays = new();
    private List<MonthGroup> MonthGroups = new();

    private List<PersonBaseDTO> TeamMembers = new();
    private List<TeamDayOffDTO> TeamDaysOff = new();
    private int CurrentDayOffYear = DateTime.Now.AddYears(1).Year;

    private RadzenDataGrid<MonthGroup>? monthsGrid;

    // Authorization (simple role-based gating)
    private string? CurrentUserRole;
    private bool CanManageCalendar =>
        string.Equals(CurrentUserRole, "Admin", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(CurrentUserRole, "Manager", StringComparison.OrdinalIgnoreCase);

    private bool CanSave => SelectedYear == CurrentDayOffYear && CanManageCalendar;
    private bool CanExport => CanManageCalendar;

    //Nog in DTO zetten--------------------------------------------
    public class TeamDayOffDTO
    {
        public int PersonId { get; set; }
        public DateTime Date { get; set; }
        public string Shift { get; set; }
    }

    public class SelectedDayOffDTO
    {
        public int PersonId { get; set; }
        public DateTime Date { get; set; }
        public string Shift { get; set; }
    }
    //-------------------------------------------------------------

    // Total workdays in the selected year (same unit as mg.Days.Count: date+shift rows)
    private int YearTotalWorkDays => WorkDays?.Count ?? 0;



    // Quota per dag (zelfde logica als in de cel-weergave)
    private int DailyQuota => Math.Max(1, TeamMembers.Count / 4);

    // Minimum verlof per persoon = totaal werkdagen * quota / aantal personen
    private double MinimumLeavePerPerson => TeamMembers.Count == 0
        ? 0
        : (double)YearTotalWorkDays * DailyQuota / TeamMembers.Count;

    private string MinimumLeavePerPersonText => MinimumLeavePerPerson.ToString("0.##");
    public class MonthGroup
    {
        public int Year { get; set; }
        public int Month { get; set; }
        public string MonthName { get; set; } = "";
        public List<WorkDay> Days { get; set; } = new();
    }

    private List<SelectedDayOffDTO> selectedDays = new();

    private List<PersonBaseDTO?> MemberColumns =>
        TeamMembers
            .Concat(Enumerable.Repeat<PersonBaseDTO?>(null, Math.Max(0, 24 - TeamMembers.Count)))
            .Take(24)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadTeamCalendar();
    }

    private async Task OnYearChanged(object value)
    {
        if (value is int year)
        {
            SelectedYear = year;
            StateHasChanged(); // updates CanSave
            await LoadTeamCalendar();
            StateHasChanged();
        }
    }
    private BadgeStyle GetMemberBadgeStyle(int personId)
    {
        var count = GetSelectedDayCount(personId);

        // Hard cap threshold
        if (count > 44) return BadgeStyle.Danger;   // red

        // Over personal minimum leave
        if (count > MinimumLeavePerPerson - 1) return BadgeStyle.Warning; // orange

        // Default
        return BadgeStyle.Info; // blue
    }

    private int GetSelectedDayCount(int personId)
    {
        return selectedDays.Count(d => d.PersonId == personId);
    }

private int GetTotalSelectedDays(WorkDay wd)
{
    // Pure function: only compute and return the count (no notifications here)
    return selectedDays.Count(d => d.Date.Date == wd.Date.Date && d.Shift == wd.Shift);
}

private void OnDayClicked(int personId, WorkDay day)
{
    var existing = selectedDays.FirstOrDefault(d =>
        d.PersonId == personId &&
        d.Date.Date == day.Date.Date &&
        d.Shift == day.Shift);

    if (existing == null)
        selectedDays.Add(new SelectedDayOffDTO { PersonId = personId, Date = day.Date, Shift = day.Shift });
    else
        selectedDays.Remove(existing);

    // Only notify for the row the user just edited
    var count = selectedDays.Count(d => d.Date.Date == day.Date.Date && d.Shift == day.Shift);
    var quota = Math.Max(1, TeamMembers.Count / 4);

    if (count > quota)
    {
        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Error,
            Summary = "Fout",
            Detail = $"Opgelet: {count} verlofdagen voor {day.Date:dd/MM/yyyy} (quota: {quota}).",
            Duration = 5000
        });
    }
}

    private async Task LoadTeamCalendar()
    {
        // Haal de ingelogde gebruiker op
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        var userId = JwtUtils.GetUserIdFromToken(token);
        var person = await PersonApi.GetPersonByIdAsync(int.Parse(userId));
        var teamName = person?.Team;
        var speciality = person?.Speciality;
        CurrentUserRole = person?.Role; // capture role for authorization

        // Haal teamleden op
        TeamMembers = await Http.GetFromJsonAsync<List<PersonBaseDTO>>($"api/person/team/{teamName}/{speciality}");

        // Haal werkdagen op
        WorkDays = await Http.GetFromJsonAsync<List<WorkDay>>($"api/calender?teamName={teamName}&year={SelectedYear}");

        // Haal alle verlofdagen van het team op PER SPECIALITEIT
        TeamDaysOff = await Http.GetFromJsonAsync<List<TeamDayOffDTO>>($"api/person/team-days-off/{teamName}/{SelectedYear}/{speciality}");

        // Synchroniseer selectie met bestaande verlofdagen
        selectedDays = TeamDaysOff
            .Select(d => new SelectedDayOffDTO { PersonId = d.PersonId, Date = d.Date, Shift = d.Shift })
            .ToList();

        // Bouw maand-groepen
        MonthGroups = WorkDays
            .GroupBy(w => new { w.Date.Year, w.Date.Month })
            .OrderBy(g => g.Key.Year)
            .ThenBy(g => g.Key.Month)
            .Select(g => new MonthGroup
            {
                Year = g.Key.Year,
                Month = g.Key.Month,
                MonthName = new DateTime(g.Key.Year, g.Key.Month, 1).ToString("MMMM yyyy"),
                Days = g.OrderBy(d => d.Date).ToList()
            })
            .ToList();

        StateHasChanged();
    }

    private string GetInitials(PersonBaseDTO person)
    {
        if (string.IsNullOrWhiteSpace(person.FirstName) || string.IsNullOrWhiteSpace(person.LastName) || person.LastName.Length < 2)
            return "";
        return $"{person.FirstName[0]}{person.FirstName[1]}{person.LastName[0]}".ToUpper();
    }

    // private void OnDayClicked(int personId, WorkDay day)
    // {
    //     var existing = selectedDays.FirstOrDefault(d =>
    //         d.PersonId == personId &&
    //         d.Date.Date == day.Date.Date &&
    //         d.Shift == day.Shift);

    //     if (existing == null)
    //         selectedDays.Add(new SelectedDayOffDTO { PersonId = personId, Date = day.Date, Shift = day.Shift });
    //     else
    //         selectedDays.Remove(existing);
    // }

    private async Task SaveTeamDaysOff()
    {
        if (!CanManageCalendar)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Geen toegang",
                Detail = "Je hebt geen toestemming om te bewaren.",
                Duration = 3000
            });
            return;
        }

        // Stuur ALLE teamleden mee, ook met lege 'Days' (maakt verwijderen mogelijk)
        var persons = TeamMembers
            .Select(m => new
            {
                PersoonId = m.Id,
                Days = selectedDays
                    .Where(d => d.PersonId == m.Id && d.Date.Year == SelectedYear)
                    .Select(d => new { Date = d.Date, Shift = d.Shift })
                    .ToList()
            })
            .ToList();

        var payload = new
        {
            Year = SelectedYear,
            Persons = persons
        };

        var response = await Http.PostAsJsonAsync("api/calender/add-multiple-dayoff", payload);

        if (response.IsSuccessStatusCode)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Opgeslagen",
                Detail = "Geselecteerde verlofdagen zijn opgeslagen.",
                Duration = 2000
            });
        }
        else
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Fout",
                Detail = "Opslaan van verlofdagen mislukt.",
                Duration = 2000
            });
        }
    }

    private async Task ExportToCsv()
    {
        var csv = new StringBuilder();

        // Groepeer per datum en shift
        var grouped = selectedDays
            .GroupBy(d => new { d.Date.Date, d.Shift })
            .OrderBy(g => g.Key.Date)
            .ThenBy(g => g.Key.Shift)
            .ToList();

        // Bepaal het maximum aantal personen met verlof op één dag/shift
        int maxCount = grouped.Any() ? grouped.Max(g => g.Count()) : 0;

        // Bouw de header: Datum,Shift,V1,V2,...
        var header = new StringBuilder("Datum,Shift");
        for (int i = 1; i <= maxCount; i++)
        {
            header.Append($",V{i}");
        }
        csv.AppendLine(header.ToString());

        // Vul de rijen
        foreach (var group in grouped)
        {
            // Initialen ophalen en sorteren
            var initials = group
                .Select(d =>
                {
                    var person = TeamMembers.FirstOrDefault(p => p.Id == d.PersonId);
                    return person != null ? GetInitials(person) : "";
                })
                .Where(i => !string.IsNullOrWhiteSpace(i))
                .Distinct()
                .OrderBy(i => i)
                .ToList();

            // Bouw de regel: Datum,Shift,V1,V2,...
            var row = new StringBuilder($"{group.Key.Date:yyyy-MM-dd},{group.Key.Shift}");
            for (int i = 0; i < maxCount; i++)
            {
                row.Append(",");
                if (i < initials.Count)
                    row.Append(initials[i]);
            }
            csv.AppendLine(row.ToString());
        }

        var bytes = Encoding.UTF8.GetBytes(csv.ToString());
        var base64 = Convert.ToBase64String(bytes);

        await JS.InvokeVoidAsync("downloadFileFromBase64", "teamkalender.csv", base64);
    }

    // Expand/collapse all using Radzen DataGrid API (matches the Radzen demo pattern)
    private async Task ExpandAllMonths()
    {
        if (monthsGrid == null || MonthGroups.Count == 0) return;
        await monthsGrid.ExpandRows(MonthGroups);
    }

    private async Task CollapseAllMonths()
    {
        if (monthsGrid == null || MonthGroups.Count == 0) return;
        await monthsGrid.CollapseRows(MonthGroups);
    }
}
<script>
    function downloadFileFromBase64(filename, base64) {
        var link = document.createElement('a');
        link.download = filename;
        link.href = "data:text/csv;base64," + base64;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }
</script>