@page "/teamcalendar"
@using Radzen
@using Radzen.Blazor
@using System.Text
@using VerlofBWZC.DataContracts.DTO
@using VerlofBWZC.DataContracts.DTO.Calendar
@using VerlofBWZC.Handler
@using VerlofBWZC.Services
@inject HttpClient Http
@inject IJSRuntime JS
@inject PersonApiService PersonApi
@inject NotificationService NotificationService
<h1>Teamkalender</h1>

@if(!WorkDays.Any())
{
    <h2><em>Loading...</em></h2>
}
else
{
    <div class="teamcalendar-toolbar">
        @if (SelectedYear == CurrentDayOffYear)
        {
            <RadzenButton Text="Opslaan" Icon="save" Style="margin-top:1rem;" Click="@SaveTeamDaysOff" />
        }
        <RadzenButton Text="Exporteren naar CSV" Icon="download" Click="@ExportToCsv" Style="margin:1rem;" />
        <RadzenDropDown @bind-Value="SelectedYear"
                        Data="@Years"
                        Placeholder="Selecteer een jaar"
                        Style="width:200px; margin-bottom: 1rem;"
                        Change="OnYearChanged" />
    </div>

    <RadzenDataGrid Data="@WorkDays" TItem="WorkDay" ShowPagingSummary="false" ShowPagination="false" ShowColumnPicker="false">
        <Columns>
            <RadzenDataGridColumn TItem="WorkDay" Property="Date" Title="Datum" Width="100px">
                <Template Context="wd">
                    @wd.Date.ToString("MMM-dd-MM")
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="WorkDay" Property="Shift" Title="Shift" Width="60px">
                <Template Context="wd">
                    <RadzenBadge Text="@wd.Shift"
                                 BadgeStyle="@(wd.Shift == "D" ? BadgeStyle.Primary : BadgeStyle.Secondary)"
                                 Variant="Variant.Filled"
                                 Class="oval-badge"
                                 Style="font-size:1rem;" />
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="WorkDay" Title="Aantal" Width="60px">
                <Template Context="wd">
                    @{
                        var count = @GetTotalSelectedDays(wd);
                        var style = count >= 7
                        ? "background: var(--rz-danger); color: white;"
                        : count == 6
                        ? "background: var(--rz-warning); color: black;"
                        : "background: var(--rz-info); color: white;";
                    }
                    <span class="oval-btn-count" style="@style">@count</span>
                </Template>
            </RadzenDataGridColumn>

            @foreach (var member in MemberColumns)
            {
<RadzenDataGridColumn TItem="WorkDay" Width="60px">
                    <HeaderTemplate>
                        @if (member != null)
                        {
                            <table class="header-table" style="width:100%;height:100%;">
                                <tr>
                                    <td style="text-align:center;vertical-align:bottom;">
                                        <span class="header-initials">@GetInitials(member)</span>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="text-align:center;vertical-align:top;">
                                        <RadzenBadge Text="@GetSelectedDayCount(member.Id).ToString()"
                                                     BadgeStyle="BadgeStyle.Info"
                                                     Variant="Variant.Filled"
                                                     Class="oval-badge header-badge" />
                                    </td>
                                </tr>
                            </table>
                        }
                    </HeaderTemplate>
                    <Template Context="wd">
                        @if (member != null)
                        {
                            var isDayOff = selectedDays.Any(d => d.PersonId == member.Id && d.Date.Date == wd.Date.Date && d.Shift == wd.Shift);
                            <RadzenButton Size="ButtonSize.Small"
                                          Variant="@(isDayOff ? Variant.Filled : Variant.Outlined)"
                                          ButtonStyle="@(isDayOff ? ButtonStyle.Info : ButtonStyle.Warning)"
                                          Text=""
                                          Icon="@(isDayOff ? "check" : null)"
                                          Class="oval-btn"
                                          Click="@(args => OnDayClicked(member.Id, wd))" />
                        }
                    </Template>
                </RadzenDataGridColumn>
            }
        </Columns>
    </RadzenDataGrid>
}





@code {
    private int SelectedYear { get; set; } = DateTime.Now.Year + 1;
    private List<int> Years { get; set; } = Enumerable.Range(DateTime.Now.Year - 1, 11).ToList();
    private List<WorkDay> WorkDays = new();
    private List<PersonBaseDTO> TeamMembers = new();
    private List<TeamDayOffDTO> TeamDaysOff = new();
    private int CurrentDayOffYear = DateTime.Now.AddYears(1).Year;


    //Nog in DTO zetten--------------------------------------------
    public class TeamDayOffDTO
    {
        public int PersonId { get; set; }
        public DateTime Date { get; set; }
        public string Shift { get; set; }
    }

    public class SelectedDayOffDTO
    {
        public int PersonId { get; set; }
        public DateTime Date { get; set; }
        public string Shift { get; set; }
    }
    //-------------------------------------------------------------

    private List<SelectedDayOffDTO> selectedDays = new();

    private List<PersonBaseDTO?> MemberColumns =>
    TeamMembers
        .Concat(Enumerable.Repeat<PersonBaseDTO?>(null, Math.Max(0, 24 - TeamMembers.Count)))
        .Take(24)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadTeamCalendar();
    }

    private async Task OnYearChanged(object value)
    {
        if (value is int year)
        {
            SelectedYear = year;
            await LoadTeamCalendar();
            StateHasChanged();
        }
    }

    private int GetSelectedDayCount(int personId)
    {
        return selectedDays.Count(d => d.PersonId == personId);
    }

    private int GetTotalSelectedDays(WorkDay wd)
    {
        int count = selectedDays.Count(d => d.Date.Date == wd.Date.Date && d.Shift == wd.Shift);

        if(count > 6)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Fout",
                Detail = $"Opgelet er zijn voor {wd.Date.ToShortDateString()} - {count} verlofdagen geselecteerd.",
                Duration = 8000
            });
        }
        return count;


    }

    private async Task LoadTeamCalendar()
    {
        // Haal de ingelogde gebruiker op
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        var userId = JwtUtils.GetUserIdFromToken(token);
        var person = await PersonApi.GetPersonByIdAsync(int.Parse(userId));
        var teamName = person?.Team;
        var speciality = person?.Speciality;    



        //Nog in API Service toevoegen----------------------------
        // Haal teamleden op
        TeamMembers = await Http.GetFromJsonAsync<List<PersonBaseDTO>>($"api/person/team/{teamName}/{speciality}");

        // Haal werkdagen op
        WorkDays = await Http.GetFromJsonAsync<List<WorkDay>>($"api/calender?teamName={teamName}&year={SelectedYear}");

        // Haal alle verlofdagen van het team op PER SPECIALITEIT///

        TeamDaysOff = await Http.GetFromJsonAsync<List<TeamDayOffDTO>>($"api/person/team-days-off/{teamName}/{SelectedYear}/{speciality}");

        //------------------------------------------------------    
        // Synchroniseer selectie met bestaande verlofdagen
        selectedDays = TeamDaysOff
            .Select(d => new SelectedDayOffDTO { PersonId = d.PersonId, Date = d.Date, Shift = d.Shift })
            .ToList();

        StateHasChanged();
    }

    private string GetInitials(PersonBaseDTO person)
    {
        if (string.IsNullOrWhiteSpace(person.FirstName) || string.IsNullOrWhiteSpace(person.LastName))
            return "";
        return $"{person.LastName[0]}{person.LastName[1]}{person.FirstName[0]}".ToUpper();
    }



    private void OnDayClicked(int personId, WorkDay day)
    {
        var existing = selectedDays.FirstOrDefault(d =>
            d.PersonId == personId &&
            d.Date.Date == day.Date.Date &&
            d.Shift == day.Shift);

        if (existing == null)
            selectedDays.Add(new SelectedDayOffDTO { PersonId = personId, Date = day.Date, Shift = day.Shift });
        else
            selectedDays.Remove(existing);
    }

    private async Task SaveTeamDaysOff()
    {
        // Groepeer geselecteerde dagen per persoon
        var persons = selectedDays
            .GroupBy(d => d.PersonId)
            .Select(g => new
            {
                persoonId = g.Key,
                days = g.Select(d => new { date = d.Date, shift = d.Shift }).ToList()
            })
            .ToList();

        // Payload als object met property 'persons'
        var payload = new { persons };

        var response = await Http.PostAsJsonAsync("api/calender/add-multiple-dayoff", payload);

        if (response.IsSuccessStatusCode)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Opgeslagen",
                Detail = "Geselecteerde verlofdagen zijn opgeslagen.",
                Duration = 2000
            });
        }
        else
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Fout",
                Detail = "Opslaan van verlofdagen mislukt.",
                Duration = 2000
            });
        }
    }

    private async Task ExportToCsv()
    {
        var csv = new StringBuilder();

        // Groepeer per datum en shift
        var grouped = selectedDays
            .GroupBy(d => new { d.Date.Date, d.Shift })
            .OrderBy(g => g.Key.Date)
            .ThenBy(g => g.Key.Shift)
            .ToList();

        // Bepaal het maximum aantal personen met verlof op één dag/shift
        int maxCount = grouped.Any() ? grouped.Max(g => g.Count()) : 0;

        // Bouw de header: Datum,Shift,V1,V2,...
        var header = new StringBuilder("Datum,Shift");
        for (int i = 1; i <= maxCount; i++)
        {
            header.Append($",V{i}");
        }
        csv.AppendLine(header.ToString());

        // Vul de rijen
        foreach (var group in grouped)
        {
            // Initialen ophalen en sorteren
            var initials = group
                .Select(d =>
                {
                    var person = TeamMembers.FirstOrDefault(p => p.Id == d.PersonId);
                    return person != null ? GetInitials(person) : "";
                })
                .Where(i => !string.IsNullOrWhiteSpace(i))
                .Distinct()
                .OrderBy(i => i)
                .ToList();

            // Bouw de regel: Datum,Shift,V1,V2,...
            var row = new StringBuilder($"{group.Key.Date:yyyy-MM-dd},{group.Key.Shift}");
            for (int i = 0; i < maxCount; i++)
            {
                row.Append(",");
                if (i < initials.Count)
                    row.Append(initials[i]);
            }
            csv.AppendLine(row.ToString());
        }

        var bytes = Encoding.UTF8.GetBytes(csv.ToString());
        var base64 = Convert.ToBase64String(bytes);

        await JS.InvokeVoidAsync("downloadFileFromBase64", "teamkalender.csv", base64);
    }
}
<script>
    function downloadFileFromBase64(filename, base64) {
        var link = document.createElement('a');
        link.download = filename;
        link.href = "data:text/csv;base64," + base64;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }
</script>
