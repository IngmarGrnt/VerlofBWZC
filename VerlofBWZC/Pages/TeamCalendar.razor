    // Per persoon: categorieën met "aansluitend" waarvan de shiften geen ononderbroken reeks in het rooster vormen
    private List<string> NotConsecutiveWarnings()
    {
        var roster = WorkDays.OrderBy(w => w.Date).ThenBy(w => w.Shift == "D" ? 0 : 1).ToList();
        var warnings = new List<string>();

        foreach (var member in TeamMembers)
        {
            foreach (var category in LeaveCategories.Where(c => c.MustBeConsecutive && c.Speciality == member.Speciality))
            {
                var positions = roster
                    .Select((w, i) => (w, i))
                    .Where(x => selectedDays.Any(d => d.PersonId == member.Id && d.Date.Date == x.w.Date.Date && d.Shift == x.w.Shift && d.LeaveCategoryId == category.Id))
                    .Select(x => x.i)
                    .ToList();

                if (positions.Count > 1 && positions.Max() - positions.Min() + 1 != positions.Count)
                    warnings.Add($"{member.FirstName} {member.LastName}: '{category.Name}' is niet aansluitend");
            }
        }
        return warnings;
    }

    // Verlof neem je normaal per 2 shiften: dagshift (D) op dag X + nachtshift (N) op dag X+1.
    // Een losse shift is een aangeduide shift waarvan de partner (voor dezelfde persoon) niet aangeduid is.
    private bool IsLoose(SelectedDayOffDTO day)
    {
        var partnerDate = day.Shift == "D" ? day.Date.Date.AddDays(1) : day.Date.Date.AddDays(-1);
        var partnerShift = day.Shift == "D" ? "N" : "D";
        return !selectedDays.Any(d => d.PersonId == day.PersonId && d.Date.Date == partnerDate && d.Shift == partnerShift);
    }

    private int LooseCount(int personId) =>
        selectedDays.Count(d => d.PersonId == personId && d.Date.Year == SelectedYear && IsLoose(d));

    private async Task SaveTeamDaysOff()
    {
        if (!CanManageCalendar)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Geen toegang",
                Detail = "Je hebt geen toestemming om te bewaren.",
                Duration = 3000
            });
            return;
        }

        // Categorieën die aansluitend moeten zijn: niet opslaan zolang het bij iemand niet aansluit
        var notConsecutive = NotConsecutiveWarnings();
        if (notConsecutive.Count > 0)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Niet opgeslagen: niet aansluitend",
                Detail = string.Join("; ", notConsecutive),
                Duration = 8000
            });
            return;
        }

        // Losse shiften mogen, maar enkel bewust: eerst bevestigen
        var loose = TeamMembers
            .Select(m => (member: m, count: LooseCount(m.Id)))
            .Where(x => x.count > 0)
            .ToList();
        if (loose.Count > 0)
        {
            var list = string.Join(", ", loose.Take(8).Select(x => $"{x.member.FirstName} {x.member.LastName} ({x.count})"))
                + (loose.Count > 8 ? $" en nog {loose.Count - 8} personen" : "");
            var confirmed = await DialogService.Confirm(
                $"Er zijn losse shiften (dag zonder nacht of omgekeerd) bij: {list}. Verlof neem je normaal per 2 shiften. Toch opslaan?",
                "Losse shiften",
                new ConfirmOptions { OkButtonText = "Opslaan", CancelButtonText = "Terug" });
            if (confirmed != true)
                return;
        }

        // Stuur ALLE teamleden mee, ook met lege 'Days' (maakt verwijderen mogelijk)
        var persons = TeamMembers
            .Select(m => new
            {
                PersoonId = m.Id,
                Days = selectedDays
                    .Where(d => d.PersonId == m.Id && d.Date.Year == SelectedYear)
                    .Select(d => new { Date = d.Date, Shift = d.Shift, LeaveCategoryId = d.LeaveCategoryId })
                    .ToList()
            })
            .ToList();

        var payload = new
        {
            Year = SelectedYear,
            Persons = persons
        };

        var response = await Http.PostAsJsonAsync("api/calender/add-multiple-dayoff", payload);

        if (response.IsSuccessStatusCode)
        {
            isDirty = false;
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Opgeslagen",
                Detail = "Geselecteerde verlofdagen zijn opgeslagen.",
                Duration = 2000
            });
        }
        else
        {
            // Bij een validatiefout (bv. maximum van een verlofcategorie) de reden van de server tonen
            // 400 (validatie) of 403 (bv. demo modus): de reden van de server tonen als die er is
            var serverText = response.StatusCode is System.Net.HttpStatusCode.BadRequest or System.Net.HttpStatusCode.Forbidden
                ? await response.Content.ReadAsStringAsync()
                : null;
            var reason = string.IsNullOrWhiteSpace(serverText) ? "Opslaan van verlofdagen mislukt." : serverText;
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Fout",
                Detail = reason,
                Duration = 5000
            });
        }
    }

    private async Task ExportToCsv()
    {
        var csv = new StringBuilder();

        // Groepeer per datum en shift
        var grouped = selectedDays
            .GroupBy(d => new { d.Date.Date, d.Shift })
            .OrderBy(g => g.Key.Date)
            .ThenBy(g => g.Key.Shift)
            .ToList();

        // Bepaal het maximum aantal personen met verlof op één dag/shift
        int maxCount = grouped.Any() ? grouped.Max(g => g.Count()) : 0;

        // Bouw de header: Datum,Shift,V1,V2,...
        var header = new StringBuilder("Datum,Shift");
        for (int i = 1; i <= maxCount; i++)
        {
            header.Append($",V{i}");
        }
        csv.AppendLine(header.ToString());

        // Vul de rijen
        foreach (var group in grouped)
        {
            // Initialen ophalen en sorteren
            var initials = group
                .Select(d =>
                {
                    var person = TeamMembers.FirstOrDefault(p => p.Id == d.PersonId);
                    return person != null ? GetInitials(person) : "";
                })
                .Where(i => !string.IsNullOrWhiteSpace(i))
                .Distinct()
                .OrderBy(i => i)
                .ToList();

            // Bouw de regel: Datum,Shift,V1,V2,...
            var row = new StringBuilder($"{group.Key.Date:yyyy-MM-dd},{group.Key.Shift}");
            for (int i = 0; i < maxCount; i++)
            {
                row.Append(",");
                if (i < initials.Count)
                    row.Append(initials[i]);
            }
            csv.AppendLine(row.ToString());
        }

        var bytes = Encoding.UTF8.GetBytes(csv.ToString());
        var base64 = Convert.ToBase64String(bytes);

        await JS.InvokeVoidAsync("downloadFileFromBase64", "teamkalender.csv", base64);
    }

