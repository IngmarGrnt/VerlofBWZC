@page "/teamcalendar"
@using Radzen
@using Radzen.Blazor
@using System.Text
@using System.Net.Http.Headers
@using VerlofBWZC.DataContracts.DTO
@using VerlofBWZC.DataContracts.DTO.Access
@using VerlofBWZC.DataContracts.DTO.Calendar
@using VerlofBWZC.DataContracts.DTO.Leave
@using VerlofBWZC.Handler
@using VerlofBWZC.Services
@inject HttpClient Http
@inject IJSRuntime JS
@inject PersonApiService PersonApi
@inject NotificationService NotificationService

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<h1>Teamkalender</h1>

@if (!MonthGroups.Any())
{
    <h2><em>Loading...</em></h2>
    return;

}
else
{
    <div class="teamcalendar-toolbar">
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="1rem" Style="width:100%; margin-bottom:1rem">
            <!-- Left group -->
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                @if (CanSaveTeamCalendar)
                {
                    <RadzenButton Text="Opslaan" Icon="save" Click="@SaveTeamDaysOff" />
                }
                @if (CanExport)
                {
                    <RadzenButton Text="Exporteren naar CSV" Icon="download" Click="@ExportToCsv" />
                }
                <RadzenDropDown @bind-Value="SelectedYear"
                                Data="@Years"
                                Placeholder="Selecteer een jaar"
                                Style="width:200px"
                                Change="OnYearChanged" />
                @if (IsAdmin)
                {
                    <RadzenDropDown TValue="string" @bind-Value="SelectedTeam"
                                    Data="@TeamOptions"
                                    Placeholder="Ploeg"
                                    Style="width:160px"
                                    Change="OnTeamOrSpecialityChanged" />
                    <RadzenDropDown TValue="string" @bind-Value="SelectedSpeciality"
                                    Data="@SpecialityOptions"
                                    Placeholder="Specialiteit"
                                    Style="width:220px"
                                    Change="OnTeamOrSpecialityChanged" />
                }
            </RadzenStack>

            <!-- Samenvatting rechts onderaan -->
            <div class="rz-mt-2" style="display:flex; justify-content:flex-end; align-items:center; gap:.5rem;">
                <span class="rz-text-secondary">Totaal werkdagen (jaar):</span>
                <RadzenBadge Text="@YearTotalWorkDays.ToString()" BadgeStyle="BadgeStyle.Primary" Variant="Variant.Filled" />

                <span class="rz-text-secondary" style="margin-left:1rem;">Quota per shift:</span>
                <RadzenBadge Text="@DailyQuota.ToString()" BadgeStyle="BadgeStyle.Info" Variant="Variant.Filled" />

                <span class="rz-text-secondary" style="margin-left:1rem;">Min. verlof per persoon:</span>
                <RadzenBadge Text="@MinimumLeavePerPersonText" BadgeStyle="BadgeStyle.Success" Variant="Variant.Filled" />

                <span class="rz-text-secondary" style="margin-left:1rem;">Aantal Pers:</span>
                <RadzenBadge Text="@TeamMemberCount" BadgeStyle="BadgeStyle.Secondary" Variant="Variant.Filled" />
            </div>

            <!-- Right group -->
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenButton Text="Alles uitklappen" Icon="unfold_more" Click="@ExpandAllMonths" ButtonStyle="ButtonStyle.Base" />
                <RadzenButton Text="Alles inklappen" Icon="unfold_less" Click="@CollapseAllMonths" ButtonStyle="ButtonStyle.Base" />
            </RadzenStack>
        </RadzenStack>

        @if (LeaveCategories.Any())
        {
            <!-- Legende verlofcategorieën -->
            <div class="rz-mb-2" style="display:flex; flex-wrap:wrap; align-items:center; gap:.75rem;">
                <span class="rz-text-secondary">Verlofcategorieën:</span>
                @foreach (var c in LeaveCategories.GroupBy(c => c.Name).Select(g => g.First()))
                {
                    <span style="display:inline-flex; align-items:center; gap:.3rem;">
                        <span style="@($"display:inline-block; width:14px; height:14px; border-radius:50%; background:{c.Color};")"></span>
                        @c.Name
                    </span>
                }
            </div>
        }

        @if (IsAdmin && ShowAllSpecialities)
        {
            <!-- Samenstelling van de ploeg per specialiteit -->
            <div class="rz-mb-2" style="display:flex; flex-wrap:wrap; align-items:center; gap:.5rem;">
                <span class="rz-text-secondary">Samenstelling @SelectedTeam:</span>
                @if (!TeamMembers.Any())
                {
                    <span class="rz-text-secondary"><em>geen leden</em></span>
                }
                @* Zelfde volgorde als de kolommen *@
                @foreach (var g in TeamMembers.GroupBy(m => string.IsNullOrWhiteSpace(m.Speciality) ? "(geen)" : m.Speciality))
                {
                    <RadzenBadge Text="@($"{g.Key}: {g.Count()}")" BadgeStyle="BadgeStyle.Secondary" Variant="Variant.Filled" />
                }
            </div>
        }
    </div>

    <!-- Bovenliggende grid: Maanden -->
    <RadzenDataGrid @ref="monthsGrid"
                    Data="@MonthGroups"
                    TItem="MonthGroup"
                    ShowPagingSummary="false"
                    ShowPagination="false"
                    ShowColumnPicker="false"
                    AllowSorting="false"
                    AllowFiltering="false"
                    ExpandMode="DataGridExpandMode.Multiple">
        <Template Context="mg">
            <!-- Onderliggende grid: Werkdagen in de maand -->
            <RadzenDataGrid Data="@mg.Days"
                            TItem="WorkDay"
                            ShowPagingSummary="false"
                            ShowPagination="false"
                            ShowColumnPicker="false"
                            AllowSorting="false"
                            AllowFiltering="false">
                <Columns>
                    <RadzenDataGridColumn TItem="WorkDay" Property="Date" Title="Datum" Width="110px" Frozen="true" FrozenPosition="FrozenColumnPosition.Left">
                        <Template Context="wd">
                            @wd.Date.ToString("ddd dd-MM")
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="WorkDay" Property="Shift" Title="Shift" Width="70px" Frozen="true" FrozenPosition="FrozenColumnPosition.Left">
                        <Template Context="wd">
                            <RadzenBadge Text="@wd.Shift"
                                         BadgeStyle="@(wd.Shift == "D" ? BadgeStyle.Primary : BadgeStyle.Secondary)"
                                         Variant="Variant.Filled"
                                         Class="oval-badge"
                                         Style="font-size:1rem;" />
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="WorkDay" Title="Aantal" Width="70px" Frozen="true" FrozenPosition="FrozenColumnPosition.Left">
                        <Template Context="wd">
                            @{
                                var count = GetTotalSelectedDays(wd);
                                var quota = Math.Max(1, TeamMembers.Count / 4); // 24 -> 6, 23/22 -> 5, ...
                                var style = count > quota
                                ? "background: var(--rz-danger); color: white;"
                                : count == quota
                                ? "background: var(--rz-warning); color: black;"
                                : "background: var(--rz-info); color: white;";
                            }
                            <span class="oval-btn-count" style="@style">@count</span>
                        </Template>
                    </RadzenDataGridColumn>

                    @foreach (var mc in MemberColumns.Select((member, idx) => new { member, idx }))
                    {
                        <RadzenDataGridColumn TItem="WorkDay"
                                              Width="50px"
                                              Frozen="@(mc.idx == -1)"
                                              FrozenPosition="FrozenColumnPosition.Left">
                            <HeaderTemplate>
                                @if (mc.member != null)
                                {
                                    <table class="header-table" style="width:100%;height:100%;">
                                        <tr>
                                            <td style="text-align:center;vertical-align:bottom;">
                                                <span class="header-initials"
                                                      title="@($"{mc.member.FirstName} {mc.member.LastName} - {mc.member.Speciality}")">
                                                    @GetInitials(mc.member)
                                                </span>
                                                @if (ShowAllSpecialities)
                                                {
                                                    <div style="font-size:.65rem; line-height:1; opacity:.75;" title="@mc.member.Speciality">
                                                        @ShortSpeciality(mc.member.Speciality)
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="text-align:center;vertical-align:top;">
                                                <RadzenBadge Text="@GetSelectedDayCount(mc.member.Id).ToString()"
                                                             BadgeStyle="@GetMemberBadgeStyle(mc.member.Id)"
                                                             Variant="Variant.Filled"
                                                             Class="oval-badge header-badge" />
                                            </td>
                                        </tr>
                                    </table>
                                }
                            </HeaderTemplate>
                            <Template Context="wd">
                                @if (mc.member != null)
                                {
                                    var dayOff = selectedDays.FirstOrDefault(d => d.PersonId == mc.member.Id && d.Date.Date == wd.Date.Date && d.Shift == wd.Shift);
                                    var isDayOff = dayOff != null;
                                    var category = dayOff?.LeaveCategoryId is int catId ? LeaveCategories.FirstOrDefault(c => c.Id == catId) : null;
                                    var cellStyle = category != null ? $"background-color:{category.Color}; border-color:{category.Color}; color:#fff;" : null;

                                    @if(CanSaveTeamCalendar)
                                    {
                                        <RadzenButton Size="ButtonSize.Small"
                                                      Variant="@(isDayOff ? Variant.Filled : Variant.Outlined)"
                                                      ButtonStyle="@(isDayOff ? ButtonStyle.Info : ButtonStyle.Warning)"
                                                      Text=""
                                                      Icon="@(isDayOff ? "check" : null)"
                                                      Class="oval-btn"
                                                      Style="@cellStyle"
                                                      title="@(category?.Name)"
                                        Click="@(args => OnDayClicked(mc.member.Id, wd))" />
                                    }
                                    else
                                    {
                                        <RadzenButton Size="ButtonSize.Small"
                                                      Variant="@(isDayOff ? Variant.Filled : Variant.Outlined)"
                                                      ButtonStyle="@(isDayOff ? ButtonStyle.Info : ButtonStyle.Warning)"
                                                      Text=""
                                                      Icon="@(isDayOff ? "check" : null)"
                                                      Class="oval-btn"
                                                      Style="@cellStyle"
                                                      title="@(category?.Name)"
                                                      />
                                    }


                                }
                            </Template>
                        </RadzenDataGridColumn>
                    }
                </Columns>
            </RadzenDataGrid>
        </Template>
        <Columns>
            <RadzenDataGridColumn TItem="MonthGroup" Title="Maand" Width="220px">
                <Template Context="mg">
                    @mg.MonthName
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MonthGroup" Title="Werkdagen" Width="120px">
                <Template Context="mg">
                    @mg.Days.Count 
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}

@code {
    private int SelectedYear { get; set; } = DateTime.Now.Year + 1;
    private List<int> Years { get; set; } = Enumerable.Range(DateTime.Now.Year - 1, 11).ToList();

    private List<WorkDay> WorkDays = new();
    private List<MonthGroup> MonthGroups = new();

    private List<PersonBaseDTO> TeamMembers = new();
    private List<TeamDayOffDTO> TeamDaysOff = new();
    private int CurrentDayOffYear = DateTime.Now.AddYears(1).Year;

    private RadzenDataGrid<MonthGroup>? monthsGrid;

    // Authorization (simple role-based gating)
    private string? CurrentUserRole;
    private bool CanManageCalendar =>
        string.Equals(CurrentUserRole, "Admin", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(CurrentUserRole, "Manager", StringComparison.OrdinalIgnoreCase);



    // Permissions from ManagerPanel rules
    private CalendarPermissionsDTO? _perms;

    //private bool CanSave => CanManageCalendar;
    private bool CanSaveTeamCalendar => ((_perms?.CanSaveTeamCalendar ?? true) && CanManageCalendar);
    private bool CanExport => CanManageCalendar;

    //Nog in DTO zetten--------------------------------------------
    public class TeamDayOffDTO
    {
        public int PersonId { get; set; }
        public DateTime Date { get; set; }
        public string Shift { get; set; }
        public int? LeaveCategoryId { get; set; }
    }

    public class SelectedDayOffDTO
    {
        public int PersonId { get; set; }
        public DateTime Date { get; set; }
        public string Shift { get; set; }
        public int? LeaveCategoryId { get; set; }
    }

    // Verlofcategorieën van de getoonde ploeg/specialiteit (kleur in de kalender)
    private List<LeaveCategoryDTO> LeaveCategories = new();
    //-------------------------------------------------------------

    // Total workdays in the selected year (same unit as mg.Days.Count: date+shift rows)
    private int YearTotalWorkDays => WorkDays?.Count ?? 0;



    // Quota per dag (zelfde logica als in de cel-weergave)
    private int DailyQuota => Math.Max(1, TeamMembers.Count / 4);

    // Minimum verlof per persoon = totaal werkdagen * quota / aantal personen
    private double MinimumLeavePerPerson => TeamMembers.Count == 0
        ? 0
        : (double)YearTotalWorkDays * DailyQuota / TeamMembers.Count;

    private string MinimumLeavePerPersonText => MinimumLeavePerPerson.ToString("0.##");
    private string TeamMemberCount => TeamMembers.Count.ToString(); 
    public class MonthGroup
    {
        public int Year { get; set; }
        public int Month { get; set; }
        public string MonthName { get; set; } = "";
        public List<WorkDay> Days { get; set; } = new();
    }

    private List<SelectedDayOffDTO> selectedDays = new();

    // Minstens 24 kolommen (lege opvulling); meer als de selectie groter is (bv. alle specialiteiten)
    private List<PersonBaseDTO?> MemberColumns =>
        TeamMembers
            .Concat(Enumerable.Repeat<PersonBaseDTO?>(null, Math.Max(0, 24 - TeamMembers.Count)))
            .ToList();

    // Admin kan elke ploeg/specialiteit bekijken; anderen zien enkel hun eigen ploeg
    private const string AllSpecialities = "Alle specialiteiten";
    private bool IsAdmin => string.Equals(CurrentUserRole, "Admin", StringComparison.OrdinalIgnoreCase);
    private string? SelectedTeam;
    private string? SelectedSpeciality;
    private List<string> TeamOptions = new();
    private List<string> SpecialityOptions = new();
    private bool ShowAllSpecialities => SelectedSpeciality == AllSpecialities;

    protected override async Task OnInitializedAsync()
    {
        // Ingelogde gebruiker bepaalt de standaardselectie
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        var userId = JwtUtils.GetUserIdFromToken(token);
        var person = await PersonApi.GetPersonByIdAsync(int.Parse(userId));
        SelectedTeam = person?.Team;
        SelectedSpeciality = person?.Speciality;
        CurrentUserRole = person?.Role; // capture role for authorization

        if (IsAdmin)
        {
            TeamOptions = await Http.GetFromJsonAsync<List<string>>("api/meta/teams") ?? new();
            SpecialityOptions = new List<string> { AllSpecialities };
            SpecialityOptions.AddRange(await Http.GetFromJsonAsync<List<string>>("api/meta/specialities") ?? new());
        }

        await LoadPermissions();
        await LoadTeamCalendar();
        await ExpandAllMonths();
    }

    private async Task OnTeamOrSpecialityChanged(object value)
    {
        await LoadTeamCalendar();
        await ExpandAllMonths();
    }

    private static string ShortSpeciality(string? speciality) => speciality switch
    {
        null or "" => "-",
        "Onderofficieren" => "OOff",
        "Officieren" => "Off",
        "Chauffeur" => "Chauf",
        "Dispatching" => "Disp",
        "RedTeam" => "Red",
        "Duiker" => "Duik",
        _ => speciality
    };

    private async Task LoadPermissions()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");

            using var req = new HttpRequestMessage(HttpMethod.Get, $"api/access/calendar-permissions?year={SelectedYear}");
            if (!string.IsNullOrEmpty(token))
                req.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var resp = await Http.SendAsync(req);
            if (resp.IsSuccessStatusCode)
            {
                _perms = await resp.Content.ReadFromJsonAsync<CalendarPermissionsDTO>();
            }
            else
            {
                _perms = null;
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "Permissies",
                    Detail = $"Permissies laden mislukt ({(int)resp.StatusCode}).",
                    Duration = 4000
                });
            }
        }
        catch (Exception ex)
        {
            _perms = null;
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Permissies",
                Detail = ex.Message,
                Duration = 4000
            });
        }
    }

    private async Task OnYearChanged(object value)
    {
        if (value is int year)
        {
            SelectedYear = year;
            StateHasChanged(); // updates CanSave
            await LoadTeamCalendar();
            await LoadPermissions();
            StateHasChanged();
        }
    }
    private BadgeStyle GetMemberBadgeStyle(int personId)
    {
        var count = GetSelectedDayCount(personId);

        // Hard cap threshold
        if (count > 44) return BadgeStyle.Danger;   // red

        // Over personal minimum leave
        if (count > MinimumLeavePerPerson - 1) return BadgeStyle.Warning; // orange

        // Default
        return BadgeStyle.Info; // blue
    }

    private int GetSelectedDayCount(int personId)
    {
        return selectedDays.Count(d => d.PersonId == personId);
    }

private int GetTotalSelectedDays(WorkDay wd)
{
    // Pure function: only compute and return the count (no notifications here)
    return selectedDays.Count(d => d.Date.Date == wd.Date.Date && d.Shift == wd.Shift);
}

private void OnDayClicked(int personId, WorkDay day)
{
    var existing = selectedDays.FirstOrDefault(d =>
        d.PersonId == personId &&
        d.Date.Date == day.Date.Date &&
        d.Shift == day.Shift);

    if (existing == null)
        selectedDays.Add(new SelectedDayOffDTO { PersonId = personId, Date = day.Date, Shift = day.Shift });
    else
        selectedDays.Remove(existing);

    // Only notify for the row the user just edited
    var count = selectedDays.Count(d => d.Date.Date == day.Date.Date && d.Shift == day.Shift);
    var quota = Math.Max(1, TeamMembers.Count / 4);

    if (count > quota)
    {
        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Error,
            Summary = "Fout",
            Detail = $"Opgelet: {count} verlofdagen voor {day.Date:dd/MM/yyyy} (quota: {quota}).",
            Duration = 5000
        });
    }
}

    private async Task LoadTeamCalendar()
    {
        var teamName = SelectedTeam;
        var speciality = SelectedSpeciality;

        // Haal teamleden op
        TeamMembers = ShowAllSpecialities
            ? await Http.GetFromJsonAsync<List<PersonBaseDTO>>($"api/person/team/{teamName}") ?? new()
            : await Http.GetFromJsonAsync<List<PersonBaseDTO>>($"api/person/team/{teamName}/{speciality}") ?? new();

        // Haal werkdagen op
        WorkDays = await Http.GetFromJsonAsync<List<WorkDay>>($"api/calender?teamName={teamName}&year={SelectedYear}");

        // Haal alle verlofdagen van het team op PER SPECIALITEIT
        var daysOffUrl = ShowAllSpecialities
            ? $"api/person/team-days-off/{teamName}/{SelectedYear}"
            : $"api/person/team-days-off/{teamName}/{SelectedYear}/{speciality}";
        TeamDaysOff = await Http.GetFromJsonAsync<List<TeamDayOffDTO>>(daysOffUrl);

        // Synchroniseer selectie met bestaande verlofdagen
        selectedDays = TeamDaysOff
            .Select(d => new SelectedDayOffDTO { PersonId = d.PersonId, Date = d.Date, Shift = d.Shift, LeaveCategoryId = d.LeaveCategoryId })
            .ToList();

        // Verlofcategorieën (kleuren) van deze ploeg/specialiteit
        try
        {
            var catUrl = ShowAllSpecialities
                ? $"api/leave-categories?team={teamName}&year={SelectedYear}"
                : $"api/leave-categories?team={teamName}&speciality={speciality}&year={SelectedYear}";
            LeaveCategories = await Http.GetFromJsonAsync<List<LeaveCategoryDTO>>(catUrl) ?? new();
        }
        catch
        {
            LeaveCategories = new();
        }

        // Bouw maand-groepen
        MonthGroups = WorkDays
            .GroupBy(w => new { w.Date.Year, w.Date.Month })
            .OrderBy(g => g.Key.Year)
            .ThenBy(g => g.Key.Month)
            .Select(g => new MonthGroup
            {
                Year = g.Key.Year,
                Month = g.Key.Month,
                MonthName = new DateTime(g.Key.Year, g.Key.Month, 1).ToString("MMMM yyyy"),
                Days = g.OrderBy(d => d.Date).ToList()
            })
            .ToList();

        StateHasChanged();
    }

    private string GetInitials(PersonBaseDTO person)
    {
        if (person == null) return "";
        var last = person.LastName?.Trim();
        if (string.IsNullOrWhiteSpace(last)) return "";

        // Splits op spaties (compound achternaam)
        var parts = last.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length >= 2)
        {
            // Eerste twee letters van het eerste deel + eerste letter van het tweede deel
            var firstPart = parts[0];
            var secondPart = parts[1];

            var initials = new StringBuilder();

            if (firstPart.Length >= 2)
            {
                initials.Append(firstPart[0]);
                initials.Append(firstPart[1]);
            }
            else
            {
                // Minder dan 2 karakters: neem wat er is
                initials.Append(firstPart[0]);
            }

            if (secondPart.Length >= 1)
            {
                initials.Append(secondPart[0]);
            }

            return initials.ToString().ToUpperInvariant();
        }

        // Geen compound: neem de eerste 3 karakters (of minder als korter)
        return last.Length >= 3
            ? last.Substring(0, 3).ToUpperInvariant()
            : last.ToUpperInvariant();
    }

