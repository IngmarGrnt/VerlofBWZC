@page "/teamcalendar"
@using Radzen
@using Radzen.Blazor
@using System.Text
@using System.Net.Http.Headers
@using VerlofBWZC.DataContracts.DTO
@using VerlofBWZC.DataContracts.DTO.Access
@using VerlofBWZC.DataContracts.DTO.Calendar
@using VerlofBWZC.DataContracts.DTO.Leave
@using VerlofBWZC.Handler
@using VerlofBWZC.Services
@inject HttpClient Http
@inject IJSRuntime JS
@inject PersonApiService PersonApi
@inject NotificationService NotificationService
@inject DialogService DialogService

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@using VerlofBWZC.DataContracts.DTO.Holiday
@using VerlofBWZC.DataContracts.DTO.Lottery
@using System.Globalization

<PageTitle>Teamkalender</PageTitle>

@* Waarschuwen bij verlaten van de pagina met niet-opgeslagen wijzigingen *@
<NavigationLock ConfirmExternalNavigation="@isDirty" OnBeforeInternalNavigation="OnBeforeInternalNavigation" />

@if (!MonthGroups.Any())
{
    <h1>Teamkalender</h1>
    <p class="wc-loading">Teamkalender laden…</p>
}
else
{
    <!-- Kop: titel, jaar, ploeg/specialiteit, acties -->
    <div class="wc-header">
        <div class="wc-title">
            <h1>Teamkalender</h1>
            <div class="wc-year" role="group" aria-label="Jaar kiezen">
                <button type="button" class="wc-year-btn" aria-label="Vorig jaar" disabled="@(SelectedYear <= Years.Min())" @onclick="() => ChangeYear(-1)">
                    <i class="rzi">chevron_left</i>
                </button>
                <span class="wc-year-label">@SelectedYear</span>
                <button type="button" class="wc-year-btn" aria-label="Volgend jaar" disabled="@(SelectedYear >= Years.Max())" @onclick="() => ChangeYear(1)">
                    <i class="rzi">chevron_right</i>
                </button>
            </div>
            @if (IsAdmin)
            {
                <RadzenDropDown TValue="string" @bind-Value="SelectedTeam"
                                Data="@TeamOptions"
                                Placeholder="Ploeg"
                                Style="width:140px"
                                Change="OnTeamOrSpecialityChanged" />
                <RadzenDropDown TValue="string" @bind-Value="SelectedSpeciality"
                                Data="@SpecialityOptions"
                                Placeholder="Specialiteit"
                                Style="width:200px"
                                Change="OnTeamOrSpecialityChanged" />
            }
            else
            {
                <span class="tc-scope">@SelectedTeam · @SelectedSpeciality</span>
            }
            @if (isDirty)
            {
                <span class="wc-dirty"><i class="rzi">edit</i> Niet opgeslagen</span>
            }
        </div>
        <div class="wc-actions">
            @if (CanExport)
            {
                <RadzenButton Text="Export" Icon="download" ButtonStyle="ButtonStyle.Light" Click="@ExportToCsv" title="Exporteren naar CSV" />
            }
            @if (CanSaveTeamCalendar)
            {
                <RadzenButton Text="Opslaan" Icon="save" ButtonStyle="ButtonStyle.Primary" Click="@SaveTeamDaysOff" />
            }
        </div>
    </div>

    <!-- Samenvatting -->
    <div class="wc-summary">
        <div class="wc-stat">
            <div class="wc-stat-label">Personen</div>
            <div class="wc-stat-value">@TeamMembers.Count</div>
            <div class="wc-stat-note">@(IsAdmin && ShowAllSpecialities ? CompositionText : SelectedSpeciality)</div>
        </div>
        <div class="wc-stat">
            <div class="wc-stat-label">Max per shift</div>
            <div class="wc-stat-value">@DailyQuota</div>
            <div class="wc-stat-note">min. verlof p.p.: @MinimumLeavePerPersonText</div>
        </div>
        @{
            var overRows = OverQuotaRows;
            var loose = LooseShiftsAll;
        }
        <button type="button" class="@(overRows.Count > 0 ? "wc-stat tc-stat-btn wc-stat-over" : "wc-stat tc-stat-btn")"
                disabled="@(overRows.Count == 0)" title="@(overRows.Count > 0 ? "Spring naar de eerste shift boven het maximum" : null)"
                @onclick="() => JumpTo(overRows.FirstOrDefault()?.Date)">
            <span class="@(overRows.Count > 0 ? "wc-stat-label tc-label-over" : "wc-stat-label")">Shiften boven max</span>
            <span class="wc-stat-value @(overRows.Count > 0 ? "tc-value-over" : "")">@overRows.Count</span>
            <span class="wc-stat-note">@(overRows.Count > 0 ? "klik om te bekijken" : "alles binnen het maximum")</span>
        </button>
        <button type="button" class="@(loose.Count > 0 ? "wc-stat tc-stat-btn wc-stat-warn" : "wc-stat tc-stat-btn")"
                disabled="@(loose.Count == 0)" title="@(loose.Count > 0 ? "Spring naar de eerste losse shift" : null)"
                @onclick="() => JumpTo(loose.FirstOrDefault()?.Date)">
            <span class="@(loose.Count > 0 ? "wc-stat-label tc-label-warn" : "wc-stat-label")">Losse shiften</span>
            <span class="wc-stat-value @(loose.Count > 0 ? "tc-value-warn" : "")">@loose.Count</span>
            <span class="wc-stat-note">@(loose.Count > 0 ? "dag zonder nacht of omgekeerd" : "alles per 2 shiften")</span>
        </button>
    </div>

    <!-- Maanden -->
    <div class="tc-months" role="group" aria-label="Maand kiezen">
        @foreach (var mg in MonthGroups)
        {
            var isActive = SelectedMonth != null && VisibleMonths.Any(v => v.Month == mg.Month);
            var hasIssue = MonthHasIssue(mg);
            <button type="button" class="@(isActive ? "tc-month tc-month-active" : "tc-month")"
                    aria-pressed="@(isActive ? "true" : "false")"
                    title="@(hasIssue ? "Deze maand heeft shiften boven het maximum of losse shiften" : null)"
                    @onclick="() => SelectedMonth = mg.Month">
                @ShortMonth(mg.Month)
                @if (hasIssue)
                {
                    <span class="tc-month-dot"></span>
                }
            </button>
        }
        <button type="button" class="@(SelectedMonth == null ? "tc-month tc-month-active" : "tc-month")"
                aria-pressed="@(SelectedMonth == null ? "true" : "false")"
                @onclick="() => SelectedMonth = null">
            Hele jaar
        </button>
        <label class="tc-two-months" title="Toon de gekozen maand samen met de maand ervoor, handig voor verlof dat over de maandgrens loopt">
            <input type="checkbox" checked="@TwoMonths" disabled="@(SelectedMonth == null)" @onchange="e => TwoMonths = (bool)(e.Value ?? false)" />
            2 maanden
        </label>
    </div>

    <!-- Aanduiden als + legende -->
    <div class="wc-toolbar">
        @if (LeaveCategories.Any() && CanSaveTeamCalendar)
        {
            <div class="wc-categories" role="group" aria-label="Aanduiden als">
                <span class="wc-toolbar-label">Aanduiden als</span>
                <button type="button" class="wc-pill"
                        style="@(ActiveCategoryName == null ? "background:var(--rz-info); border-color:var(--rz-info); color:#fff;" : "border-color:var(--rz-info); color:var(--rz-info-dark);")"
                        aria-pressed="@(ActiveCategoryName == null ? "true" : "false")"
                        @onclick="() => ActiveCategoryName = null">
                    Gewoon verlof
                </button>
                @foreach (var c in CategoryChoices)
                {
                    var isActive = ActiveCategoryName == c.Name;
                    <button type="button" class="wc-pill"
                            style="@(isActive ? $"background:{c.Color}; border-color:{c.Color}; color:#fff;" : $"border-color:{c.Color}; color:{c.Color};")"
                            aria-pressed="@(isActive ? "true" : "false")"
                            @onclick="() => ActiveCategoryName = c.Name">
                        @c.Name
                    </button>
                }
            </div>
        }
        else if (LeaveCategories.Any())
        {
            <div class="wc-legend">
                @foreach (var c in CategoryChoices)
                {
                    <span><span class="wc-swatch" style="@($"background:{c.Color}")"></span>@c.Name</span>
                }
            </div>
        }
        <div class="wc-legend">
            <span><span class="wc-swatch" style="background:var(--rz-info)"></span>Verlof</span>
            <span><span class="wc-dot-inline wc-dot-holiday"></span>Feestdag</span>
            <span><span class="tc-legend-loose"></span>Losse shift</span>
            <span><span class="tc-legend-night"></span>Nachtshift</span>
        </div>
    </div>
    @if (CanSaveTeamCalendar)
    {
        <div class="wc-hint">
            @(ActiveCategoryName == null
                ? "Klik op een vakje om verlof aan of uit te zetten."
                : "Klik op een vakje om deze categorie te geven; nog eens klikken zet het weer uit.")
        </div>
    }

    <!-- Raster: shiften als rijen, personen als kolommen -->
    <div class="tc-grid-wrap">
        <table class="tc-grid">
            <thead>
                <tr>
                    <th class="tc-col-date">@GridTitle</th>
                    <th class="tc-col-count">Bezet</th>
                    @foreach (var member in TeamMembers)
                    {
                        var used = YearCount(member.Id);
                        var allowance = member.LeaveAllowance;
                        var over = allowance is int a && used > a;
                        <th class="@(over ? "tc-col-member tc-member-over" : "tc-col-member")"
                            title="@MemberTitle(member)">
                            <span class="tc-initials">@GetInitials(member)</span>
                            @if (ShowAllSpecialities)
                            {
                                <span class="tc-spec">@ShortSpeciality(member.Speciality)</span>
                            }
                            <span class="tc-used">@used@(allowance is int al ? $"/{al}" : "")</span>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var mg in VisibleMonths)
                {
                    @if (VisibleMonths.Count() > 1)
                    {
                        <tr class="tc-month-row">
                            <td class="tc-col-date">@Capitalize(new DateTime(mg.Year, mg.Month, 1).ToString("MMMM", Nl))</td>
                            <td class="tc-col-count"></td>
                            <td colspan="@Math.Max(1, TeamMembers.Count)"></td>
                        </tr>
                    }
                    @foreach (var wd in mg.Days)
                    {
                        var count = GetTotalSelectedDays(wd);
                        var holiday = PublicHolidayName(wd.Date);
                        var isNight = wd.Shift == "N";
                        <tr class="@(isNight ? "tc-row tc-row-night" : "tc-row")" id="@RowId(wd)">
                            <td class="tc-col-date" title="@(holiday != null ? $"Feestdag: {holiday}" : null)">
                                <span class="tc-date">@wd.Date.ToString("ddd dd", Nl)</span>
                                <span class="tc-shift">@wd.Shift</span>
                                @if (holiday != null)
                                {
                                    <span class="wc-dot-inline wc-dot-holiday"></span>
                                }
                            </td>
                            <td class="tc-col-count">
                                <span class="@(count > DailyQuota ? "tc-count tc-count-over" : count == DailyQuota ? "tc-count tc-count-full" : "tc-count")">@count/@DailyQuota</span>
                                @if (CanManageCalendar && (PairOverQuota(wd) || HasDraw(wd.Date)))
                                {
                                    var hasDraw = HasDraw(wd.Date);
                                    <button type="button" class="@(hasDraw ? "tc-lottery-btn tc-lottery-done" : "tc-lottery-btn")"
                                            title="@(hasDraw ? "Loting gedaan: resultaat bekijken of opnieuw loten" : "Wie heeft verlof? Loting houden (dag + nacht)")"
                                            aria-label="Loting"
                                            @onclick="() => OpenLottery(wd)">
                                        <i class="rzi">@(hasDraw ? "task_alt" : "casino")</i>
                                    </button>
                                }
                            </td>
                            @foreach (var member in TeamMembers)
                            {
                                var dayOff = selectedDays.FirstOrDefault(d => d.PersonId == member.Id && d.Date.Date == wd.Date.Date && d.Shift == wd.Shift);
                                var category = dayOff?.LeaveCategoryId is int catId ? LeaveCategories.FirstOrDefault(c => c.Id == catId) : null;
                                var isLoose = dayOff != null && IsLoose(dayOff);
                                var blockClass = dayOff == null ? "tc-block" : isLoose ? "tc-block tc-block-on tc-block-loose" : "tc-block tc-block-on";
                                var blockStyle = category != null ? $"background:{category.Color};" : null;
                                var title = $"{member.FirstName} {member.LastName} · {wd.Date.ToString("ddd d MMM", Nl)} {wd.Shift}"
                                    + (dayOff != null ? " · " + (category?.Name ?? "Verlof") : "")
                                    + (isLoose ? " · Losse shift" : "");
                                <td class="tc-cell">
                                    @if (CanSaveTeamCalendar)
                                    {
                                        <button type="button" class="tc-cell-btn" title="@title"
                                                aria-pressed="@(dayOff != null ? "true" : "false")"
                                                @onclick="() => OnDayClicked(member.Id, wd)">
                                            <span class="@blockClass" style="@blockStyle"></span>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="@blockClass" style="@blockStyle" title="@title"></span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    private int SelectedYear { get; set; } = DateTime.Now.Year + 1;
    private List<int> Years { get; set; } = Enumerable.Range(DateTime.Now.Year - 1, 11).ToList();

    private List<WorkDay> WorkDays = new();
    private List<MonthGroup> MonthGroups = new();

    private List<PersonBaseDTO> TeamMembers = new();
    private List<TeamDayOffDTO> TeamDaysOff = new();
    private int CurrentDayOffYear = DateTime.Now.AddYears(1).Year;

    private static readonly CultureInfo Nl = new("nl-BE");

    // Getoonde maand (null = hele jaar) en niet-opgeslagen wijzigingen
    private int? SelectedMonth;
    private bool TwoMonths;
    private bool isDirty;

    private List<PublicHolidayDTO> PublicHolidays = new();

    // Authorization (simple role-based gating)
    private string? CurrentUserRole;
    private bool CanManageCalendar =>
        string.Equals(CurrentUserRole, "Admin", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(CurrentUserRole, "Manager", StringComparison.OrdinalIgnoreCase);



    // Permissions from ManagerPanel rules
    private CalendarPermissionsDTO? _perms;

    //private bool CanSave => CanManageCalendar;
    private bool CanSaveTeamCalendar => ((_perms?.CanSaveTeamCalendar ?? true) && CanManageCalendar);
    private bool CanExport => CanManageCalendar;

    //Nog in DTO zetten--------------------------------------------
    public class TeamDayOffDTO
    {
        public int PersonId { get; set; }
        public DateTime Date { get; set; }
        public string Shift { get; set; }
        public int? LeaveCategoryId { get; set; }
    }

    public class SelectedDayOffDTO
    {
        public int PersonId { get; set; }
        public DateTime Date { get; set; }
        public string Shift { get; set; }
        public int? LeaveCategoryId { get; set; }
    }

    // Verlofcategorieën van de getoonde ploeg/specialiteit (kleur in de kalender)
    private List<LeaveCategoryDTO> LeaveCategories = new();

    // Actieve categorie in de balk, op naam: bij "Alle specialiteiten" heeft elke specialiteit eigen categorieën
    private string? ActiveCategoryName;
    private IEnumerable<LeaveCategoryDTO> CategoryChoices =>
        LeaveCategories.OrderBy(c => c.SortOrder).GroupBy(c => c.Name).Select(g => g.First());

    private LeaveCategoryDTO? CategoryFor(PersonBaseDTO member, string name) =>
        LeaveCategories.FirstOrDefault(c => c.Name == name && c.Speciality == member.Speciality);

    private int CategoryUsage(int personId, int categoryId) =>
        selectedDays.Count(d => d.PersonId == personId && d.LeaveCategoryId == categoryId && d.Date.Year == SelectedYear);

    // Tooltip per persoon, bv. " | Groot verlof 3/8, Verlof 4 1/4"
    private string CategoryUsageText(PersonBaseDTO member)
    {
        var own = LeaveCategories.Where(c => c.Speciality == member.Speciality).OrderBy(c => c.SortOrder).ToList();
        return own.Count == 0 ? "" : " | " + string.Join(", ", own.Select(c => $"{c.Name} {CategoryUsage(member.Id, c.Id)}/{c.MaxShifts}"));
    }
    //-------------------------------------------------------------

    // Total workdays in the selected year (same unit as mg.Days.Count: date+shift rows)
    private int YearTotalWorkDays => WorkDays?.Count ?? 0;



    // Quota per dag (zelfde logica als in de cel-weergave)
    private int DailyQuota => Math.Max(1, TeamMembers.Count / 4);

    // Minimum verlof per persoon = totaal werkdagen * quota / aantal personen
    private double MinimumLeavePerPerson => TeamMembers.Count == 0
        ? 0
        : (double)YearTotalWorkDays * DailyQuota / TeamMembers.Count;

    private string MinimumLeavePerPersonText => MinimumLeavePerPerson.ToString("0.##");
    private string TeamMemberCount => TeamMembers.Count.ToString(); 
    public class MonthGroup
    {
        public int Year { get; set; }
        public int Month { get; set; }
        public string MonthName { get; set; } = "";
        public List<WorkDay> Days { get; set; } = new();
    }

    private List<SelectedDayOffDTO> selectedDays = new();

    // Minstens 24 kolommen (lege opvulling); meer als de selectie groter is (bv. alle specialiteiten)
    private List<PersonBaseDTO?> MemberColumns =>
        TeamMembers
            .Concat(Enumerable.Repeat<PersonBaseDTO?>(null, Math.Max(0, 24 - TeamMembers.Count)))
            .ToList();

    // Admin kan elke ploeg/specialiteit bekijken; anderen zien enkel hun eigen ploeg
    private const string AllSpecialities = "Alle specialiteiten";
    private bool IsAdmin => string.Equals(CurrentUserRole, "Admin", StringComparison.OrdinalIgnoreCase);
    private string? SelectedTeam;
    private string? SelectedSpeciality;
    private List<string> TeamOptions = new();
    private List<string> SpecialityOptions = new();
    private bool ShowAllSpecialities => SelectedSpeciality == AllSpecialities;

    protected override async Task OnInitializedAsync()
    {
        // Ingelogde gebruiker bepaalt de standaardselectie
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        var userId = JwtUtils.GetUserIdFromToken(token);
        var person = await PersonApi.GetPersonByIdAsync(int.Parse(userId));
        SelectedTeam = person?.Team;
        SelectedSpeciality = person?.Speciality;
        CurrentUserRole = person?.Role; // capture role for authorization

        if (IsAdmin)
        {
            TeamOptions = await Http.GetFromJsonAsync<List<string>>("api/meta/teams") ?? new();
            SpecialityOptions = new List<string> { AllSpecialities };
            SpecialityOptions.AddRange(await Http.GetFromJsonAsync<List<string>>("api/meta/specialities") ?? new());
        }

        await LoadPermissions();
        await LoadTeamCalendar();
        SelectedMonth = SelectedYear == DateTime.Now.Year ? DateTime.Now.Month : 1;
    }

    private async Task OnTeamOrSpecialityChanged(object value)
    {
        // De dropdown is dan al gewijzigd: niet-opgeslagen wijzigingen van de vorige selectie vervallen
        await LoadTeamCalendar();
    }

    private async Task ChangeYear(int delta)
    {
        var year = SelectedYear + delta;
        if (year < Years.Min() || year > Years.Max()) return;

        if (isDirty && !await JS.InvokeAsync<bool>("confirm", "Je hebt niet-opgeslagen wijzigingen. Toch van jaar wisselen?"))
            return;

        SelectedYear = year;
        await LoadTeamCalendar();
        await LoadPermissions();
        SelectedMonth = SelectedYear == DateTime.Now.Year ? DateTime.Now.Month : 1;
    }

    private async Task OnBeforeInternalNavigation(LocationChangingContext context)
    {
        if (isDirty && !await JS.InvokeAsync<bool>("confirm", "Je hebt niet-opgeslagen wijzigingen. Pagina toch verlaten?"))
            context.PreventNavigation();
    }

    // --- Weergave ---

    private IEnumerable<MonthGroup> VisibleMonths =>
        SelectedMonth is int m
            ? MonthGroups.Where(g => TwoMonths
                // 2 maanden: de maand ervoor + de gekozen maand (januari: januari + februari)
                ? g.Month == Math.Max(m, 2) - 1 || g.Month == Math.Max(m, 2)
                : g.Month == m)
            : MonthGroups;

    private string GridTitle
    {
        get
        {
            var months = VisibleMonths.ToList();
            if (SelectedMonth == null || months.Count == 0) return SelectedYear.ToString();
            string Name(MonthGroup g) => Capitalize(new DateTime(g.Year, g.Month, 1).ToString("MMMM", Nl));
            return months.Count == 1 ? Name(months[0]) : $"{ShortMonth(months[0].Month)} – {ShortMonth(months[^1].Month)}";
        }
    }

    private static string ShortMonth(int month) =>
        new DateTime(2000, month, 1).ToString("MMM", new CultureInfo("nl-BE")).TrimEnd('.');

    private static string Capitalize(string s) => string.IsNullOrEmpty(s) ? s : char.ToUpper(s[0]) + s[1..];

    private static string RowId(WorkDay wd) => $"tc-{wd.Date:yyyyMMdd}-{wd.Shift}";

    private string CompositionText => string.Join(", ", TeamMembers
        .GroupBy(m => string.IsNullOrWhiteSpace(m.Speciality) ? "(geen)" : m.Speciality)
        .Select(g => $"{ShortSpeciality(g.Key)} {g.Count()}"));

    private int YearCount(int personId) =>
        selectedDays.Count(d => d.PersonId == personId && d.Date.Year == SelectedYear);

    private string MemberTitle(PersonBaseDTO member)
    {
        var used = YearCount(member.Id);
        var text = $"{member.FirstName} {member.LastName} - {member.Speciality} | verlof {used}"
            + (member.LeaveAllowance is int a ? $"/{a}" : "")
            + CategoryUsageText(member);
        var loose = LooseCount(member.Id);
        return loose > 0 ? $"{text} | {loose} losse shift(en)" : text;
    }

    private string? PublicHolidayName(DateTime date)
    {
        var h = PublicHolidays.FirstOrDefault(h => h.StartDate.Date == date.Date);
        return h == null ? null : (h.Name?.FirstOrDefault(n => n.Language == "NL")?.Text ?? h.Name?.FirstOrDefault()?.Text ?? "Feestdag");
    }

    // Shiften (rijen) waar meer personen verlof hebben dan het maximum
    private List<WorkDay> OverQuotaRows => WorkDays
        .Where(wd => GetTotalSelectedDays(wd) > DailyQuota)
        .OrderBy(wd => wd.Date).ThenBy(wd => wd.Shift == "D" ? 0 : 1)
        .ToList();

    private List<SelectedDayOffDTO> LooseShiftsAll => selectedDays
        .Where(d => d.Date.Year == SelectedYear && TeamMembers.Any(m => m.Id == d.PersonId) && IsLoose(d))
        .OrderBy(d => d.Date).ThenBy(d => d.Shift == "D" ? 0 : 1)
        .ToList();

    private bool MonthHasIssue(MonthGroup mg) =>
        mg.Days.Any(wd => GetTotalSelectedDays(wd) > DailyQuota)
        || selectedDays.Any(d => d.Date.Year == mg.Year && d.Date.Month == mg.Month && TeamMembers.Any(m => m.Id == d.PersonId) && IsLoose(d));

    // --- Loting vanuit de teamkalender (bewaard via api/lottery, dus ook op de loterijpagina) ---

    private List<LotteryDrawDTO> Draws = new();

    private async Task LoadDraws()
    {
        if (!CanManageCalendar) { Draws = new(); return; }
        try
        {
            Draws = await Http.GetFromJsonAsync<List<LotteryDrawDTO>>("api/lottery/draws") ?? new();
        }
        catch
        {
            Draws = new();
        }
    }

    // Lotingen voor deze datum waarin iemand van de getoonde personen meedeed
    private List<LotteryDrawDTO> DrawsFor(DateTime date) => Draws
        .Where(d => d.FromDate.Date <= date.Date && d.ToDate.Date >= date.Date)
        .Where(d => d.Winners.Concat(d.Losers).Any(p => TeamMembers.Any(m => m.Id == p.PersonId)))
        .ToList();

    private bool HasDraw(DateTime date) => DrawsFor(date).Any();

    // Een loting gaat altijd over een paar: dagshift op dag X + nachtshift op dag X+1
    private static (DateTime Day, DateTime Night) PairOf(WorkDay wd) =>
        wd.Shift == "D" ? (wd.Date.Date, wd.Date.Date.AddDays(1)) : (wd.Date.Date.AddDays(-1), wd.Date.Date);

    private int ShiftCount(DateTime date, string shift) =>
        selectedDays.Count(d => d.Date.Date == date && d.Shift == shift);

    private bool PairOverQuota(WorkDay wd)
    {
        var (day, night) = PairOf(wd);
        return ShiftCount(day, "D") > DailyQuota || ShiftCount(night, "N") > DailyQuota;
    }

    private async Task OpenLottery(WorkDay wd)
    {
        var (day, night) = PairOf(wd);

        // Iedereen met verlof op de dag- en/of nachtshift van het paar
        var candidates = selectedDays
            .Where(d => (d.Date.Date == day && d.Shift == "D") || (d.Date.Date == night && d.Shift == "N"))
            .GroupBy(d => d.PersonId)
            .Select(g =>
            {
                var member = TeamMembers.FirstOrDefault(m => m.Id == g.Key);
                var catId = g.Select(d => d.LeaveCategoryId).FirstOrDefault(id => id != null);
                var category = catId is int id ? LeaveCategories.FirstOrDefault(c => c.Id == id) : null;
                var shifts = g.Select(d => d.Shift).Distinct().OrderBy(s => s == "D" ? 0 : 1).ToList();
                return member == null ? null : new TeamLotteryDialog.Candidate
                {
                    PersonId = member.Id,
                    FirstName = member.FirstName ?? "",
                    LastName = member.LastName ?? "",
                    Category = category?.Name,
                    Color = category?.Color,
                    Shifts = string.Join("+", shifts)
                };
            })
            .Where(c => c != null)
            .Select(c => c!)
            .OrderBy(c => c.LastName).ThenBy(c => c.FirstName)
            .ToList();

        var existing = DrawsFor(day).Concat(DrawsFor(night))
            .GroupBy(d => d.DrawNumber).Select(g => g.First())
            .ToList();

        var dayText = day.Month == night.Month ? day.ToString("%d", Nl) : day.ToString("d MMMM", Nl);
        var result = await DialogService.OpenAsync<TeamLotteryDialog>(
            $"Loting · {dayText}–{night.ToString("d MMMM yyyy", Nl)} · dag + nacht",
            new Dictionary<string, object>
            {
                { nameof(TeamLotteryDialog.DayDate), day },
                { nameof(TeamLotteryDialog.NightDate), night },
                { nameof(TeamLotteryDialog.DayCount), ShiftCount(day, "D") },
                { nameof(TeamLotteryDialog.NightCount), ShiftCount(night, "N") },
                { nameof(TeamLotteryDialog.Quota), DailyQuota },
                { nameof(TeamLotteryDialog.Candidates), candidates },
                { nameof(TeamLotteryDialog.ExistingDraws), existing },
                { nameof(TeamLotteryDialog.NextDrawNumber), Draws.Count == 0 ? 1 : Draws.Max(d => d.DrawNumber) + 1 },
                { nameof(TeamLotteryDialog.HasUnsavedChanges), isDirty },
                { nameof(TeamLotteryDialog.OnRestored), new Action<List<RestoredDayOffDTO>>(OnLotteryRestored) }
            },
            new DialogOptions { Width = "560px", CloseDialogOnEsc = true });

        // Altijd herladen: in de popup kan een loting bewaard of verwijderd zijn
        if (result is not TeamLotteryDialog.ApplyRequest)
            await LoadDraws();

        if (result is TeamLotteryDialog.ApplyRequest apply)
        {
            await LoadDraws();
            await ApplyLotteryAsync(apply, day, night);
        }
    }

    // Loting verwijderd in de popup: de server zette het weggehaalde verlof al terug, hier ook tonen
    private void OnLotteryRestored(List<RestoredDayOffDTO> restored)
    {
        foreach (var r in restored)
        {
            if (!selectedDays.Any(d => d.PersonId == r.PersonId && d.Date.Date == r.Date.Date && d.Shift == r.Shift))
                selectedDays.Add(new SelectedDayOffDTO { PersonId = r.PersonId, Date = r.Date, Shift = r.Shift, LeaveCategoryId = r.LeaveCategoryId });
        }
        NotificationService.Notify(NotificationSeverity.Info, "Verlof teruggezet",
            $"{restored.Select(r => r.PersonId).Distinct().Count()} persoon/personen kregen hun verlof terug.");
        StateHasChanged();
    }

    // Loting toepassen: verliezers verliezen hun verlof op de shiften van de loting (dag, nacht of beide), na akkoord
    private async Task ApplyLotteryAsync(TeamLotteryDialog.ApplyRequest apply, DateTime day, DateTime night)
    {
        bool InRange(DateTime date) => date >= apply.FromDate.Date && date <= apply.ToDate.Date;
        var includeDay = InRange(day);
        var includeNight = InRange(night);

        var loserIds = apply.Losers.Select(l => l.PersonId).ToHashSet();
        var toRemove = selectedDays
            .Where(d => loserIds.Contains(d.PersonId)
                && ((includeDay && d.Date.Date == day && d.Shift == "D") || (includeNight && d.Date.Date == night && d.Shift == "N")))
            .ToList();

        var names = string.Join(", ", apply.Losers
            .Where(l => toRemove.Any(d => d.PersonId == l.PersonId))
            .Select(l => $"{l.FirstName} {l.LastName}"));
        var shiftsText = includeDay && includeNight
            ? $"{(day.Month == night.Month ? day.ToString("%d", Nl) : day.ToString("d MMM", Nl))}–{night.ToString("d MMM yyyy", Nl)} (dag + nacht)"
            : includeDay
                ? $"{day.ToString("d MMM yyyy", Nl)} (dagshift)"
                : $"{night.ToString("d MMM yyyy", Nl)} (nachtshift)";
        if (toRemove.Count == 0)
        {
            NotificationService.Notify(NotificationSeverity.Info, apply.Confirmed ? apply.DrawName : "Niets te doen",
                apply.Losers.Count == 0 ? "Iedereen is winnaar: geen verlof weggehaald." : "De verliezers hebben op deze shiften geen verlof (meer).");
            return;
        }

        // Al bevestigd in de popup: geen tweede vraag
        var confirmed = apply.Confirmed ? true : await DialogService.Confirm(
            $"{names} {(toRemove.Select(d => d.PersonId).Distinct().Count() == 1 ? "verliest" : "verliezen")} hun verlof op {shiftsText}. "
            + (isDirty ? "Ook je andere niet-opgeslagen wijzigingen worden mee opgeslagen. " : "")
            + "Toepassen en opslaan?",
            "Loting toepassen",
            new ConfirmOptions { OkButtonText = "Toepassen", CancelButtonText = "Annuleren" });
        if (confirmed != true)
            return;

        // Onthouden wat weggehaald wordt (met verlofregel), om terug te zetten als de loting verwijderd wordt
        var removedInfo = toRemove
            .GroupBy(d => d.PersonId)
            .Select(g => new LotteryPersonDTO
            {
                PersonId = g.Key,
                RemovedDay = g.Any(d => d.Shift == "D"),
                RemovedNight = g.Any(d => d.Shift == "N"),
                DayLeaveCategoryId = g.FirstOrDefault(d => d.Shift == "D")?.LeaveCategoryId,
                NightLeaveCategoryId = g.FirstOrDefault(d => d.Shift == "N")?.LeaveCategoryId
            })
            .ToList();

        foreach (var d in toRemove)
            selectedDays.Remove(d);
        isDirty = true;

        await SaveTeamDaysOff();

        // Enkel als het opslaan gelukt is (isDirty staat dan terug uit)
        if (!isDirty && apply.DrawNumber > 0)
        {
            try
            {
                var resp = await Http.PostAsJsonAsync($"api/lottery/draw/{apply.DrawNumber}/applied", removedInfo);
                if (!resp.IsSuccessStatusCode)
                    NotificationService.Notify(NotificationSeverity.Warning, "Loting",
                        "Toegepast, maar niet onthouden wat weggehaald werd: bij verwijderen van de loting komt het verlof niet vanzelf terug.");
            }
            catch
            {
                NotificationService.Notify(NotificationSeverity.Warning, "Loting", "Toegepast, maar niet onthouden wat weggehaald werd (netwerkfout).");
            }
            await LoadDraws();
        }

        if (apply.Confirmed)
        {
            // Resultaat tonen: in de popup was er geen resultaatscherm
            var winners = apply.Winners.Any() ? string.Join(", ", apply.Winners.Select(w => $"{w.FirstName} {w.LastName}")) : "geen";
            await DialogService.Alert(
                $"Winnaars (houden verlof): {winners}. Verliezers (verlof weggehaald op {shiftsText}): {names}."
                + (isDirty ? " Let op: de teamkalender is nog niet opgeslagen, zie de melding." : ""),
                apply.DrawName,
                new AlertOptions { OkButtonText = "OK" });
        }
    }



