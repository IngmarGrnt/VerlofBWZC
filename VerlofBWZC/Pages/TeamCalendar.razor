    private BadgeStyle GetMemberBadgeStyle(int personId)
    {
        var count = GetSelectedDayCount(personId);

        // Hard cap threshold
        if (count > 44) return BadgeStyle.Danger;   // red

        // Over personal minimum leave
        if (count > MinimumLeavePerPerson - 1) return BadgeStyle.Warning; // orange

        // Default
        return BadgeStyle.Info; // blue
    }

    private int GetSelectedDayCount(int personId)
    {
        return selectedDays.Count(d => d.PersonId == personId);
    }

private int GetTotalSelectedDays(WorkDay wd)
{
    // Pure function: only compute and return the count (no notifications here)
    return selectedDays.Count(d => d.Date.Date == wd.Date.Date && d.Shift == wd.Shift);
}

private void OnDayClicked(int personId, WorkDay day)
{
    var existing = selectedDays.FirstOrDefault(d =>
        d.PersonId == personId &&
        d.Date.Date == day.Date.Date &&
        d.Shift == day.Shift);

    if (ActiveCategoryName == null)
    {
        // Gewoon verlof: aan/uit
        if (existing == null)
            selectedDays.Add(new SelectedDayOffDTO { PersonId = personId, Date = day.Date, Shift = day.Shift });
        else
            selectedDays.Remove(existing);
    }
    else
    {
        // Categorie van de specialiteit van deze persoon
        var member = TeamMembers.First(m => m.Id == personId);
        var category = CategoryFor(member, ActiveCategoryName);
        if (category == null)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = ActiveCategoryName,
                Detail = $"'{ActiveCategoryName}' bestaat niet voor {member.Speciality}.",
                Duration = 4000
            });
            return;
        }

        if (existing?.LeaveCategoryId == category.Id)
        {
            // Nog eens klikken zet de shift volledig uit
            selectedDays.Remove(existing);
            isDirty = true;
            return;
        }

        if (CategoryUsage(personId, category.Id) >= category.MaxShifts)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = category.Name,
                Detail = $"{member.FirstName} {member.LastName} heeft al {category.MaxShifts} shiften als '{category.Name}'.",
                Duration = 4000
            });
            return;
        }

        if (existing == null)
            selectedDays.Add(new SelectedDayOffDTO { PersonId = personId, Date = day.Date, Shift = day.Shift, LeaveCategoryId = category.Id });
        else
            existing.LeaveCategoryId = category.Id;
    }

    isDirty = true;

    // Only notify for the row the user just edited
    var count = selectedDays.Count(d => d.Date.Date == day.Date.Date && d.Shift == day.Shift);
    var quota = Math.Max(1, TeamMembers.Count / 4);

    if (count > quota)
    {
        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Error,
            Summary = "Fout",
            Detail = $"Opgelet: {count} verlofdagen voor {day.Date:dd/MM/yyyy} (quota: {quota}).",
            Duration = 5000
        });
    }
}

    private async Task LoadTeamCalendar()
    {
        var teamName = SelectedTeam;
        var speciality = SelectedSpeciality;

        // Haal teamleden op
        TeamMembers = ShowAllSpecialities
            ? await Http.GetFromJsonAsync<List<PersonBaseDTO>>($"api/person/team/{teamName}") ?? new()
            : await Http.GetFromJsonAsync<List<PersonBaseDTO>>($"api/person/team/{teamName}/{speciality}") ?? new();

        // Haal werkdagen op
        WorkDays = await Http.GetFromJsonAsync<List<WorkDay>>($"api/calender?teamName={teamName}&year={SelectedYear}");

        // Haal alle verlofdagen van het team op PER SPECIALITEIT
        var daysOffUrl = ShowAllSpecialities
            ? $"api/person/team-days-off/{teamName}/{SelectedYear}"
            : $"api/person/team-days-off/{teamName}/{SelectedYear}/{speciality}";
        TeamDaysOff = await Http.GetFromJsonAsync<List<TeamDayOffDTO>>(daysOffUrl);

        // Synchroniseer selectie met bestaande verlofdagen
        selectedDays = TeamDaysOff
            .Select(d => new SelectedDayOffDTO { PersonId = d.PersonId, Date = d.Date, Shift = d.Shift, LeaveCategoryId = d.LeaveCategoryId })
            .ToList();

        // Verlofcategorieën (kleuren) van deze ploeg/specialiteit
        try
        {
            var catUrl = ShowAllSpecialities
                ? $"api/leave-categories?team={teamName}&year={SelectedYear}"
                : $"api/leave-categories?team={teamName}&speciality={speciality}&year={SelectedYear}";
            LeaveCategories = await Http.GetFromJsonAsync<List<LeaveCategoryDTO>>(catUrl) ?? new();
        }
        catch
        {
            LeaveCategories = new();
        }

        if (ActiveCategoryName != null && LeaveCategories.All(c => c.Name != ActiveCategoryName))
            ActiveCategoryName = null;

        // Feestdagen (stipje in de datumkolom)
        try
        {
            PublicHolidays = await Http.GetFromJsonAsync<List<PublicHolidayDTO>>($"api/holidays/public/{SelectedYear}") ?? new();
        }
        catch
        {
            PublicHolidays = new();
        }

        await LoadDraws();

        isDirty = false;

        // Bouw maand-groepen
        MonthGroups = WorkDays
            .GroupBy(w => new { w.Date.Year, w.Date.Month })
            .OrderBy(g => g.Key.Year)
            .ThenBy(g => g.Key.Month)
            .Select(g => new MonthGroup
            {
                Year = g.Key.Year,
                Month = g.Key.Month,
                MonthName = new DateTime(g.Key.Year, g.Key.Month, 1).ToString("MMMM yyyy"),
                Days = g.OrderBy(d => d.Date).ToList()
            })
            .ToList();

        StateHasChanged();
    }

    private string GetInitials(PersonBaseDTO person)
    {
        if (person == null) return "";
        var last = person.LastName?.Trim();
        if (string.IsNullOrWhiteSpace(last)) return "";

        // Splits op spaties (compound achternaam)
        var parts = last.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length >= 2)
        {
            // Eerste twee letters van het eerste deel + eerste letter van het tweede deel
            var firstPart = parts[0];
            var secondPart = parts[1];

            var initials = new StringBuilder();

            if (firstPart.Length >= 2)
            {
                initials.Append(firstPart[0]);
                initials.Append(firstPart[1]);
            }
            else
            {
                // Minder dan 2 karakters: neem wat er is
                initials.Append(firstPart[0]);
            }

            if (secondPart.Length >= 1)
            {
                initials.Append(secondPart[0]);
            }

            return initials.ToString().ToUpperInvariant();
        }

        // Geen compound: neem de eerste 3 karakters (of minder als korter)
        return last.Length >= 3
            ? last.Substring(0, 3).ToUpperInvariant()
            : last.ToUpperInvariant();
    }

