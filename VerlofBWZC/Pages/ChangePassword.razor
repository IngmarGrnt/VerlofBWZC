@page "/wachtwoord-wijzigen"
@using Radzen
@using Radzen.Blazor
@using VerlofBWZC.DataContracts
@using VerlofBWZC.DataContracts.DTO
@using VerlofBWZC.Handler
@using VerlofBWZC.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject PersonApiService PersonApi
@inject JwtAuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject IJSRuntime JS
@inject TokenService Tokens

<PageTitle>Wachtwoord wijzigen</PageTitle>

<div class="login-container">
    <div class="login-card">
        <h3 class="text-center mb-2">Wachtwoord wijzigen</h3>
        @if (forced)
        {
            <p class="pw-intro">Je logt in met een tijdelijk of te zwak wachtwoord. Kies eerst een nieuw wachtwoord dat alleen jij kent.</p>
        }
        <EditForm Model="model" OnValidSubmit="SaveAsync">
            <div class="mb-3">
                <label class="pw-label" for="current">@(forced ? "Tijdelijk / huidig wachtwoord" : "Huidig wachtwoord")</label>
                <RadzenPassword @bind-Value="model.CurrentPassword" Name="current" Style="width:100%" autocomplete="current-password" />
            </div>
            <div class="mb-3">
                <label class="pw-label" for="new">Nieuw wachtwoord</label>
                <RadzenPassword @bind-Value="model.NewPassword" Name="new" Style="width:100%" autocomplete="new-password"
                                @oninput="e => newInput = e.Value?.ToString() ?? string.Empty" />
                <div class="@(PolicyError == null && newInput.Length > 0 ? "pw-hint pw-ok" : "pw-hint")">
                    @(newInput.Length == 0 ? $"Minstens {PasswordPolicy.MinLength} tekens, niet je naam of e-mailadres. Een zin werkt goed, bv. 'mijn fiets is blauw'."
                      : PolicyError ?? "Sterk genoeg.")
                </div>
            </div>
            <div class="mb-3">
                <label class="pw-label" for="confirm">Herhaal nieuw wachtwoord</label>
                <RadzenPassword @bind-Value="confirm" Name="confirm" Style="width:100%" autocomplete="new-password" />
            </div>
            <RadzenButton ButtonType="ButtonType.Submit" Text="Wachtwoord opslaan" Icon="lock" Style="width:100%" Disabled="@busy" />
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="text-danger mt-3 text-center">@errorMessage</div>
            }
            @if (forced)
            {
                <div class="text-center mt-3">
                    <RadzenButton Text="Afmelden" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="LogoutAsync" />
                </div>
            }
        </EditForm>
    </div>
</div>

@code {
    private ChangePasswordDTO model = new();
    private string confirm = "";
    private string newInput = "";
    private string? errorMessage;
    private bool busy;
    private bool forced;
    private string? email;

    private string? PolicyError => PasswordPolicy.Validate(newInput, email);

    protected override async Task OnInitializedAsync()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        forced = JwtUtils.MustChangePassword(token);
        email = JwtUtils.GetClaim(token, "email");
    }

    private async Task SaveAsync()
    {
        errorMessage = null;
        if (model.NewPassword != confirm)
        {
            errorMessage = "De nieuwe wachtwoorden komen niet overeen.";
            return;
        }
        if (PasswordPolicy.Validate(model.NewPassword, email) is string policy)
        {
            errorMessage = policy;
            return;
        }

        model.RememberMe = await Tokens.GetRememberAsync();
        busy = true;
        var result = await PersonApi.ChangePasswordAsync(model);
        busy = false;
        if (!result.Ok || result.Value == null)
        {
            errorMessage = result.Error;
            return;
        }

        // Nieuw, volwaardig token en vernieuwingstoken (andere toestellen zijn afgemeld)
        await AuthProvider.MarkUserAsAuthenticated(result.Value.Token, result.Value.RefreshToken);
        NotificationService.Notify(NotificationSeverity.Success, "Wachtwoord gewijzigd", "Je nieuwe wachtwoord is opgeslagen.");
        Navigation.NavigateTo("/", forceLoad: forced);
    }

    private async Task LogoutAsync()
    {
        await AuthProvider.MarkUserAsLoggedOut();
        Navigation.NavigateTo("/login");
    }
}
