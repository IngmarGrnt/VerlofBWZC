@page "/Random-picker"
@using System.Globalization
@using Radzen
@using Radzen.Blazor
@using VerlofBWZC.DataContracts.DTO
@using VerlofBWZC.DataContracts.DTO.Calendar
@using VerlofBWZC.DataContracts.DTO.Lottery
@using VerlofBWZC.Services
@using VerlofBWZC.Handler

@inject PersonApiService PersonApi
@inject NotificationService NotificationService
@inject HttpClient Http
@inject DialogService DialogService
@inject IJSRuntime JS


@if (isLoading)
{
    <h2><em>Loading...</em></h2>
}
else
{
    <div class="rz-mb-3" style="display:flex; flex-wrap:wrap; gap:1rem; align-items:center;">
        <RadzenDropDown @bind-Value="SelectedYear"
                        Data="@Years"
                        Style="width:160px"
                        Change="OnYearChanged"
                        Placeholder="Jaar" />

        <RadzenDropDown Data="@MonthOptions"
                        TextProperty="Text"
                        ValueProperty="Value"
                        TValue="int"
                        Value="SelectedMonth"
                        ValueChanged="OnMonthChanged"
                        Style="width:180px"
                        Placeholder="Maand" />

        <RadzenDropDown Data="@MonthWorkingDays"
                        TextProperty="Label"
                        ValueProperty="Date"
                        TValue="DateTime?"
                        Value="SelectedFrom"
                        ValueChanged="OnFromChanged"
                        Style="width:220px"
                        Placeholder="Van (werkdag)" />

        <span>tot</span>

        <RadzenDropDown Data="@MonthWorkingDays"
                        TextProperty="Label"
                        ValueProperty="Date"
                        TValue="DateTime?"
                        Value="SelectedTo"
                        ValueChanged="OnToChanged"
                        Style="width:220px"
                        Placeholder="Tot (werkdag)" />

        <RadzenCheckBoxList TValue="string"
                            Value="SelectedShifts"
                            ValueChanged="@( (IEnumerable<string> v) => SelectedShifts = v.ToList() )"
                            Data="@ShiftOptions"
                            Orientation="Orientation.Horizontal"
                            Style="margin-left: 1rem;" />

        <div style="margin-left:auto; display:flex; align-items:center; gap:.5rem;">
            <span class="rz-text-secondary">Shifts in bereik:</span>
            <RadzenBadge Text="@ShiftCountInRange.ToString()" BadgeStyle="BadgeStyle.Info" Variant="Variant.Filled" />
        </div>
    </div>

    <div class="rz-mb-3 rz-p-2 rz-border-radius-6 rz-shadow-2" style="background: var(--rz-base-200); display:flex; gap:1.0rem; align-items:center;">
        <RadzenBadge Text="Team" Variant="Variant.Filled" BadgeStyle="BadgeStyle.Primary" />
        <strong>@DisplayTeam</strong>
        <RadzenBadge Text="Specialiteit" Variant="Variant.Filled" BadgeStyle="BadgeStyle.Secondary" />
        <strong>@DisplaySpeciality</strong>

        <span style="margin-left:2rem;">Naam loting:</span>
        <RadzenTextBox @bind-Value="CurrentDrawName"
                       Placeholder="@($"Loting {NextYearDrawIndex}")"
                       Style="width:200px" />

        <span class="rz-text-secondary" style="margin-left:auto;">Deelnemerslijst is automatisch gefilterd op deze waarden</span>
    </div>

    <div style="display:grid; grid-template-columns: 1fr 120px 1fr; gap:1rem; align-items:center;">
        <RadzenListBox TItem="PersonBaseDTO"
                       @bind-Value="SelectedAvailable"
                       Data="AvailablePersons"
                       Multiple="true"
                       Style="height:340px"
                       FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
            <Template Context="p">
                <span>@p.FirstName @p.LastName</span>
                <span class="rz-text-secondary">(@p.Team / @p.Speciality)</span>
            </Template>
        </RadzenListBox>

        <div style="display:flex; flex-direction:column; gap:.5rem; align-items:center;">
            <RadzenButton Text=">" Click="@AddSelectedToParticipants" Disabled="@(SelectedAvailable == null || SelectedAvailable.Count == 0)" />
            <RadzenButton Text=">>" Click="@AddAllToParticipants" Disabled="@(AvailablePersons.Count == 0)" />
            <RadzenButton Text="<" Click="@RemoveSelectedParticipants" Disabled="@(SelectedParticipants == null || SelectedParticipants.Count == 0)" />
            <RadzenButton Text="<<" Click="@ClearParticipants" Disabled="@(Participants.Count == 0)" />
        </div>

        <RadzenListBox TItem="PersonBaseDTO"
                       @bind-Value="SelectedParticipants"
                       Data="Participants"
                       Multiple="true"
                       Style="height:340px"
                       FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
            <Template Context="p">
                <span>@p.FirstName @p.LastName</span>
                <span class="rz-text-secondary">(@p.Team) / @p.Speciality)</span>
            </Template>
        </RadzenListBox>
    </div>
    @if (DateTime.Now.Year + 1 == SelectedYear)
    {
    <div class="rz-mt-3" style="display:flex; gap:1rem; align-items:center; flex-wrap:wrap;">
        <RadzenNumeric @bind-Value="WinnersCount" Min="1" Max="@Math.Max(1, Participants.Count)" Style="width:140px" />
        <RadzenButton Text="Trek Winnaars" Icon="casino" ButtonStyle="ButtonStyle.Primary" Click="@DrawWinners" />
        <span class="rz-text-secondary">Deelnemers: @Participants.Count</span>
    </div>
    }
    @if (FilteredDraws.Any())
    {
        <h3 class="rz-mt-3">Resultaten</h3>

        @foreach (var draw in FilteredDraws)
        {
            <div class="rz-mt-2 rz-mb-3 rz-p-2 rz-border-radius-6 rz-shadow-2" style="background: var(--rz-base-100);">
                <div style="display:flex; align-items:center; gap:1rem; margin-bottom:.5rem;">
                    <!-- Enkel datum tonen (FromDate), correct geformatteerd -->
                    <h4 style="margin:.2rem 0;"> @draw.DrawName.ToString() - @draw.FromDate.ToString("dd-MM-yyyy")  t/m @draw.ToDate.ToString("dd-MM-yyyy")</h4>
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                  Text="Wis loting"
                                  Click="@(()=>DeleteDraw(draw.DrawNumber))" style="margin-left:auto;" />
                </div>

                <RadzenDataGrid Data="@draw.Rows" TItem="DrawRow" ShowColumnPicker="false" ShowPagingSummary="false" ShowPagination="false">
                    <Columns>
                        <RadzenDataGridColumn TItem="DrawRow" Title="Naam">
                            <Template Context="r">@r.FullName</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="DrawRow" Title="Resultaat" Width="120px">
                            <Template Context="r">
                                <RadzenBadge Text="@r.Result" BadgeStyle="@(r.Result == "Winnaar" ? BadgeStyle.Success : BadgeStyle.Warning)" Variant="Variant.Filled" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="DrawRow" Title="Periode" Width="220px">
                            <Template Context="r">@($"{r.FromDate:dd-MM-yyyy} t/m {r.ToDate:dd-MM-yyyy}")</Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>
        }
    }
    @* <RadzenDialog /> *@
    <RadzenNotification />
}


@code {
    // Data
    private bool isLoading = true;
    private List<PersonBaseDTO> AllPersons = new();
    private List<PersonBaseDTO> AvailablePersons = new();
    private List<PersonBaseDTO> Participants = new();
    private Dictionary<int, PersonBaseDTO> PersonIndex = new(); // add this
    // Lijsten met alle lotingen (elk met eigen rijen Winnaar/Verliezer)
    private List<DrawView> AllDraws = new();

    // Optionele custom naam; default = "Loting {NextYearDrawIndex}"
    private string? CurrentDrawName;

    // Globale (unieke) drawNumber voor API/DB
    private int NextDrawNumber => AllDraws.Count == 0 ? 1 : AllDraws.Max(d => d.DrawNumber) + 1;

    // Jaar-gebonden teller voor de zichtbare naam ("Loting 1", "Loting 2", ...)
    private int NextYearDrawIndex =>
            AllDraws
                .Where(d => d.FromDate.Year == SelectedYear || d.ToDate.Year == SelectedYear)
                .Count(d => d.Rows.Any(r => PersonMatchesFilters(r.PersonId))) + 1;

    // Selection
    private List<PersonBaseDTO> SelectedAvailable = new();
    private List<PersonBaseDTO> SelectedParticipants = new();

    // Year / month / shifts
    private int SelectedYear { get; set; } = DateTime.Now.Year + 1;
    private List<int> Years { get; set; } = Enumerable.Range(DateTime.Now.Year - 1, 12).Reverse().ToList();
    private int SelectedMonth { get; set; } = DateTime.Now.Month;

    // From/To (internal)
    private DateTime FromDate { get; set; }
    private DateTime ToDate { get; set; }

    private List<string> ShiftOptions { get; } = new() { "D", "N" };
    private List<string> SelectedShifts { get; set; } = new() { "D", "N" };

    // Month + day options
    private class MonthOption { public int Value { get; set; } public string Text { get; set; } = ""; }
    private class DayOption { public DateTime Date { get; set; } public string Label { get; set; } = ""; }

    private List<MonthOption> MonthOptions = Enumerable.Range(1, 12)
        .Select(m => new MonthOption { Value = m, Text = CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m) })
        .ToList();

    private List<DayOption> MonthWorkingDays = new();
    private DateTime? SelectedFrom { get; set; }
    private DateTime? SelectedTo { get; set; }

    // Meta options (loaded from API)
    private List<string> TeamOptions = new();
    private List<string> SpecialityOptions = new();
    private List<string> GradeOptions = new();
    private List<string> RoleOptions = new();

    // Team/Speciality (selected)
    private string? SelectedTeam { get; set; }
    private string? SelectedSpeciality { get; set; }

    private string DisplayTeam =>
        string.IsNullOrWhiteSpace(SelectedTeam) ? "Onbekend" : SelectedTeam;

    private string DisplaySpeciality =>
        string.IsNullOrWhiteSpace(SelectedSpeciality) ? "Onbekend" : SelectedSpeciality;

    // Workdays
    private List<WorkDay> TeamWorkDays = new();

    protected override async Task OnInitializedAsync()
    {
        InitRangeToMonth(SelectedYear, SelectedMonth);

        // Load meta for normalization/mapping
        await LoadMetaAsync();

        // Resolve team/specialiteit van ingelogde user
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        var userId = JwtUtils.GetUserIdFromToken(token);
        if (int.TryParse(userId, out var id))
        {
            var person = await PersonApi.GetPersonByIdAsync(id);
            SelectedTeam = NormalizeTeam(person?.Team);
            SelectedSpeciality = NormalizeSpeciality(person?.Speciality);
        }

        // Personen voor dit team/specialiteit
        if (!string.IsNullOrWhiteSpace(SelectedTeam) && !string.IsNullOrWhiteSpace(SelectedSpeciality))
        {
            AllPersons = await Http.GetFromJsonAsync<List<PersonBaseDTO>>(
                $"api/person/team/{SelectedTeam}/{SelectedSpeciality}") ?? new();
        }
        else
        {
            AllPersons = await PersonApi.GetAllPersonsAsync();
        }

        // Normalize people so filtering and UI show labels instead of numeric codes
        NormalizePeople(AllPersons);
        ApplyFilters();

        // Index met ALLE personen (nodig om team/speciality per DrawRow op te zoeken)
        var allForIndex = await PersonApi.GetAllPersonsAsync();
        NormalizePeople(allForIndex);
        PersonIndex = (allForIndex ?? new()).ToDictionary(p => p.Id);

        await LoadTeamWorkDays();
        RebuildMonthWorkingDays();

        // Bestaande lotingen laden
        await LoadExistingDraws();

        isLoading = false;
    }

    private async Task LoadMetaAsync()
    {
        try
        {
            TeamOptions = await Http.GetFromJsonAsync<List<string>>("api/meta/teams") ?? new();
            SpecialityOptions = await Http.GetFromJsonAsync<List<string>>("api/meta/specialities") ?? new();
            GradeOptions = await Http.GetFromJsonAsync<List<string>>("api/meta/grades") ?? new();
            RoleOptions = await Http.GetFromJsonAsync<List<string>>("api/meta/roles") ?? new();
        }
        catch
        {
            TeamOptions ??= new();
            SpecialityOptions ??= new();
            GradeOptions ??= new();
            RoleOptions ??= new();
        }
    }

    private static bool IsDigits(string? s) => !string.IsNullOrWhiteSpace(s) && s.All(char.IsDigit);

    private string NormalizeTeam(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "";
        if (value.StartsWith("Ploeg", StringComparison.OrdinalIgnoreCase)) return value;
        if (IsDigits(value) && int.TryParse(value, out var idx) && idx >= 0 && idx < TeamOptions.Count)
            return TeamOptions[idx];
        return value;
    }

    private string NormalizeSpeciality(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "";
        if (IsDigits(value) && int.TryParse(value, out var idx) && idx >= 0 && idx < SpecialityOptions.Count)
            return SpecialityOptions[idx];
        return value;
    }

    private void NormalizePeople(List<PersonBaseDTO>? people)
    {
        if (people == null) return;
        foreach (var p in people)
        {
            p.Team = NormalizeTeam(p.Team);
            p.Speciality = NormalizeSpeciality(p.Speciality);
        }
    }

    private bool PersonMatchesFilters(int personId)
    {
        if (!PersonIndex.TryGetValue(personId, out var p)) return false;

        if (!string.IsNullOrEmpty(SelectedTeam) && !string.Equals(p.Team, SelectedTeam, StringComparison.Ordinal))
            return false;

        if (!string.IsNullOrEmpty(SelectedSpeciality) && !string.Equals(p.Speciality, SelectedSpeciality, StringComparison.Ordinal))
            return false;

        return true;
    }

    // Alleen lotingen tonen van het geselecteerde jaar én gefilterd op team/specialiteit
    private IEnumerable<DrawView> FilteredDraws =>
        AllDraws
            .Select(d => new DrawView
            {
                DrawNumber = d.DrawNumber,
                DrawName = d.DrawName,
                FromDate = d.FromDate,
                ToDate = d.ToDate,
                Rows = d.Rows.Where(r => PersonMatchesFilters(r.PersonId)).ToList()
            })
            .Where(d => d.Rows.Count > 0) // toon enkel draws met relevante deelnemers
            .Where(d => d.FromDate.Year == SelectedYear || d.ToDate.Year == SelectedYear)
            .OrderBy(d => d.DrawNumber);

    private async Task LoadExistingDraws()
    {
        try
        {
            var draws = await Http.GetFromJsonAsync<List<LotteryDrawDTO>>("api/lottery/draws") ?? new();
            AllDraws = draws
                .OrderBy(d => d.DrawNumber)
                .ThenBy(d => d.CreatedAtUtc)
                .Select(d =>
                {
                    var rows = new List<DrawRow>();
                    rows.AddRange((d.Winners ?? new()).Select(w => new DrawRow
                    {
                        DrawNumber = d.DrawNumber,
                        DrawName = d.DrawName,
                        FromDate = d.FromDate,
                        ToDate = d.ToDate,
                        PersonId = w.PersonId,
                        FullName = $"{w.FirstName} {w.LastName}",
                        Result = "Winnaar"
                    }));
                    rows.AddRange((d.Losers ?? new()).Select(l => new DrawRow
                    {
                        DrawNumber = d.DrawNumber,
                        DrawName = d.DrawName,
                        FromDate = d.FromDate,
                        ToDate = d.ToDate,
                        PersonId = l.PersonId,
                        FullName = $"{l.FirstName} {l.LastName}",
                        Result = "Verliezer"
                    }));
                    // Sorteer winners eerst, dan alfabetisch
                    rows = rows.OrderBy(r => r.Result == "Verliezer")
                               .ThenBy(r => r.FullName)
                               .ToList();

                    return new DrawView
                    {
                        DrawNumber = d.DrawNumber,
                        DrawName = d.DrawName,
                        FromDate = d.FromDate,
                        ToDate = d.ToDate,
                        Rows = rows
                    };
                })
                .ToList();
        }
        catch
        {
            AllDraws = new();
        }
    }

    private void InitRangeToMonth(int year, int month)
    {
        FromDate = new DateTime(year, month, 1);
        ToDate = new DateTime(year, month, DateTime.DaysInMonth(year, month));
    }

    private async Task OnYearChanged(object? value)
    {
        if (value is int y)
        {
            SelectedYear = y;
            InitRangeToMonth(SelectedYear, SelectedMonth);
            await LoadTeamWorkDays();
            RebuildMonthWorkingDays();
        }
        StateHasChanged();
    }

    private async Task OnMonthChanged(int value)
    {
        SelectedMonth = value;
        InitRangeToMonth(SelectedYear, SelectedMonth);
        await LoadTeamWorkDays();
        RebuildMonthWorkingDays();
    }

    private void OnFromChanged(DateTime? value)
    {
        SelectedFrom = value;
        if (SelectedTo.HasValue && SelectedFrom.HasValue && SelectedTo.Value < SelectedFrom.Value)
            SelectedTo = SelectedFrom;
        SyncFromToDates();
    }

    private void OnToChanged(DateTime? value)
    {
        SelectedTo = value;
        if (SelectedFrom.HasValue && SelectedTo.HasValue && SelectedTo.Value < SelectedFrom.Value)
            SelectedFrom = SelectedTo;
        SyncFromToDates();
    }

    private void SyncFromToDates()
    {
        if (SelectedFrom.HasValue) FromDate = SelectedFrom.Value;
        if (SelectedTo.HasValue) ToDate = SelectedTo.Value;
        StateHasChanged();
    }

    private void RebuildMonthWorkingDays()
    {
        var dates = TeamWorkDays
            .Where(w => w.Date.Year == SelectedYear && w.Date.Month == SelectedMonth)
            .Select(w => w.Date.Date)
            .Distinct()
            .OrderBy(d => d)
            .ToList();

        MonthWorkingDays = dates
            .Select(d => new DayOption { Date = d, Label = d.ToString("ddd dd-MM-yyyy") })
            .ToList();

        if (MonthWorkingDays.Count == 0)
        {
            SelectedFrom = SelectedTo = null;
            InitRangeToMonth(SelectedYear, SelectedMonth);
        }
        else
        {
            SelectedFrom = SelectedFrom.HasValue && MonthWorkingDays.Any(x => x.Date == SelectedFrom.Value)
                ? SelectedFrom
                : MonthWorkingDays.First().Date;

            SelectedTo = SelectedTo.HasValue && MonthWorkingDays.Any(x => x.Date == SelectedTo.Value)
                ? SelectedTo
                : MonthWorkingDays.Last().Date;

            if (SelectedTo < SelectedFrom) SelectedTo = SelectedFrom;

            FromDate = SelectedFrom.Value;
            ToDate = SelectedTo.Value;
        }
    }

    private void ApplyFilters()
    {
        IEnumerable<PersonBaseDTO> q = AllPersons;

        if (!string.IsNullOrEmpty(SelectedTeam))
            q = q.Where(p => p.Team == SelectedTeam);

        if (!string.IsNullOrEmpty(SelectedSpeciality))
            q = q.Where(p => p.Speciality == SelectedSpeciality);

        var participantIds = Participants.Select(p => p.Id).ToHashSet();
        AvailablePersons = q.Where(p => !participantIds.Contains(p.Id))
                            .OrderBy(p => p.LastName)
                            .ThenBy(p => p.FirstName)
                            .ToList();

        if (WinnersCount > Participants.Count)
            WinnersCount = Math.Max(1, Participants.Count);
    }

    private async Task LoadTeamWorkDays()
    {
        if (string.IsNullOrEmpty(SelectedTeam))
        {
            TeamWorkDays = new();
            return;
        }
        try
        {
            TeamWorkDays = await Http.GetFromJsonAsync<List<WorkDay>>(
                $"api/calender?teamName={SelectedTeam}&year={SelectedYear}") ?? new();
        }
        catch
        {
            TeamWorkDays = new();
        }
        StateHasChanged();
    }

    private int ShiftCountInRange =>
        TeamWorkDays.Count(wd =>
            wd.Date.Date >= FromDate.Date &&
            wd.Date.Date <= ToDate.Date &&
            SelectedShifts.Contains(wd.Shift));

    private void AddSelectedToParticipants()
    {
        if (SelectedAvailable == null || SelectedAvailable.Count == 0) return;
        foreach (var p in SelectedAvailable)
        {
            if (!Participants.Any(x => x.Id == p.Id))
                Participants.Add(p);
        }
        SelectedAvailable.Clear();
        ApplyFilters();
    }

    private void AddAllToParticipants()
    {
        foreach (var p in AvailablePersons)
        {
            if (!Participants.Any(x => x.Id == p.Id))
                Participants.Add(p);
        }
        ApplyFilters();
    }

    private void RemoveSelectedParticipants()
    {
        if (SelectedParticipants == null || SelectedParticipants.Count == 0) return;
        foreach (var p in SelectedParticipants.ToList())
        {
            Participants.RemoveAll(x => x.Id == p.Id);
        }
        SelectedParticipants.Clear();
        ApplyFilters();
    }

    private void ClearParticipants()
    {
        Participants.Clear();
        ApplyFilters();
    }

    private async Task DrawWinners()
    {
        if (Participants.Count == 0)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Geen deelnemers", "Kies deelnemers voor je de trekking uitvoert.");
            return;
        }

        if (WinnersCount < 1)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Ongeldig aantal", "Aantal winnaars moet minstens 1 zijn.");
            return;
        }

        var count = Math.Min(WinnersCount, Participants.Count);

        // Shuffle (Fisher–Yates)
        var rng = Random.Shared;
        var list = Participants.ToList();
        for (int i = list.Count - 1; i > 0; i--)
        {
            int j = rng.Next(i + 1);
            (list[i], list[j]) = (list[j], list[i]);
        }

        var winners = list.Take(count).ToList();
        var losers  = list.Skip(count).ToList();

        // Globale unieke ID voor opslag
        var drawNumber = NextDrawNumber;

        // Zichtbare naam reset per jaar
        var drawName = string.IsNullOrWhiteSpace(CurrentDrawName) ? $"Loting {NextYearDrawIndex}" : CurrentDrawName.Trim();

        // API: bewaren
        var saved = await SaveDrawAsync(drawNumber, drawName, FromDate.Date, ToDate.Date, winners, losers);
        if (!saved)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Opslaan mislukt", "Kon de loting niet bewaren.");
            return;
        }

        // UI: nieuwe draw toevoegen
        var rows = new List<DrawRow>();
        rows.AddRange(winners.Select(p => new DrawRow
        {
            DrawNumber = drawNumber,
            DrawName = drawName,
            FromDate = FromDate.Date,
            ToDate = ToDate.Date,
            PersonId = p.Id,
            FullName = $"{p.FirstName} {p.LastName}",
            Result = "Winnaar"
        }));
        rows.AddRange(losers.Select(p => new DrawRow
        {
            DrawNumber = drawNumber,
            DrawName = drawName,
            FromDate = FromDate.Date,
            ToDate = ToDate.Date,
            PersonId = p.Id,
            FullName = $"{p.FirstName} {p.LastName}",
            Result = "Verliezer"
        }));
        rows = rows.OrderBy(r => r.Result == "Verliezer").ThenBy(r => r.FullName).ToList();

        AllDraws.Add(new DrawView
        {
            DrawNumber = drawNumber,
            DrawName = drawName,
            FromDate = FromDate.Date,
            ToDate = ToDate.Date,
            Rows = rows
        });

        NotificationService.Notify(NotificationSeverity.Success, "Trekking voltooid",
            $"{drawName}: {winners.Count} winnaar(s) gekozen en opgeslagen.");

        CurrentDrawName = null;
        StateHasChanged();
    }

    // POST naar api/lottery/draw (DTO: LotteryDrawDTO met Winners + Losers)
    private async Task<bool> SaveDrawAsync(int drawNumber, string drawName, DateTime from, DateTime to,
                                           List<PersonBaseDTO> winners, List<PersonBaseDTO> losers)
    {
        try
        {
            var dto = new LotteryDrawDTO
            {
                DrawNumber = drawNumber,
                DrawName = drawName,
                FromDate = from,
                ToDate = to,
                Winners = winners.Select(w => new LotteryPersonDTO
                {
                    PersonId = w.Id,
                    FirstName = w.FirstName ?? "",
                    LastName = w.LastName ?? ""
                }).ToList(),
                Losers = losers.Select(l => new LotteryPersonDTO
                {
                    PersonId = l.Id,
                    FirstName = l.FirstName ?? "",
                    LastName = l.LastName ?? ""
                }).ToList()
            };

            var resp = await Http.PostAsJsonAsync("api/lottery/draw", dto);
            return resp.IsSuccessStatusCode;
        }
        catch
        {
            return false;
        }
    }

    // DELETE naar api/lottery/draw/{drawNumber}
    private async Task DeleteDraw(int drawNumber)
    {
        var confirmed = await DialogService.Confirm(
            $"Weet je zeker dat je loting wil wissen?",
            "Bevestigen",
            new ConfirmOptions { OkButtonText = "Ja", CancelButtonText = "Nee", CloseDialogOnEsc = true });

        if (confirmed != true) return;

        try
        {
            var resp = await Http.DeleteAsync($"api/lottery/draw/{drawNumber}");
            if (resp.IsSuccessStatusCode)
            {
                AllDraws.RemoveAll(d => d.DrawNumber == drawNumber);
                NotificationService.Notify(NotificationSeverity.Success, "Loting gewist", $"Loting {drawNumber} is verwijderd.");
            }
            else
            {
                var msg = await resp.Content.ReadAsStringAsync();
                NotificationService.Notify(NotificationSeverity.Error, "Fout", $"Wissen mislukt ({(int)resp.StatusCode}). {msg}");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Fout netwerk", ex.Message);
        }
    }

    // Winners count input
    private int WinnersCount { get; set; } = 1;

    // View models
    private class DrawView
    {
        public int DrawNumber { get; set; }
        public string DrawName { get; set; } = "";
        public DateTime FromDate { get; set; }
        public DateTime ToDate { get; set; }
        public List<DrawRow> Rows { get; set; } = new();
    }

    private class DrawRow
    {
        public int DrawNumber { get; set; }
        public string DrawName { get; set; } = "";
        public DateTime FromDate { get; set; }
