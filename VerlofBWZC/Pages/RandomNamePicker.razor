@page "/Random-picker"
@using System.Globalization
@using System.Net.Http.Headers
@using Radzen
@using Radzen.Blazor
@using VerlofBWZC.DataContracts.DTO
@using VerlofBWZC.DataContracts.DTO.Access
@using VerlofBWZC.DataContracts.DTO.Calendar
@using VerlofBWZC.DataContracts.DTO.Leave
@using VerlofBWZC.DataContracts.DTO.Lottery
@using VerlofBWZC.Services
@using VerlofBWZC.Handler
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@inject PersonApiService PersonApi
@inject LotteryApiService LotteryApi
@inject NotificationService NotificationService
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ScopeService Scope

<PageTitle>Loterij</PageTitle>

@if (isLoading)
{
    <h1>Loterij</h1>
    <p class="wc-loading">Loterij laden…</p>
}
else
{
    <!-- Kop: titel, jaar, ploeg/specialiteit, kerngetallen -->
    <div class="wc-header">
        <div class="wc-title">
            <h1>Loterij</h1>
            <div class="wc-year" role="group" aria-label="Jaar kiezen">
                <button type="button" class="wc-year-btn" aria-label="Vorig jaar" disabled="@(SelectedYear <= MinYear)" @onclick="() => ChangeYear(-1)">
                    <i class="rzi">chevron_left</i>
                </button>
                <span class="wc-year-label">@SelectedYear</span>
                <button type="button" class="wc-year-btn" aria-label="Volgend jaar" disabled="@(SelectedYear >= MaxYear)" @onclick="() => ChangeYear(1)">
                    <i class="rzi">chevron_right</i>
                </button>
            </div>
            @if (Scope.HasChoice)
            {
                <RadzenDropDown TValue="string" @bind-Value="SelectedTeam" Data="@TeamOptions" Placeholder="Ploeg" Style="width:140px" Change="@(async _ => { SelectedSpeciality = Scope.FixSpeciality(SelectedTeam, SelectedSpeciality); SpecialityOptions = Scope.SpecialitiesFor(SelectedTeam); await ReloadAllAsync(); })" />
                <RadzenDropDown TValue="string" @bind-Value="SelectedSpeciality" Data="@SpecialityOptions" Placeholder="Specialiteit" Style="width:200px" Change="@(async _ => await ReloadAllAsync())" />
            }
            else
            {
                <span class="tc-scope">@SelectedTeam · @SelectedSpeciality</span>
            }
        </div>
        <div class="lp-kpis">
            <span class="lp-kpi">Paren boven max <strong class="@(OverPairsYear > 0 ? "lp-red" : "")">@OverPairsYear</strong></span>
            <span class="lp-kpi">Lotingen <strong>@YearDraws.Count</strong> · niet toegepast <strong class="@(OpenDrawsYear > 0 ? "lp-orange" : "")">@OpenDrawsYear</strong></span>
        </div>
    </div>

    <div class="lp-grid">
        <!-- Links: nieuwe loting -->
        <section class="lp-card">
            <div class="lp-step">1 · Kies een shiftpaar</div>
            <div class="tc-months" role="group" aria-label="Maand kiezen">
                @for (var m = 1; m <= 12; m++)
                {
                    var month = m;
                    var hasOver = Pairs.Any(p => p.Day.Month == month && p.Over && !p.HasDraw);
                    <button type="button" class="@(SelectedMonth == month ? "tc-month tc-month-active" : "tc-month")"
                            aria-pressed="@(SelectedMonth == month ? "true" : "false")"
                            title="@(hasOver ? "Deze maand heeft paren boven het maximum zonder loting" : null)"
                            @onclick="() => SelectedMonth = month">
                        @ShortMonth(month)
                        @if (hasOver)
                        {
                            <span class="tc-month-dot"></span>
                        }
                    </button>
                }
                <label class="tc-two-months" title="Enkel paren waar meer personen verlof hebben dan het maximum">
                    <input type="checkbox" checked="@OnlyOver" @onchange="e => OnlyOver = (bool)(e.Value ?? false)" />
                    enkel boven max
                </label>
            </div>

            <div class="lp-pairs">
                @foreach (var p in VisiblePairs)
                {
                    var active = SelectedPair == p.Key;
                    <button type="button" class="@(active ? "lp-pair lp-pair-active" : "lp-pair")" @onclick="() => SelectedPair = p.Key">
                        <span class="lp-pair-date">@PairText(p)</span>
                        <span class="lp-pair-shifts">@(p.Shift ?? "D+N")</span>
                        @if (p.HasDraw)
                        {
                            <span class="@(p.DrawApplied ? "tl-status tl-status-done" : "tl-status tl-status-open")"><i class="rzi">task_alt</i> @(p.DrawApplied ? "geloot" : "niet toegepast")</span>
                        }
                        <span class="lp-pair-count">
                            @if (p.Shift != "N")
                            {
                                <span class="@(p.DayCount > QuotaFor("D") ? "tc-count tc-count-over" : "tc-count")">@p.DayCount/@QuotaFor("D")</span>
                            }
                            @if (p.Shift != "D")
                            {
                                <span class="@(p.NightCount > QuotaFor("N") ? "tc-count tc-count-over" : "tc-count")">@p.NightCount/@QuotaFor("N")</span>
                            }
                        </span>
                    </button>
                }
                @if (!VisiblePairs.Any())
                {
                    <p class="tl-hint">@(OnlyOver ? "Geen paren boven het maximum in deze maand." : "Geen shiften in deze maand.")</p>
                }
            </div>

            @if (SelectedPair != null && Pairs.FirstOrDefault(p => p.Key == SelectedPair) is Pair pair)
            {
                <div class="lp-step lp-step-2">2 · Loting @PairText(pair)</div>
                <LotteryForm @key="@($"{pair.Key}-{formVersion}")"
                             DayDate="pair.Day" NightDate="pair.Night" Quota="@(pair.Shift != null ? QuotaFor(pair.Shift) : Math.Max(QuotaFor("D"), QuotaFor("N")))" OnlyShift="@pair.Shift"
                             CanApply="CanApply" AllowAddPeople="true"
                             Load="() => LoadFormContext(pair)"
                             OnRemoved="OnRemovedAsync" OnRestored="OnRestoredAsync" OnChanged="OnFormChangedAsync" />
            }
            else
            {
                <p class="tl-hint lp-pick-hint">@(IsNoRegime ? "Kies hierboven een shift: in Ploeg0 geldt de loting per shift." : "Kies hierboven een shiftpaar: de dag- en nachtshift worden samen genomen.")</p>
            }
        </section>

        <!-- Rechts: resultaten -->
        <section class="lp-card">
            <div class="lp-results-head">
                <span class="lp-step" style="margin:0">Resultaten @SelectedYear</span>
                <input type="search" class="rz-textbox lp-search" @bind="Search" @bind:event="oninput" placeholder="Zoek op naam…" aria-label="Zoek op naam" />
                <RadzenDropDown TValue="string" @bind-Value="StatusFilter" Data="@StatusOptions" Style="width:150px" />
            </div>

            <!-- Stand per persoon: gewonnen/verloren lotingen dit jaar -->
            <button type="button" class="lp-standings-toggle" aria-expanded="@(showStandings ? "true" : "false")" @onclick="() => showStandings = !showStandings">
                <i class="rzi">@(showStandings ? "expand_less" : "expand_more")</i> Stand per persoon @SelectedYear
            </button>
            @if (showStandings)
            {
                var stats = LotteryApiService.StatsFor(TeamDraws, SelectedYear);
                <div class="lp-standings">
                    @foreach (var m in TeamMembers
                        .Select(m => (member: m, st: stats.TryGetValue(m.Id, out var s) ? s : new LotteryApiService.Stats(0, 0)))
                        .OrderByDescending(x => x.st.Lost).ThenBy(x => x.st.Won).ThenBy(x => x.member.LastName))
                    {
                        <div class="lp-standing">
                            <span class="lp-standing-name">@m.member.FirstName @m.member.LastName</span>
                            <span class="tl-record-w">@m.st.Won gew.</span>
                            <span class="tl-record-l">@m.st.Lost verl.</span>
                        </div>
                    }
                </div>
            }

            @foreach (var d in FilteredDraws)
            {
                var applied = LotteryApiService.IsApplied(d);
                <div class="@(applied || !d.Losers.Any() ? "lp-draw" : "lp-draw lp-draw-open")">
                    <div class="lp-draw-head">
                        <button type="button" class="lp-draw-title" title="Openen in de teamkalender" @onclick="() => OpenInTeamCalendar(d)">
                            @DrawPeriod(d)
                        </button>
                        <span class="lp-draw-name">@d.DrawName</span>
                        <span class="@(applied ? "tl-status tl-status-done" : "tl-status tl-status-open")">@(applied ? "toegepast" : d.Losers.Any() ? "niet toegepast" : "geen verliezers")</span>
                        <span class="lp-draw-actions">
                            @if (!applied && CanApply && d.Losers.Any())
                            {
                                <RadzenButton Text="Toepassen" Icon="done_all" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined"
                                              Click="@(() => { pendingApply = d.DrawNumber; pendingDelete = null; })" />
                            }
                            <RadzenButton Icon="delete" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined"
                                          title="Loting verwijderen" aria-label="Loting verwijderen"
                                          Click="@(() => { pendingDelete = d.DrawNumber; pendingApply = null; })" />
                        </span>
                    </div>
                    <div class="lp-draw-people">
                        @foreach (var w in d.Winners)
                        {
                            <span class="tl-tag tl-tag-win">@w.FirstName @w.LastName</span>
                        }
                        @foreach (var l in d.Losers)
                        {
                            <span class="tl-tag tl-tag-lose">@l.FirstName @l.LastName</span>
                        }
                    </div>
                    @if (pendingApply == d.DrawNumber)
                    {
                        <div class="tl-confirm">
                            <div class="tl-confirm-title"><i class="rzi">help_outline</i> Loting toepassen?</div>
                            <div class="tl-hint">@string.Join(", ", d.Losers.Select(l => $"{l.FirstName} {l.LastName}")) @(d.Losers.Count == 1 ? "verliest" : "verliezen") hun verlof op @DrawPeriod(d). Dit wordt meteen opgeslagen.</div>
                            <div class="tl-actions">
                                <RadzenButton Text="Terug" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => pendingApply = null)" />
                                <RadzenButton Text="Ja, toepassen" Icon="done_all" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                              Disabled="@busy" Click="@(() => ApplyDrawAsync(d))" />
                            </div>
                        </div>
                    }
                    @if (pendingDelete == d.DrawNumber)
                    {
                        <div class="tl-confirm tl-confirm-danger">
                            <div class="tl-confirm-title"><i class="rzi">delete</i> Loting verwijderen?</div>
                            <div class="tl-hint">@(applied ? "De verliezers krijgen hun verlof terug (met hun verlofregel)." : "Er werd nog geen verlof weggehaald.")</div>
                            <div class="tl-actions">
                                <RadzenButton Text="Terug" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => pendingDelete = null)" />
                                <RadzenButton Text="Ja, verwijderen" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                              Disabled="@busy" Click="@(() => DeleteDrawAsync(d))" />
                            </div>
                        </div>
                    }
                </div>
            }
            @if (!FilteredDraws.Any())
            {
                <p class="tl-hint">Geen lotingen gevonden.</p>
            }
            <p class="tl-hint lp-foot"><i class="rzi">event</i> Klik op de datum van een loting om ze in de teamkalender te openen.</p>
        </section>
    </div>
}

@code {
    private static readonly CultureInfo Nl = new("nl-BE");

    private bool isLoading = true;
    private bool isAdmin;
    private bool busy;
    private int formVersion;
    private int? pendingApply;
    private int? pendingDelete;
    private bool showStandings;

    private int SelectedYear = DateTime.Now.Year + 1;
    private int MinYear => DateTime.Now.Year - 1;
    private int MaxYear => DateTime.Now.Year + 10;
    private int SelectedMonth = 1;
    private bool OnlyOver = true;
    private string? SelectedPair; // Pair.Key

    private string? SelectedTeam;
    private string? SelectedSpeciality;
    private List<string> TeamOptions = new();
    private List<string> SpecialityOptions = new();

    private string? Search;
    private string StatusFilter = "Alle";
    private readonly List<string> StatusOptions = new() { "Alle", "Niet toegepast", "Toegepast" };

    private List<WorkDay> WorkDays = new();
    private List<PersonBaseDTO> TeamMembers = new();
    private List<TeamDayOff> DaysOff = new();
    private List<LeaveCategoryDTO> Categories = new();
    private List<LotteryDrawDTO> Draws = new();
    private CalendarPermissionsDTO? perms;

    public class TeamDayOff
    {
        public int PersonId { get; set; }
        public DateTime Date { get; set; }
        public string Shift { get; set; } = "";
        public int? LeaveCategoryId { get; set; }
    }

    // Shift null = paar dag + nacht; "D"/"N" = één shift (Ploeg0 zonder werkregime)
    private record Pair(DateTime Day, DateTime Night, int DayCount, int NightCount, bool Over, bool HasDraw, bool DrawApplied, string? Shift = null)
    {
        public string Key => $"{Day:yyyyMMdd}{Shift}";
    }

    // Ploeg0 heeft geen werkregime: loting per shift in plaats van per paar
    private bool IsNoRegime => SelectedTeam == "Ploeg0";

    // Maximum per shift: ingestelde regel (Instellingen > Max per shift) of standaard een kwart van de personen
    private ShiftQuotaDTO? quotaRule;
    private int QuotaFor(string shift) => quotaRule?.MaxFor(shift) ?? ShiftQuotaDTO.DefaultFor(TeamMembers.Count);
    private bool CanApply => isAdmin || (perms?.CanSaveTeamCalendar ?? false);

    // --- Shiftparen: dagshift op dag X + nachtshift op dag X+1 ---
    private List<Pair> Pairs => IsNoRegime ? SingleShifts : WorkDays
        .Where(w => w.Shift == "D")
        .OrderBy(w => w.Date)
        .Select(w =>
        {
            var day = w.Date.Date;
            var night = day.AddDays(1);
            var dc = DaysOff.Count(d => d.Date.Date == day && d.Shift == "D");
            var nc = DaysOff.Count(d => d.Date.Date == night && d.Shift == "N");
            var draws = DrawsFor(day, night);
            return new Pair(day, night, dc, nc, dc > QuotaFor("D") || nc > QuotaFor("N"), draws.Any(), draws.Any() && draws.All(d => LotteryApiService.IsApplied(d) || !d.Losers.Any()));
        })
        .ToList();

    private IEnumerable<Pair> VisiblePairs => Pairs
        .Where(p => p.Day.Month == SelectedMonth)
        .Where(p => !OnlyOver || p.Over || p.HasDraw || p.Key == SelectedPair);

    private int OverPairsYear => Pairs.Count(p => p.Over && !p.HasDraw);

    // Ploeg0: elke shift apart
    private List<Pair> SingleShifts => WorkDays
        .OrderBy(w => w.Date).ThenBy(w => w.Shift == "D" ? 0 : 1)
        .Select(w =>
        {
            var date = w.Date.Date;
            var count = DaysOff.Count(d => d.Date.Date == date && d.Shift == w.Shift);
            var draws = DrawsFor(date, date, w.Shift);
            return new Pair(date, date, w.Shift == "D" ? count : 0, w.Shift == "N" ? count : 0, count > QuotaFor(w.Shift),
                draws.Any(), draws.Any() && draws.All(d => LotteryApiService.IsApplied(d) || !d.Losers.Any()), w.Shift);
        })
        .ToList();

    // Lotingen voor een periode; met shift enkel lotingen op een paar of op precies die shift
    private List<LotteryDrawDTO> DrawsFor(DateTime day, DateTime night, string? shift = null) => TeamDraws
        .Where(d => d.FromDate.Date <= night && d.ToDate.Date >= day)
        .Where(d => shift == null || d.Shift == null || d.Shift == shift)
        .ToList();

    // Lotingen van deze ploeg/specialiteit: minstens één deelnemer is lid
    private IEnumerable<LotteryDrawDTO> TeamDraws => Draws
        .Where(d => d.Winners.Concat(d.Losers).Any(p => TeamMembers.Any(m => m.Id == p.PersonId)));

    private List<LotteryDrawDTO> YearDraws => TeamDraws
        .Where(d => d.FromDate.Year == SelectedYear || d.ToDate.Year == SelectedYear)
        .ToList();

    private int OpenDrawsYear => YearDraws.Count(d => d.Losers.Any() && !LotteryApiService.IsApplied(d));

    private IEnumerable<LotteryDrawDTO> FilteredDraws => YearDraws
        .Where(d => StatusFilter switch
        {
            "Toegepast" => LotteryApiService.IsApplied(d),
            "Niet toegepast" => d.Losers.Any() && !LotteryApiService.IsApplied(d),
            _ => true
        })
        .Where(d => string.IsNullOrWhiteSpace(Search)
            || d.DrawName.Contains(Search, StringComparison.OrdinalIgnoreCase)
            || d.Winners.Concat(d.Losers).Any(p => $"{p.FirstName} {p.LastName}".Contains(Search, StringComparison.OrdinalIgnoreCase)))
        .OrderByDescending(d => d.FromDate).ThenByDescending(d => d.CreatedAtUtc);

    private static string ShortMonth(int month) =>
        new DateTime(2000, month, 1).ToString("MMM", new CultureInfo("nl-BE")).TrimEnd('.');

    private string PairText(Pair p) => p.Shift != null
        ? $"{p.Day.ToString("ddd d", Nl)} · {(p.Shift == "D" ? "dag" : "nacht")}"
        : $"{p.Day.ToString("ddd d", Nl)} – {p.Night.ToString(p.Day.Month == p.Night.Month ? "ddd d" : "ddd d MMM", Nl)}";

    private string DrawPeriod(LotteryDrawDTO d)
    {
        if (d.FromDate.Date == d.ToDate.Date)
        {
            var shift = d.Shift ?? WorkDays.FirstOrDefault(w => w.Date.Date == d.FromDate.Date)?.Shift;
            return $"{d.FromDate.ToString("ddd d MMM", Nl)}{(shift != null ? $" ({shift})" : "")}";
        }
        var sameMonth = d.FromDate.Month == d.ToDate.Month;
        return $"{d.FromDate.ToString(sameMonth ? "ddd d" : "ddd d MMM", Nl)} – {d.ToDate.ToString("ddd d MMM", Nl)} (D+N)";
    }

    // --- Laden ---

    protected override async Task OnInitializedAsync()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        var userId = JwtUtils.GetUserIdFromToken(token);
        var person = userId != null ? await PersonApi.GetPersonByIdAsync(int.Parse(userId)) : null;
        SelectedTeam = person?.Team;
        SelectedSpeciality = person?.Speciality;
        isAdmin = string.Equals(person?.Role, "Admin", StringComparison.OrdinalIgnoreCase);

        // Admin: alle ploegen; Manager: de ploegen en specialiteiten die hij beheert
        await Scope.LoadAsync(refresh: true);
        if (Scope.HasChoice)
        {
            TeamOptions = Scope.Teams;
            if (!TeamOptions.Contains(SelectedTeam ?? "")) SelectedTeam = TeamOptions.FirstOrDefault();
            SelectedSpeciality = Scope.FixSpeciality(SelectedTeam, SelectedSpeciality);
            SpecialityOptions = Scope.SpecialitiesFor(SelectedTeam);
        }

        await ReloadAllAsync();
        SelectedMonth = SelectedYear == DateTime.Now.Year ? DateTime.Now.Month : 1;
        isLoading = false;
    }

    private async Task ChangeYear(int delta)
    {
        var year = SelectedYear + delta;
        if (year < MinYear || year > MaxYear) return;
        SelectedYear = year;
        SelectedMonth = SelectedYear == DateTime.Now.Year ? DateTime.Now.Month : 1;
        await ReloadAllAsync();
    }

    private async Task ReloadAllAsync()
    {
        SelectedPair = null;
        pendingApply = pendingDelete = null;
        if (string.IsNullOrEmpty(SelectedTeam) || string.IsNullOrEmpty(SelectedSpeciality))
            return;

        try
        {
            TeamMembers = await Http.GetFromJsonAsync<List<PersonBaseDTO>>($"api/person/team/{SelectedTeam}/{SelectedSpeciality}") ?? new();
            WorkDays = await Http.GetFromJsonAsync<List<WorkDay>>($"api/calender?teamName={SelectedTeam}&year={SelectedYear}") ?? new();
            try
            {
                Categories = await Http.GetFromJsonAsync<List<LeaveCategoryDTO>>($"api/leave-categories?team={SelectedTeam}&speciality={SelectedSpeciality}&year={SelectedYear}") ?? new();
            }
            catch
            {
                Categories = new();
            }
            await LoadDaysOffAsync();
            Draws = await LotteryApi.GetDrawsAsync();
            await LoadPermissionsAsync();
            try
            {
                var quotas = await Http.GetFromJsonAsync<List<ShiftQuotaDTO>>($"api/shift-quotas?team={SelectedTeam}&year={SelectedYear}") ?? new();
                quotaRule = quotas.FirstOrDefault(q => q.Speciality == SelectedSpeciality);
            }
            catch
            {
                quotaRule = null;
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Laden mislukt", ex.Message);
        }
        formVersion++;
    }

    private async Task LoadDaysOffAsync()
    {
        DaysOff = await Http.GetFromJsonAsync<List<TeamDayOff>>($"api/person/team-days-off/{SelectedTeam}/{SelectedYear}/{SelectedSpeciality}") ?? new();
    }

    private async Task LoadPermissionsAsync()
    {
        if (isAdmin) { perms = null; return; }
        try
        {
            // Rechten van de gekozen ploeg/specialiteit (een manager kan meerdere ploegen beheren)
            perms = await Http.GetFromJsonAsync<CalendarPermissionsDTO>($"api/access/calendar-permissions?year={SelectedYear}&team={Uri.EscapeDataString(SelectedTeam ?? "")}&speciality={Uri.EscapeDataString(SelectedSpeciality ?? "")}");
        }
        catch
        {
            perms = null;
        }
    }

    // --- Formulier (links) ---

    private async Task<LotteryForm.Context> LoadFormContext(Pair pair)
    {
        Draws = await LotteryApi.GetDrawsAsync();
        return new LotteryForm.Context
        {
            Candidates = BuildCandidates(pair.Day, pair.Night),
            ExistingDraws = DrawsFor(pair.Day, pair.Night, pair.Shift),
            TeamMembers = TeamMembers,
            Stats = LotteryApiService.StatsFor(TeamDraws, SelectedYear),
            NextDrawNumber = Draws.Count == 0 ? 1 : Draws.Max(d => d.DrawNumber) + 1
        };
    }

    // Iedereen met verlof op de dag- en/of nachtshift van het paar
    private List<LotteryForm.Candidate> BuildCandidates(DateTime day, DateTime night) => DaysOff
        .Where(d => (d.Date.Date == day && d.Shift == "D") || (d.Date.Date == night && d.Shift == "N"))
        .GroupBy(d => d.PersonId)
        .Select(g =>
        {
            var member = TeamMembers.FirstOrDefault(m => m.Id == g.Key);
            var catId = g.Select(d => d.LeaveCategoryId).FirstOrDefault(id => id != null);
            var category = catId is int id ? Categories.FirstOrDefault(c => c.Id == id) : null;
            var shifts = g.Select(d => d.Shift).Distinct().OrderBy(s => s == "D" ? 0 : 1).ToList();
            return member == null ? null : new LotteryForm.Candidate
            {
                PersonId = member.Id,
                FirstName = member.FirstName ?? "",
                LastName = member.LastName ?? "",
                Category = category?.Name,
                Color = category?.Color,
                Shifts = string.Join("+", shifts)
            };
        })
        .Where(c => c != null)
        .Select(c => c!)
        .OrderBy(c => c.LastName).ThenBy(c => c.FirstName)
        .ToList();

    private Task OnRemovedAsync(List<RestoredDayOffDTO> removed)
    {
        DaysOff.RemoveAll(d => removed.Any(r => r.PersonId == d.PersonId && r.Date.Date == d.Date.Date && r.Shift == d.Shift));
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task OnRestoredAsync(List<RestoredDayOffDTO> restored)
    {
        foreach (var r in restored.Where(r => !DaysOff.Any(d => d.PersonId == r.PersonId && d.Date.Date == r.Date.Date && d.Shift == r.Shift)))
            DaysOff.Add(new TeamDayOff { PersonId = r.PersonId, Date = r.Date, Shift = r.Shift, LeaveCategoryId = r.LeaveCategoryId });
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task OnFormChangedAsync()
    {
        Draws = await LotteryApi.GetDrawsAsync();
        StateHasChanged();
    }

    // --- Resultaten (rechts) ---

    private async Task ApplyDrawAsync(LotteryDrawDTO d)
    {
        busy = true;
        try
        {
            var res = await LotteryApi.ApplyAsync(d.DrawNumber);
            if (!res.Ok)
            {
                NotificationService.Notify(NotificationSeverity.Error, "Niet toegepast", res.Error);
                return;
            }
            await OnRemovedAsync(res.Value!);
            NotificationService.Notify(NotificationSeverity.Success, "Loting toegepast", d.DrawName);
            pendingApply = null;
            Draws = await LotteryApi.GetDrawsAsync();
            formVersion++; // formulier links opnieuw opbouwen
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeleteDrawAsync(LotteryDrawDTO d)
    {
        busy = true;
        try
        {
            var res = await LotteryApi.DeleteAsync(d.DrawNumber);
            if (!res.Ok)
            {
                NotificationService.Notify(NotificationSeverity.Error, "Niet verwijderd", res.Error);
                return;
            }
            await OnRestoredAsync(res.Value!);
            NotificationService.Notify(NotificationSeverity.Success, "Loting verwijderd",
                res.Value!.Count > 0 ? $"{d.DrawName}: verlof teruggezet." : d.DrawName);
            pendingDelete = null;
            Draws = await LotteryApi.GetDrawsAsync();
            formVersion++;
        }
        finally
        {
            busy = false;
        }
    }

    private void OpenInTeamCalendar(LotteryDrawDTO d)
    {
        var url = $"teamcalendar?jaar={d.FromDate.Year}&maand={d.FromDate.Month}";
        if (Scope.HasChoice)
            url += $"&ploeg={Uri.EscapeDataString(SelectedTeam ?? "")}&spec={Uri.EscapeDataString(SelectedSpeciality ?? "")}";
        Nav.NavigateTo(url);
    }
}
