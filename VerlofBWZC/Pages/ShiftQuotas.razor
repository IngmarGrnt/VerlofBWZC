@page "/max-per-shift"
@attribute [Authorize(Roles = "Admin,Manager")]
@using Microsoft.AspNetCore.Authorization
@using Radzen
@using Radzen.Blazor
@using System.Net.Http.Json
@using VerlofBWZC.DataContracts.DTO.Leave
@using VerlofBWZC.Services
@inject HttpClient Http
@inject ScopeService Scope
@inject NotificationService Notifications
@inject DialogService DialogService
@inject CurrentPersonService CurrentPerson

<h3>Max per shift</h3>
<p class="rz-text-secondary" style="max-width:900px;">
    Hoeveel personen van een ploeg en specialiteit tegelijk verlof mogen hebben op één shift.
    Waar niets is ingesteld geldt de standaard: <strong>een kwart van de personen</strong> (minstens 1).
    De teamkalender kleurt een shift rood als het maximum overschreden wordt, en toont dan de knop voor een loting.
</p>

<!-- Filters -->
<RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="0.5rem" AlignItems="AlignItems.End" Style="margin-bottom:1rem">
    <div>
        <label>Ploeg</label>
        <RadzenDropDown TValue="string" Data="@teams" @bind-Value="teamFilter" AllowClear="@(isAdmin || Scope.HasChoice)" Placeholder="Alle" Style="width:160px" />
    </div>
    <div>
        <label>Specialiteit</label>
        <RadzenDropDown TValue="string" Data="@specialities" @bind-Value="specialityFilter" AllowClear="@(isAdmin || Scope.HasChoice)" Placeholder="Alle" Style="width:200px" />
    </div>
</RadzenStack>

<RadzenButton Icon="add" Text="Regel toevoegen" Click="@StartCreate" Disabled="@(editing != null)" Style="margin-bottom:1rem" />

@if (editing != null)
{
    <RadzenCard Style="margin-bottom:1rem; max-width:900px;">
        <h5>@(editing.Id == 0 ? "Nieuwe regel" : "Regel wijzigen")</h5>
        <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="1rem">
            @if (editing.Id == 0)
            {
                <div>
                    <label>Ploeg(en)</label>
                    <RadzenDropDown TValue="IEnumerable<string>" Data="@teams" @bind-Value="createTeams" Multiple="true" Chips="true" Style="width:260px" />
                </div>
                <div>
                    <label>Specialiteit(en)</label>
                    <RadzenDropDown TValue="IEnumerable<string>" Data="@specialities" @bind-Value="createSpecialities" Multiple="true" Chips="true" Style="width:320px" />
                </div>
            }
            else
            {
                <div>
                    <label>Ploeg</label>
                    <RadzenDropDown TValue="string" Data="@teams" @bind-Value="editing.Team" Style="width:160px" />
                </div>
                <div>
                    <label>Specialiteit</label>
                    <RadzenDropDown TValue="string" Data="@specialities" @bind-Value="editing.Speciality" Style="width:200px" />
                </div>
            }
            <div>
                <label>Jaar (leeg = alle jaren)</label>
                <RadzenDropDown TValue="int?" Data="@years" @bind-Value="editing.Year" AllowClear="true" Placeholder="Alle jaren" Style="width:160px" />
            </div>
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="1rem" AlignItems="AlignItems.End" Style="margin-top:1rem">
            <div>
                <label class="sq-same">
                    <input type="checkbox" checked="@sameForBoth" @onchange="e => ToggleSame((bool)(e.Value ?? false))" />
                    Zelfde voor dag en nacht
                </label>
            </div>
            @if (sameForBoth)
            {
                <div>
                    <label>Max per shift (dag en nacht)</label>
                    <RadzenNumeric TValue="int" Value="@editing.DayMax" ValueChanged="@(v => { editing.DayMax = v; editing.NightMax = v; })" Min="0" Max="100" Style="width:140px" />
                </div>
            }
            else
            {
                <div>
                    <label>Max dagshift</label>
                    <RadzenNumeric TValue="int" @bind-Value="editing.DayMax" Min="0" Max="100" Style="width:120px" />
                </div>
                <div>
                    <label>Max nachtshift</label>
                    <RadzenNumeric TValue="int" @bind-Value="editing.NightMax" Min="0" Max="100" Style="width:120px" />
                </div>
            }
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Style="margin-top:1rem">
            <RadzenButton Icon="save" Text="Opslaan" Click="@Save" />
            <RadzenButton Icon="close" Text="Annuleren" ButtonStyle="ButtonStyle.Light" Click="@(() => editing = null)" />
        </RadzenStack>
    </RadzenCard>
}

<RadzenDataGrid TItem="ShiftQuotaDTO" Data="@FilteredRules" AllowSorting="true" EmptyText="Nog geen regels: overal geldt een kwart van de personen.">
    <Columns>
        <RadzenDataGridColumn TItem="ShiftQuotaDTO" Property="Team" Title="Ploeg" Width="110px" />
        <RadzenDataGridColumn TItem="ShiftQuotaDTO" Property="Speciality" Title="Specialiteit" Width="150px" />
        <RadzenDataGridColumn TItem="ShiftQuotaDTO" Property="Year" Title="Jaar" Width="100px">
            <Template Context="r">@(r.Year?.ToString() ?? "Alle jaren")</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ShiftQuotaDTO" Property="DayMax" Title="Max dag" Width="110px" />
        <RadzenDataGridColumn TItem="ShiftQuotaDTO" Property="NightMax" Title="Max nacht" Width="110px" />
        <RadzenDataGridColumn TItem="ShiftQuotaDTO" Title="" Width="120px" Sortable="false">
            <Template Context="r">
                <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => StartEdit(r))" Disabled="@(editing != null)" />
                <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Click="@(() => Delete(r))" Disabled="@(editing != null)" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    private List<string> teams = new();
    private List<string> specialities = new();
    private List<int> years = Enumerable.Range(DateTime.Now.Year - 1, 12).ToList();
    private string? teamFilter;
    private string? specialityFilter;
    private bool isAdmin;

    private List<ShiftQuotaDTO> rules = new();
    private ShiftQuotaDTO? editing;
    private bool sameForBoth = true;
    private IEnumerable<string> createTeams = Array.Empty<string>();
    private IEnumerable<string> createSpecialities = Array.Empty<string>();

    private IEnumerable<ShiftQuotaDTO> FilteredRules => rules
        .Where(r => teamFilter == null || r.Team == teamFilter)
        .Where(r => specialityFilter == null || r.Speciality == specialityFilter);

    protected override async Task OnInitializedAsync()
    {
        teams = await Http.GetFromJsonAsync<List<string>>("api/meta/teams") ?? new();
        specialities = await Http.GetFromJsonAsync<List<string>>("api/meta/specialities") ?? new();

        var me = await CurrentPerson.GetAsync();
        isAdmin = CurrentPersonService.IsAdmin(me);
        if (!isAdmin && me != null)
        {
            // Manager: de ploegen en specialiteiten die hij beheert (de API controleert dit ook)
            await Scope.LoadAsync(refresh: true);
            teams = Scope.Teams;
            specialities = teams.SelectMany(t => Scope.SpecialitiesFor(t)).Distinct().OrderBy(s => Scope.AllSpecialityNames.IndexOf(s)).ToList();
            if (!Scope.HasChoice)
            {
                teamFilter = me.Team;
                specialityFilter = me.Speciality;
            }
        }

        await LoadRules();
    }

    private async Task LoadRules()
        => rules = await Http.GetFromJsonAsync<List<ShiftQuotaDTO>>("api/shift-quotas/rules") ?? new();

    private void ToggleSame(bool on)
    {
        sameForBoth = on;
        if (on && editing != null)
            editing.NightMax = editing.DayMax;
    }

    private void StartCreate()
    {
        editing = new ShiftQuotaDTO();
        sameForBoth = true;
        createTeams = teamFilter != null ? new[] { teamFilter } : Array.Empty<string>();
        createSpecialities = specialityFilter != null ? new[] { specialityFilter } : Array.Empty<string>();
    }

    private void StartEdit(ShiftQuotaDTO r)
    {
        editing = new ShiftQuotaDTO { Id = r.Id, Team = r.Team, Speciality = r.Speciality, Year = r.Year, DayMax = r.DayMax, NightMax = r.NightMax };
        sameForBoth = r.DayMax == r.NightMax;
    }

    private async Task Save()
    {
        if (editing == null) return;
        if (sameForBoth)
            editing.NightMax = editing.DayMax;

        if (editing.Id == 0)
        {
            if (!createTeams.Any() || !createSpecialities.Any())
            {
                Notify(NotificationSeverity.Warning, "Kies minstens één ploeg en één specialiteit.");
                return;
            }

            var created = 0;
            foreach (var team in createTeams)
            foreach (var spec in createSpecialities)
            {
                var dto = new ShiftQuotaDTO { Team = team, Speciality = spec, Year = editing.Year, DayMax = editing.DayMax, NightMax = editing.NightMax };
                var resp = await Http.PostAsJsonAsync("api/shift-quotas/rules", dto);
                if (!resp.IsSuccessStatusCode)
                {
                    Notify(NotificationSeverity.Error, await ErrorAsync(resp));
                    await LoadRules();
                    return;
                }
                created++;
            }
            Notify(NotificationSeverity.Success, $"{created} regel(s) toegevoegd.");
        }
        else
        {
            var resp = await Http.PutAsJsonAsync($"api/shift-quotas/rules/{editing.Id}", editing);
            if (!resp.IsSuccessStatusCode)
            {
                Notify(NotificationSeverity.Error, await ErrorAsync(resp));
                return;
            }
            Notify(NotificationSeverity.Success, "Regel bijgewerkt.");
        }

        editing = null;
        await LoadRules();
    }

    private async Task Delete(ShiftQuotaDTO r)
    {
        var ok = await DialogService.Confirm(
            $"Regel voor {r.Team}/{r.Speciality} ({r.Year?.ToString() ?? "alle jaren"}) verwijderen? Daarna geldt weer de standaard (een kwart van de personen).",
            "Verwijderen", new ConfirmOptions { OkButtonText = "Verwijderen", CancelButtonText = "Annuleren" });
        if (ok != true) return;

        var resp = await Http.DeleteAsync($"api/shift-quotas/rules/{r.Id}");
        if (resp.IsSuccessStatusCode)
        {
            Notify(NotificationSeverity.Success, "Regel verwijderd.");
            await LoadRules();
        }
        else
        {
            Notify(NotificationSeverity.Error, await ErrorAsync(resp));
        }
    }

    private static async Task<string> ErrorAsync(HttpResponseMessage resp)
    {
        if (resp.StatusCode == System.Net.HttpStatusCode.Forbidden)
            return "Je hebt geen rechten voor deze ploeg of specialiteit.";
        var text = (await resp.Content.ReadAsStringAsync()).Trim().Trim('"');
        return string.IsNullOrWhiteSpace(text) || text.StartsWith("{") ? $"Mislukt ({(int)resp.StatusCode})." : text;
    }

    private void Notify(NotificationSeverity severity, string detail)
        => Notifications.Notify(new NotificationMessage { Severity = severity, Summary = "Max per shift", Detail = detail, Duration = 4000 });
}
