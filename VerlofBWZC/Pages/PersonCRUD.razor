@page "/person-crud"
@using Radzen
@using Radzen.Blazor
@using System.Text.Json
@using System.Linq.Expressions
@using System.Net.Http.Json
@using VerlofBWZC.DataContracts
@using VerlofBWZC.DataContracts.DTO
@using VerlofBWZC.DataContracts.DTO.Access
@using VerlofBWZC.Services
@inject HttpClient Http
@inject PersonApiService PersonApi
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject CurrentPersonService CurrentPerson

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Manager")]

<h1>Personenbeheer</h1>

@if (isAdmin)
{
    <RadzenButton Icon="add_circle" Text="Nieuwe persoon" Style="margin-bottom: 10px" Click="@AddPerson" />
}
else
{
    <p class="rz-text-secondary">Personen van je eigen ploeg en specialiteit. Je kan naam, initialen, e-mail, rol (geen Admin) en verlofaantal aanpassen, en het wachtwoord resetten.</p>
}

<div class="responsive-datagrid-container">
    <RadzenDataGrid TItem="PersonBaseDTO" Data="@persons" @ref="grid"
                    AllowFiltering="true"
                    FilterMode="FilterMode.Simple"
                    AllowSorting="true"
                    AllowMultiColumnSorting="true"
                    PageSize="10"
                    EditMode="DataGridEditMode.Single"
                    AllowColumnResize="true"
                    class="responsive-datagrid">
        <Columns>
            <RadzenDataGridColumn TItem="PersonBaseDTO" Property="FirstName" Title="Voornaam"
                                  FilterOperator="FilterOperator.Contains">
                <EditTemplate Context="person">
                    <RadzenTextBox @bind-Value="person.FirstName" Style="width:100%" Name="FirstName" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="PersonBaseDTO" Property="LastName" Title="Achternaam"
                                  FilterOperator="FilterOperator.Contains">
                <Template Context="person">
                    @person.LastName
                    @if (person.MustChangePassword)
                    {
                        <span class="pc-temp-pw" title="Heeft een tijdelijk wachtwoord en moet bij de volgende login een eigen wachtwoord kiezen">tijdelijk wachtwoord</span>
                    }
                </Template>
                <EditTemplate Context="person">
                    <RadzenTextBox @bind-Value="person.LastName" Style="width:100%" Name="LastName" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="PersonBaseDTO" Property="Initials" Title="Initialen" Width="110px"
                                  FilterOperator="FilterOperator.Contains">
                <Template Context="person">
                    @{ var dup = SameInitials(person); }
                    @if (dup.Any())
                    {
                        @* Bestaande dubbele initialen in dezelfde ploeg en specialiteit: aanpassen *@
                        <span class="pc-initials-dup" title="@($"Ook gebruikt door {string.Join(", ", dup.Select(p => $"{p.FirstName} {p.LastName}"))} in dezelfde ploeg en specialiteit")">
                            @PersonInitials.For(person) <i class="rzi">warning</i>
                        </span>
                    }
                    else
                    {
                        @PersonInitials.For(person)
                    }
                </Template>
                <EditTemplate Context="person">
                    @* Leeg laten = standaardregel op de achternaam *@
                    <RadzenTextBox @bind-Value="person.Initials" MaxLength="@PersonInitials.MaxLength" Style="width:100%" Name="Initials"
                                   Placeholder="@PersonInitials.FromLastName(person.LastName)"
                                   title="Leeg laten = standaard volgens de achternaam" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="PersonBaseDTO" Property="Email" Title="Email"
                                  FilterOperator="FilterOperator.Contains">
                <EditTemplate Context="person">
                    <RadzenTextBox @bind-Value="person.Email" Style="width:100%" Name="Email" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="PersonBaseDTO" Property="Team" Title="Team"
                                  FilterValue="@filterTeam" FilterOperator="FilterOperator.Equals">
                <FilterTemplate>
                    <RadzenDropDown Data="@TeamOptions"
                                    @bind-Value="@filterTeam"
                                    AllowClear="true"
                                    AllowFiltering="true"
                                    Placeholder="Alle teams"
                                    Style="width:100%"
                                    Change="@(args => grid.Reload())" />
                </FilterTemplate>
                <Template Context="person">@person.Team</Template>
                <EditTemplate Context="person">
                    @if (isAdmin)
                    {
                    <RadzenDropDown Data="@TeamOptions"
                                    @bind-Value="person.Team"
                                    AllowFiltering="true"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    Style="width:100%" />
                    }
                    else
                    {
                        @person.Team
                    }
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="PersonBaseDTO" Property="Speciality" Title="Specialiteit"
                                  FilterValue="@filterSpeciality" FilterOperator="FilterOperator.Equals">
                <FilterTemplate>
                    <RadzenDropDown Data="@SpecialityOptions"
                                    @bind-Value="@filterSpeciality"
                                    AllowClear="true"
                                    AllowFiltering="true"
                                    Placeholder="Alle specialiteiten"
                                    Style="width:100%"
                                    Change="@(args => grid.Reload())" />
                </FilterTemplate>
                <Template Context="person">@person.Speciality</Template>
                <EditTemplate Context="person">
                    @if (isAdmin)
                    {
                    <RadzenDropDown Data="@SpecialityOptions"
                                    @bind-Value="person.Speciality"
                                    AllowFiltering="true"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    Style="width:100%" />
                    }
                    else
                    {
                        @person.Speciality
                    }
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="PersonBaseDTO" Property="Grade" Title="Graad"
                                  FilterValue="@filterGrade" FilterOperator="FilterOperator.Equals">
                <FilterTemplate>
                    <RadzenDropDown Data="@GradeOptions"
                                    @bind-Value="@filterGrade"
                                    AllowClear="true"
                                    AllowFiltering="true"
                                    Placeholder="Alle graden"
                                    Style="width:100%"
                                    Change="@(args => grid.Reload())" />
                </FilterTemplate>
                <Template Context="person">@person.Grade</Template>
                <EditTemplate Context="person">
                    @if (isAdmin)
                    {
                    <RadzenDropDown Data="@GradeOptions"
                                    @bind-Value="person.Grade"
                                    AllowFiltering="true"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    Style="width:100%" />
                    }
                    else
                    {
                        @person.Grade
                    }
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="PersonBaseDTO" Property="Role" Title="Rol"
                                  FilterValue="@filterRole" FilterOperator="FilterOperator.Equals">
                <FilterTemplate>
                    <RadzenDropDown Data="@RoleOptions"
                                    @bind-Value="@filterRole"
                                    AllowClear="true"
                                    AllowFiltering="true"
                                    Placeholder="Alle rollen"
                                    Style="width:100%"
                                    Change="@(args => grid.Reload())" />
                </FilterTemplate>
                <Template Context="person">@person.Role</Template>
                <EditTemplate Context="person">
                    <RadzenDropDown Data="@EditableRoleOptions"
                                    @bind-Value="person.Role"
                                    AllowFiltering="true"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="PersonBaseDTO" Property="LeaveAllowance" Title="Verlof/jaar (shiften)" Width="150px">
                <Template Context="person">@(person.LeaveAllowance?.ToString() ?? "-")</Template>
                <EditTemplate Context="person">
                    <RadzenNumeric TValue="int?" @bind-Value="person.LeaveAllowance" Min="0" Max="366" Placeholder="geen" Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="PersonBaseDTO" Context="person">
                <Template Context="person">
                    @* Manager: geen Admin-accounts aanpassen, niemand verwijderen *@
                    @if (isAdmin || person.Role != "Admin")
                    {
                        <RadzenButton Icon="edit" Click="@(() => EditRow(person))" Style="margin-right: 5px" />
                    }
                    @if (isAdmin)
                    {
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Click="@(() => DeletePerson(person))" Style="margin-right: 5px" />
                    }
                    @if (isAdmin || person.Role != "Admin")
                    {
                        <RadzenButton Icon="lock_reset" ButtonStyle="ButtonStyle.Info" title="Wachtwoord resetten (tijdelijk wachtwoord)" Click="@(() => ResetPasswordAsync(person))" />
                    }
                    @if (isAdmin && person.Role == "Manager")
                    {
                        @* Manager: beheerde ploegen aanpassen; de tooltip toont wat hij beheert *@
                        <RadzenButton Icon="groups" ButtonStyle="ButtonStyle.Warning" Style="margin-left: 5px"
                                      title="@($"Beheerde ploegen: {ScopesTooltip(person)}")"
                                      Click="@(() => OpenScopesAsync(person))" />
                    }
                </Template>
                <EditTemplate Context="person">
                    <RadzenButton Icon="save" ButtonStyle="ButtonStyle.Primary" Click="@(() => SaveRow(person))" Style="margin-right: 5px" />
                    <RadzenButton Icon="cancel" ButtonStyle="ButtonStyle.Light" Click="@(() => CancelEdit(person))" />
                </EditTemplate>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>


@code {
    private List<PersonBaseDTO> persons = new();
    private Dictionary<int, string> originalInitials = new();
    private PersonBaseDTO newPerson = new();
    private RadzenDataGrid<PersonBaseDTO> grid;

    private List<string> TeamOptions = new();
    private List<string> SpecialityOptions = new();
    private List<string> GradeOptions = new();
    private List<string> RoleOptions = new();

    private string? filterTeam;
    private string? filterSpeciality;
    private string? filterGrade;
    private string? filterRole;

    // Admin: alles; Manager: eigen ploeg + specialiteit, rol nooit Admin (de API controleert dit ook)
    private bool isAdmin;
    private IEnumerable<string> EditableRoleOptions => isAdmin ? RoleOptions : RoleOptions.Where(r => r != "Admin");

    protected override async Task OnInitializedAsync()
    {
        isAdmin = CurrentPersonService.IsAdmin(await CurrentPerson.GetAsync());
        await LoadMetaAsync();
        await LoadPersons();
    }

    private async Task LoadMetaAsync()
    {
        TeamOptions = await Http.GetFromJsonAsync<List<string>>("api/meta/teams") ?? new();
        SpecialityOptions = await Http.GetFromJsonAsync<List<string>>("api/meta/specialities") ?? new();
        GradeOptions = await Http.GetFromJsonAsync<List<string>>("api/meta/grades") ?? new();
        RoleOptions = await Http.GetFromJsonAsync<List<string>>("api/meta/roles") ?? new();
    }

    private async Task LoadPersons()
    {
        persons = await PersonApi.GetAllPersonsAsync();
        originalInitials = persons.ToDictionary(p => p.Id, p => PersonInitials.For(p));
        if (isAdmin)
        {
            try
            {
                managerScopes = await Http.GetFromJsonAsync<List<ManagerScopesDTO>>("api/manager-scopes") ?? new();
            }
            catch
            {
                managerScopes = new();
            }
        }
        StateHasChanged();
    }

    // Extra ploegen/specialiteiten per manager (bovenop de eigen)
    private List<ManagerScopesDTO> managerScopes = new();

    private List<ScopeItemDTO> ScopesOf(int personId) =>
        managerScopes.FirstOrDefault(m => m.PersonId == personId)?.Scopes ?? new();

    // Bv. "Ploeg1 · IGS (eigen), Ploeg2 · IGS, Ploeg3 · alle specialiteiten"
    private string ScopesTooltip(PersonBaseDTO person) =>
        string.Join(", ", new[] { $"{ManagerScopesDialog.ChipText(person.Team, person.Speciality)} (eigen)" }
            .Concat(ScopesOf(person.Id).Select(s => ManagerScopesDialog.ChipText(s.Team, s.Speciality))));

    private async Task OpenScopesAsync(PersonBaseDTO person)
    {
        var saved = await DialogService.OpenAsync<ManagerScopesDialog>(
            $"Beheert · {person.FirstName} {person.LastName}",
            new Dictionary<string, object>
            {
                { nameof(ManagerScopesDialog.PersonId), person.Id },
                { nameof(ManagerScopesDialog.PersonName), $"{person.FirstName} {person.LastName}" },
                { nameof(ManagerScopesDialog.OwnTeam), person.Team },
                { nameof(ManagerScopesDialog.OwnSpeciality), person.Speciality },
                { nameof(ManagerScopesDialog.Teams), TeamOptions },
                { nameof(ManagerScopesDialog.Specialities), SpecialityOptions },
                { nameof(ManagerScopesDialog.Current), ScopesOf(person.Id) }
            },
            new DialogOptions { Width = "520px", CloseDialogOnEsc = true });
        if (saved is true)
            await LoadPersons();
    }

    private async Task AddPerson()
    {
        newPerson = new PersonBaseDTO
        {
            Team = TeamOptions.FirstOrDefault() ?? "",
            Speciality = SpecialityOptions.FirstOrDefault() ?? "",
            LeaveAllowance = PersonDefaults.LeaveAllowance,
            Grade = GradeOptions.FirstOrDefault() ?? "",
            Role = RoleOptions.FirstOrDefault() ?? ""
        };
        await grid.InsertRow(newPerson);
    }

    private async Task EditRow(PersonBaseDTO person)
    {
        await grid.EditRow(person);
    }

    // Andere personen in dezelfde ploeg en specialiteit met dezelfde initialen
    private List<PersonBaseDTO> SameInitials(PersonBaseDTO person) => persons
        .Where(p => p != person && p.Id != person.Id && p.Team == person.Team && p.Speciality == person.Speciality)
        .Where(p => string.Equals(PersonInitials.For(p), PersonInitials.For(person), StringComparison.OrdinalIgnoreCase))
        .ToList();

    private async Task SaveRow(PersonBaseDTO person)
    {
        // Initialen opschonen (leeg = standaardregel); binnen dezelfde ploeg en specialiteit moeten ze uniek zijn
        person.Initials = PersonInitials.Normalize(person.Initials, person.LastName);
        var sameInitials = SameInitials(person);
        // Enkel tegenhouden als de initialen (of de persoon) nieuw zijn; bestaande dubbels blokkeren andere aanpassingen niet
        var changed = person == newPerson || !originalInitials.TryGetValue(person.Id, out var orig) || orig != person.Initials;
        if (changed && sameInitials.Any())
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Dubbele initialen",
                Detail = $"De initialen {person.Initials} worden in dezelfde ploeg en specialiteit al gebruikt door {string.Join(", ", sameInitials.Select(p => $"{p.FirstName} {p.LastName}"))}. Kies andere initialen.",
                Duration = 7000
            });
            return; // rij blijft in bewerking
        }

        if (person == newPerson)
        {
            var createDto = new PersonCreateDTO
            {
                FirstName = person.FirstName,
                LastName = person.LastName,
                Email = person.Email,
                Team = person.Team,
                Speciality = person.Speciality,
                Grade = person.Grade,
                Role = person.Role,
                LeaveAllowance = person.LeaveAllowance,
                Initials = person.Initials,
            };
            var created = await PersonApi.CreatePersonAsync(createDto);
            if (!created.Ok || created.Value == null)
            {
                NotificationService.Notify(NotificationSeverity.Error, "Niet toegevoegd", created.Error);
                return; // rij blijft in bewerking
            }
            NotificationService.Notify(NotificationSeverity.Success, "Toegevoegd", "Persoon toegevoegd.");
            await grid.UpdateRow(person);
            await LoadPersons();
            await TemporaryPasswordDialog.ShowAsync(DialogService, $"{person.FirstName} {person.LastName}", created.Value.TemporaryPassword);
            return;
        }
        else
        {
            var updateDto = new PersonCreateDTO
            {
                FirstName = person.FirstName,
                LastName = person.LastName,
                Email = person.Email,
                Team = person.Team,
                Speciality = person.Speciality,
                Grade = person.Grade,
                Role = person.Role,
                LeaveAllowance = person.LeaveAllowance,
                Initials = person.Initials,
            };
            var ok = await PersonApi.UpdatePersonAsync(person.Id, updateDto);
            if (ok)
                NotificationService.Notify(NotificationSeverity.Success, "Aangepast", "Persoon aangepast.");
            else
                NotificationService.Notify(NotificationSeverity.Error, "Niet aangepast", "Aanpassen mislukt (geen toegang of e-mailadres al in gebruik).");
        }
        await grid.UpdateRow(person);
        await LoadPersons();
    }

    private void CancelEdit(PersonBaseDTO person)
    {
        grid.CancelEditRow(person);
        if (person == newPerson)
        {
            newPerson = null;
        }
    }

    private async Task DeletePerson(PersonBaseDTO person)
    {
        bool? confirmed = await DialogService.Confirm("Weet je zeker dat je deze persoon wilt verwijderen?", "Bevestigen");
        if (confirmed == true)
        {
            await PersonApi.DeletePersonAsync(person.Id);
            NotificationService.Notify(NotificationSeverity.Success, "Verwijderd", "Persoon succesvol verwijderd");
            await LoadPersons();
        }
    }

    // Nieuw tijdelijk wachtwoord (eenmalig getoond); de persoon kiest bij de volgende login een eigen wachtwoord
    private async Task ResetPasswordAsync(PersonBaseDTO person)
    {
        var confirmed = await DialogService.Confirm(
            $"Het wachtwoord van {person.FirstName} {person.LastName} vervangen door een tijdelijk wachtwoord? Het huidige wachtwoord werkt dan niet meer.",
            "Wachtwoord resetten",
            new ConfirmOptions { OkButtonText = "Resetten", CancelButtonText = "Annuleren" });
        if (confirmed != true)
            return;

        var result = await PersonApi.ResetPasswordAsync(person.Id);
        if (!result.Ok || result.Value == null)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Niet gereset", result.Error);
            return;
        }
        await LoadPersons();
        await TemporaryPasswordDialog.ShowAsync(DialogService, $"{person.FirstName} {person.LastName}", result.Value.TemporaryPassword);
    }
}