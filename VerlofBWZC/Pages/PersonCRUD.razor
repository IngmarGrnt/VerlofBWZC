@page "/person-crud"
@using Radzen
@using Radzen.Blazor
@using System.Net.Http.Json
@using VerlofBWZC.DataContracts
@using VerlofBWZC.DataContracts.DTO
@using VerlofBWZC.DataContracts.DTO.Access
@using VerlofBWZC.Services
@inject HttpClient Http
@inject PersonApiService PersonApi
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject CurrentPersonService CurrentPerson
@inject IJSRuntime JS

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Manager")]

<div class="pc-header">
    <h1>Personen</h1>
    @if (isAdmin)
    {
        <RadzenButton Icon="person_add" Text="Nieuwe persoon" ButtonStyle="ButtonStyle.Primary" Click="@AddPerson" />
    }
</div>
@if (!isAdmin)
{
    <p class="rz-text-secondary">Personen van de ploegen en specialiteiten die je beheert. Je kan naam, initialen, e-mail, rol (geen Admin) en verlofaantal aanpassen, en het wachtwoord resetten.</p>
}

@if (pending.Any())
{
    @* Zelf geregistreerde personen: pas na goedkeuring kunnen ze inloggen *@
    <div class="pc-pending">
        <div class="pc-pending-title"><i class="rzi">how_to_reg</i> Wacht op goedkeuring (@pending.Count)</div>
        @foreach (var p in pending)
        {
            var dup = SameInitials(p);
            <div class="pc-pending-row">
                <div class="pc-pending-who">
                    <span class="pc-pending-name">@p.FirstName @p.LastName</span>
                    <span class="pc-pending-meta">
                        @p.Email · @p.Team · @p.Speciality · @p.Grade
                        @if (p.RegisteredAtUtc is DateTime at)
                        {
                            <text> · aangevraagd @at.ToLocalTime().ToString("d MMM HH:mm", new System.Globalization.CultureInfo("nl-BE"))</text>
                        }
                    </span>
                    @if (dup.Any())
                    {
                        <span class="pc-pending-warn"><i class="rzi">warning</i> Initialen @PersonInitials.For(p) al gebruikt door @string.Join(", ", dup.Select(d => $"{d.FirstName} {d.LastName}")): pas ze na goedkeuring aan.</span>
                    }
                </div>
                <div class="pc-pending-actions">
                    <RadzenButton Text="Goedkeuren" Icon="check" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" Disabled="@busyPending" Click="@(() => ApproveAsync(p))" />
                    <RadzenButton Text="Weigeren" Icon="close" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Size="ButtonSize.Small" Disabled="@busyPending" Click="@(() => RejectAsync(p))" />
                </div>
            </div>
        }
    </div>
}

<!-- Zoeken en filteren -->
<div class="pc-filters">
    <div class="pc-search">
        <i class="rzi">search</i>
        <input type="search" class="pc-search-input" placeholder="Zoek op naam, e-mail of initialen" aria-label="Zoeken"
               value="@search" @oninput="e => search = e.Value?.ToString() ?? string.Empty" />
    </div>
    <RadzenDropDown TValue="string" Data="@TeamOptions" @bind-Value="filterTeam" AllowClear="true" Placeholder="Alle ploegen" class="pc-filter" />
    <RadzenDropDown TValue="string" Data="@SpecialityOptions" @bind-Value="filterSpeciality" AllowClear="true" Placeholder="Alle specialiteiten" class="pc-filter" />
    <RadzenDropDown TValue="string" Data="@RoleOptions" @bind-Value="filterRole" AllowClear="true" Placeholder="Alle rollen" class="pc-filter" />
    <span class="pc-count">@Filtered.Count van @persons.Count</span>
</div>

@if (loading)
{
    <p class="rz-text-secondary">Personen laden…</p>
}
else if (!Filtered.Any())
{
    <p class="rz-text-secondary">Geen personen gevonden.</p>
}
else
{
    <!-- Pc: tabel; klik op een rij om te openen -->
    <div class="pc-table-wrap">
        <table class="pc-table">
            <thead>
                <tr>
                    @foreach (var col in Columns)
                    {
                        <th>
                            <button type="button" class="pc-sort" @onclick="() => SortBy(col.Key)">
                                @col.Title
                                @if (sortKey == col.Key)
                                {
                                    <i class="rzi">@(sortDesc ? "arrow_downward" : "arrow_upward")</i>
                                }
                            </button>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Filtered)
                {
                    <tr class="pc-row" tabindex="0" @onclick="() => OpenAsync(p)" @onkeydown="e => OnRowKey(e, p)" title="Klik om te openen">
                        <td>
                            <span class="pc-name">@p.LastName @p.FirstName</span>
                            @if (p.MustChangePassword)
                            {
                                <span class="pc-temp-pw" title="Heeft een tijdelijk wachtwoord en moet bij de volgende login een eigen wachtwoord kiezen">tijdelijk wachtwoord</span>
                            }
                            <span class="pc-email">@p.Email</span>
                        </td>
                        <td>@InitialsCell(p)</td>
                        <td>@p.Team</td>
                        <td>@p.Speciality</td>
                        <td>@p.Grade</td>
                        <td>@RoleCell(p)</td>
                        <td class="pc-num">@(p.LeaveAllowance?.ToString() ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Gsm: kaartjes; tik om te openen -->
    <div class="pc-cards">
        @foreach (var p in Filtered)
        {
            <button type="button" class="pc-card" @onclick="() => OpenAsync(p)">
                <span class="pc-card-top">
                    <span class="pc-name">@p.LastName @p.FirstName</span>
                    @InitialsCell(p)
                </span>
                <span class="pc-card-meta">@p.Team · @p.Speciality · @p.Grade</span>
                <span class="pc-card-meta">
                    @RoleCell(p) · verlof @(p.LeaveAllowance?.ToString() ?? "-")
                    @if (p.MustChangePassword)
                    {
                        <span class="pc-temp-pw">tijdelijk wachtwoord</span>
                    }
                </span>
            </button>
        }
    </div>
}

@code {
    private List<PersonBaseDTO> persons = new();
    private bool loading = true;

    private List<string> TeamOptions = new();
    private List<string> SpecialityOptions = new();
    private List<string> GradeOptions = new();
    private List<string> RoleOptions = new();

    private string search = string.Empty;
    private string? filterTeam;
    private string? filterSpeciality;
    private string? filterRole;

    // Admin: alles; Manager: zijn ploegen, rol nooit Admin (de API controleert dit ook)
    private bool isAdmin;

    protected override async Task OnInitializedAsync()
    {
        isAdmin = CurrentPersonService.IsAdmin(await CurrentPerson.GetAsync());
        await LoadMetaAsync();
        await LoadPersons();
    }

    private async Task LoadMetaAsync()
    {
        TeamOptions = await Http.GetFromJsonAsync<List<string>>("api/meta/teams") ?? new();
        SpecialityOptions = await Http.GetFromJsonAsync<List<string>>("api/meta/specialities") ?? new();
        GradeOptions = await Http.GetFromJsonAsync<List<string>>("api/meta/grades") ?? new();
        RoleOptions = await Http.GetFromJsonAsync<List<string>>("api/meta/roles") ?? new();
    }

    private async Task LoadPersons()
    {
        persons = await PersonApi.GetAllPersonsAsync() ?? new();
        pending = await PersonApi.GetPendingAsync();
        if (isAdmin)
        {
            try
            {
                managerScopes = await Http.GetFromJsonAsync<List<ManagerScopesDTO>>("api/manager-scopes") ?? new();
            }
            catch
            {
                managerScopes = new();
            }
        }
        loading = false;
        StateHasChanged();
    }

    // --- Zoeken, filteren en sorteren ---
    private record Column(string Key, string Title);
    private static readonly Column[] Columns =
    {
        new("name", "Naam"), new("initials", "Initialen"), new("team", "Ploeg"), new("speciality", "Specialiteit"),
        new("grade", "Graad"), new("role", "Rol"), new("leave", "Verlof/jaar")
    };
    private string sortKey = "name";
    private bool sortDesc;

    private void SortBy(string key)
    {
        sortDesc = sortKey == key && !sortDesc;
        sortKey = key;
    }

    private List<PersonBaseDTO> Filtered
    {
        get
        {
            var q = persons.AsEnumerable();
            var s = search.Trim();
            if (s.Length > 0)
                q = q.Where(p => Contains($"{p.FirstName} {p.LastName}", s) || Contains($"{p.LastName} {p.FirstName}", s)
                    || Contains(p.Email, s) || Contains(PersonInitials.For(p), s));
            if (!string.IsNullOrEmpty(filterTeam)) q = q.Where(p => p.Team == filterTeam);
            if (!string.IsNullOrEmpty(filterSpeciality)) q = q.Where(p => p.Speciality == filterSpeciality);
            if (!string.IsNullOrEmpty(filterRole)) q = q.Where(p => p.Role == filterRole);

            Func<PersonBaseDTO, object?> key = sortKey switch
            {
                "initials" => p => PersonInitials.For(p),
                "team" => p => TeamOptions.IndexOf(p.Team ?? ""),
                "speciality" => p => p.Speciality,
                "grade" => p => GradeOptions.IndexOf(p.Grade ?? ""),
                "role" => p => p.Role,
                "leave" => p => p.LeaveAllowance ?? -1,
                _ => p => $"{p.LastName} {p.FirstName}"
            };
            var sorted = sortDesc ? q.OrderByDescending(key) : q.OrderBy(key);
            return sorted.ThenBy(p => p.LastName).ThenBy(p => p.FirstName).ToList();
        }
    }

    private static bool Contains(string? text, string part) =>
        text?.Contains(part, StringComparison.OrdinalIgnoreCase) == true;

    // --- Cellen ---
    private RenderFragment InitialsCell(PersonBaseDTO p) => __builder =>
    {
        var dup = SameInitials(p);
        if (dup.Any())
        {
            <span class="pc-initials-dup" title="@($"Ook gebruikt door {string.Join(", ", dup.Select(d => $"{d.FirstName} {d.LastName}"))} in dezelfde ploeg en specialiteit")">
                @PersonInitials.For(p) <i class="rzi">warning</i>
            </span>
        }
        else
        {
            <span class="pc-initials">@PersonInitials.For(p)</span>
        }
    };

    private RenderFragment RoleCell(PersonBaseDTO p) => __builder =>
    {
        <span class="@($"pc-role pc-role-{p.Role?.ToLowerInvariant()}")">@p.Role</span>
        if (isAdmin && p.Role == "Manager" && ScopesOf(p.Id).Count > 0)
        {
            <span class="pc-scopes" title="@($"Beheert: {ScopesTooltip(p)}")">+@ScopesOf(p.Id).Count</span>
        }
    };

    // Andere personen in dezelfde ploeg en specialiteit met dezelfde initialen
    private List<PersonBaseDTO> SameInitials(PersonBaseDTO person) => persons
        .Where(p => p != person && p.Id != person.Id && p.Team == person.Team && p.Speciality == person.Speciality)
        .Where(p => string.Equals(PersonInitials.For(p), PersonInitials.For(person), StringComparison.OrdinalIgnoreCase))
        .ToList();

    // --- Registraties die wachten op goedkeuring ---
    private List<PersonBaseDTO> pending = new();
    private bool busyPending;

    private async Task ApproveAsync(PersonBaseDTO p)
    {
        busyPending = true;
        var result = await PersonApi.ApproveAsync(p.Id);
        busyPending = false;
        if (!result.Ok)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Niet goedgekeurd", result.Error);
            return;
        }
        NotificationService.Notify(NotificationSeverity.Success, "Goedgekeurd", $"{p.FirstName} {p.LastName} kan nu inloggen.");
        await LoadPersons();
    }

    private async Task RejectAsync(PersonBaseDTO p)
    {
        var confirmed = await DialogService.Confirm(
            $"De registratie van {p.FirstName} {p.LastName} ({p.Email}) weigeren? De aanvraag wordt verwijderd.",
            "Registratie weigeren",
            new ConfirmOptions { OkButtonText = "Weigeren", CancelButtonText = "Annuleren" });
        if (confirmed != true)
            return;

        busyPending = true;
        var result = await PersonApi.RejectAsync(p.Id);
        busyPending = false;
        if (!result.Ok)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Niet geweigerd", result.Error);
            return;
        }
        NotificationService.Notify(NotificationSeverity.Info, "Geweigerd", $"De registratie van {p.FirstName} {p.LastName} is verwijderd.");
        await LoadPersons();
    }

    // Extra ploegen/specialiteiten per manager (bovenop de eigen)
    private List<ManagerScopesDTO> managerScopes = new();

    private List<ScopeItemDTO> ScopesOf(int personId) =>
        managerScopes.FirstOrDefault(m => m.PersonId == personId)?.Scopes ?? new();

    // Bv. "Ploeg1 · IGS (eigen), Ploeg2 · IGS, Ploeg3 · alle specialiteiten"
    private string ScopesTooltip(PersonBaseDTO person) =>
        string.Join(", ", new[] { $"{ManagerScopesDialog.ChipText(person.Team, person.Speciality)} (eigen)" }
            .Concat(ScopesOf(person.Id).Select(s => ManagerScopesDialog.ChipText(s.Team, s.Speciality))));

    // --- Formulier (zijpaneel; op gsm volledig scherm) ---
    private Task AddPerson() => OpenAsync(new PersonBaseDTO
    {
        Team = TeamOptions.FirstOrDefault() ?? "",
        Speciality = SpecialityOptions.FirstOrDefault() ?? "",
        LeaveAllowance = PersonDefaults.LeaveAllowance,
        Grade = GradeOptions.FirstOrDefault() ?? "",
        Role = RoleOptions.FirstOrDefault(r => r == "User") ?? RoleOptions.FirstOrDefault() ?? ""
    });

    private async Task OnRowKey(KeyboardEventArgs e, PersonBaseDTO p)
    {
        if (e.Key is "Enter" or " ")
            await OpenAsync(p);
    }

    private async Task OpenAsync(PersonBaseDTO person)
    {
        bool mobile;
        try { mobile = await JS.InvokeAsync<bool>("bwzcIsMobile"); }
        catch { mobile = false; }

        var result = await DialogService.OpenSideAsync<PersonForm>(
            person.Id == 0 ? "Nieuwe persoon" : $"{person.FirstName} {person.LastName}",
            new Dictionary<string, object?>
            {
                { nameof(PersonForm.Original), person },
                { nameof(PersonForm.IsAdmin), isAdmin },
                { nameof(PersonForm.AllPersons), persons },
                { nameof(PersonForm.Teams), TeamOptions },
                { nameof(PersonForm.Specialities), SpecialityOptions },
                { nameof(PersonForm.Grades), GradeOptions },
                { nameof(PersonForm.Roles), RoleOptions },
                { nameof(PersonForm.Scopes), ScopesOf(person.Id) }
            },
            new SideDialogOptions
            {
                Position = DialogPosition.Right,
                Width = mobile ? "100%" : "520px",
                CloseDialogOnOverlayClick = true,
                ShowMask = true
            });

        if (result is PersonForm.Result r && r.Changed)
        {
            await LoadPersons();
            if (!string.IsNullOrEmpty(r.TemporaryPassword))
                await TemporaryPasswordDialog.ShowAsync(DialogService, r.PasswordFor ?? "", r.TemporaryPassword);
        }
    }
}
