@page "/person-crud"
@using Radzen
@using Radzen.Blazor
@using System.Text.Json
@using System.Linq.Expressions
@using System.Net.Http.Json
@using VerlofBWZC.DataContracts.DTO
@using VerlofBWZC.Services
@inject HttpClient Http
@inject PersonApiService PersonApi
@inject NotificationService NotificationService
@inject DialogService DialogService

<h1>Personenbeheer</h1>

<RadzenButton Icon="add_circle" Text="Nieuwe persoon" Style="margin-bottom: 10px" Click="@AddPerson" />

<div class="responsive-datagrid-container">
    <RadzenDataGrid TItem="PersonBaseDTO" Data="@persons" @ref="grid"
                    AllowFiltering="true" AllowPaging="true" AllowSorting="true" PageSize="10"
                    EditMode="DataGridEditMode.Single"
                    AllowColumnResize="true"
                    class="responsive-datagrid">
        <Columns>
            <RadzenDataGridColumn TItem="PersonBaseDTO" Property="FirstName" Title="Voornaam">
                <EditTemplate Context="person">
                    <RadzenTextBox @bind-Value="person.FirstName" Style="width:100%" Name="FirstName" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="PersonBaseDTO" Property="LastName" Title="Achternaam">
                <EditTemplate Context="person">
                    <RadzenTextBox @bind-Value="person.LastName" Style="width:100%" Name="LastName" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="PersonBaseDTO" Property="Email" Title="Email">
                <EditTemplate Context="person">
                    <RadzenTextBox @bind-Value="person.Email" Style="width:100%" Name="Email" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="PersonBaseDTO" Property="Team" Title="Team">
                <Template Context="person">@person.Team</Template>
                <EditTemplate Context="person">
                    <RadzenDropDown Data="@TeamOptions"
                                    @bind-Value="person.Team"
                                    AllowFiltering="true"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="PersonBaseDTO" Property="Speciality" Title="Specialiteit">
                <Template Context="person">@person.Speciality</Template>
                <EditTemplate Context="person">
                    <RadzenDropDown Data="@SpecialityOptions"
                                    @bind-Value="person.Speciality"
                                    AllowFiltering="true"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="PersonBaseDTO" Property="Grade" Title="Graad">
                <Template Context="person">@person.Grade</Template>
                <EditTemplate Context="person">
                    <RadzenDropDown Data="@GradeOptions"
                                    @bind-Value="person.Grade"
                                    AllowFiltering="true"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="PersonBaseDTO" Property="Role" Title="Rol">
                <Template Context="person">@person.Role</Template>
                <EditTemplate Context="person">
                    <RadzenDropDown Data="@RoleOptions"
                                    @bind-Value="person.Role"
                                    AllowFiltering="true"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="PersonBaseDTO" Context="person">
                <Template Context="person">
                    <RadzenButton Icon="edit" Click="@(() => EditRow(person))" Style="margin-right: 5px" />
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Click="@(() => DeletePerson(person))" Style="margin-right: 5px" />
                    <RadzenButton Icon="lock" ButtonStyle="ButtonStyle.Info" Click="@(() => OpenPasswordDialog(person))" />
                </Template>
                <EditTemplate Context="person">
                    <RadzenButton Icon="save" ButtonStyle="ButtonStyle.Primary" Click="@(() => SaveRow(person))" Style="margin-right: 5px" />
                    <RadzenButton Icon="cancel" ButtonStyle="ButtonStyle.Light" Click="@(() => CancelEdit(person))" />
                </EditTemplate>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>


@code {
    private List<PersonBaseDTO> persons = new();
    private PersonBaseDTO newPerson = new();
    private RadzenDataGrid<PersonBaseDTO> grid;

    // Opties vanuit MetaController
    private List<string> TeamOptions = new();
    private List<string> SpecialityOptions = new();
    private List<string> GradeOptions = new();
    private List<string> RoleOptions = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadMetaAsync();
        await LoadPersons();
    }

    private async Task LoadMetaAsync()
    {
        TeamOptions = await Http.GetFromJsonAsync<List<string>>("api/meta/teams") ?? new();
        SpecialityOptions = await Http.GetFromJsonAsync<List<string>>("api/meta/specialities") ?? new();
        GradeOptions = await Http.GetFromJsonAsync<List<string>>("api/meta/grades") ?? new();
        RoleOptions = await Http.GetFromJsonAsync<List<string>>("api/meta/roles") ?? new();
    }

    private async Task LoadPersons()
    {
        persons = await PersonApi.GetAllPersonsAsync();
        StateHasChanged();
    }

    private async Task AddPerson()
    {
        newPerson = new PersonBaseDTO
        {
            Team = TeamOptions.FirstOrDefault() ?? "",
            Speciality = SpecialityOptions.FirstOrDefault() ?? "",
            Grade = GradeOptions.FirstOrDefault() ?? "",
            Role = RoleOptions.FirstOrDefault() ?? ""
        };
        await grid.InsertRow(newPerson);
    }

    private async Task EditRow(PersonBaseDTO person)
    {
        await grid.EditRow(person);
    }

    private async Task SaveRow(PersonBaseDTO person)
    {
        if (person == newPerson)
        {
            var createDto = new PersonCreateDTO
            {
                FirstName = person.FirstName,
                LastName = person.LastName,
                Email = person.Email,
                Team = person.Team,
                Speciality = person.Speciality,
                Grade = person.Grade,
                Role = person.Role,
                Password = "Root1234",
            };
            Console.WriteLine(JsonSerializer.Serialize(createDto));
            await PersonApi.CreatePersonAsync(createDto);
            NotificationService.Notify(NotificationSeverity.Success, "Toegevoegd", "Persoon succesvol toegevoegd");
        }
        else
        {
            var updateDto = new PersonCreateDTO
            {
                FirstName = person.FirstName,
                LastName = person.LastName,
                Email = person.Email,
                Team = person.Team,
                Speciality = person.Speciality,
                Grade = person.Grade,
                Role = person.Role,
            };
            await PersonApi.UpdatePersonAsync(person.Id, updateDto);
            NotificationService.Notify(NotificationSeverity.Success, "Aangepast", "Persoon succesvol aangepast");
        }
        await grid.UpdateRow(person);
        await LoadPersons();
    }

    private void CancelEdit(PersonBaseDTO person)
    {
        grid.CancelEditRow(person);
        if (person == newPerson)
        {
            newPerson = null;
        }
    }

    private async Task DeletePerson(PersonBaseDTO person)
    {
        bool? confirmed = await DialogService.Confirm("Weet je zeker dat je deze persoon wilt verwijderen?", "Bevestigen");
        if (confirmed == true)
        {
            await PersonApi.DeletePersonAsync(person.Id);
            NotificationService.Notify(NotificationSeverity.Success, "Verwijderd", "Persoon succesvol verwijderd");
            await LoadPersons();
        }
    }

    private async Task OpenPasswordDialog(PersonBaseDTO person)
    {
        await DialogService.OpenAsync<ChangePasswordDialog>(
            "Wachtwoord wijzigen",
            new Dictionary<string, object>
            {
                { "Person", person },
                { "OnPasswordChanged", EventCallback.Factory.Create<string>(this, async (newPassword) => await ChangePassword(person, newPassword)) }
            }
            
        );
    }

    private async Task ChangePassword(PersonBaseDTO person, string newPassword)
    {
        var updateDto = new PersonCreateDTO
        {
            FirstName = person.FirstName,
            LastName = person.LastName,
            Email = person.Email,
            Team = person.Team,
            Speciality = person.Speciality,
            Grade = person.Grade,
            Role = person.Role,
            Password = newPassword
        };
        var result = await PersonApi.UpdatePersonAsync(person.Id, updateDto);
        if (result)
        {
            NotificationService.Notify(NotificationSeverity.Success, "Wachtwoord gewijzigd", "Het wachtwoord is succesvol aangepast.");
        }
        else
        {
            NotificationService.Notify(NotificationSeverity.Error, "Fout", "Wachtwoord wijzigen is mislukt.");
        }
        await LoadPersons();
    }
}
