@using Radzen
@using Radzen.Blazor
@inject DialogService DialogService
@inject IJSRuntime JS

@* Tijdelijk wachtwoord: wordt maar één keer getoond; de persoon moet het bij de eerste login wijzigen *@

<div class="tp">
    <p class="uc-text">
        Tijdelijk wachtwoord voor <strong>@PersonName</strong>. Geef het persoonlijk door.
        Bij de eerste login moet @PersonName een eigen wachtwoord kiezen.
    </p>
    <div class="tp-box">
        <code class="tp-code">@Password</code>
        <RadzenButton Icon="@(copied ? "check" : "content_copy")" Text="@(copied ? "Gekopieerd" : "Kopiëren")" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="CopyAsync" />
    </div>
    <p class="tl-hint">Dit wachtwoord wordt nergens bewaard en is later niet meer op te vragen. Kwijt? Reset het wachtwoord opnieuw.</p>
    <div class="uc-actions">
        <RadzenButton Text="Sluiten" ButtonStyle="ButtonStyle.Primary" Click="@(() => DialogService.Close())" />
    </div>
</div>

@code {
    [Parameter] public string PersonName { get; set; } = "";
    [Parameter] public string Password { get; set; } = "";

    private bool copied;

    private async Task CopyAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Password);
            copied = true;
        }
        catch
        {
            copied = false;
        }
    }

    public static Task ShowAsync(DialogService dialogs, string personName, string password) =>
        dialogs.OpenAsync<TemporaryPasswordDialog>(
            "Tijdelijk wachtwoord",
            new Dictionary<string, object> { { nameof(PersonName), personName }, { nameof(Password), password } },
            new DialogOptions { Width = "460px", CloseDialogOnEsc = false, CloseDialogOnOverlayClick = false });
}
