@using Radzen
@using Radzen.Blazor
@using VerlofBWZC.DataContracts.DTO
@inject DialogService DialogService
@inject NotificationService NotificationService


<div style="padding: 1rem;">
    <RadzenTextBox @bind-Value="NewPassword" Type="password" Style="width:100%;margin-bottom:10px;" Placeholder="Nieuw wachtwoord" />
    <RadzenButton Text="Opslaan" ButtonStyle="ButtonStyle.Primary" Click="@OnSave" Style="margin-right: 5px;" />
    <RadzenButton Text="Annuleren" ButtonStyle="ButtonStyle.Light" Click="@OnCancel" />
</div>

@code {
    [Parameter] public PersonBaseDTO Person { get; set; }
    [Parameter] public EventCallback<string> OnPasswordChanged { get; set; }

    public string NewPassword { get; set; } = "";

    private async Task OnSave()
    {
        if (!string.IsNullOrWhiteSpace(NewPassword))
        {
            await OnPasswordChanged.InvokeAsync(NewPassword);
            DialogService.Close();
        }
        else
        {
            NotificationService.Notify(NotificationSeverity.Error, "Fout", "Wachtwoord mag niet leeg zijn.");
        }
    }

    private void OnCancel()
    {
        DialogService.Close();
    }
}
