@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using Radzen
@using Radzen.Blazor
@using VerlofBWZC.DataContracts.DTO
@inject DialogService DialogService
@inject NotificationService NotificationService

<EditForm EditContext="@editContext">
    <DataAnnotationsValidator />

    <div style="padding: 1rem;">
        <RadzenTextBox @bind-Value="model.NewPassword"
                       Type="password"
                       Style="width:100%;margin-bottom:10px;"
                       Placeholder="Nieuw wachtwoord" />
        <ValidationMessage For="() => model.NewPassword" />

        <RadzenTextBox @bind-Value="model.ConfirmPassword"
                       Type="password"
                       Style="width:100%;margin-bottom:10px;"
                       Placeholder="Bevestig wachtwoord" />
        <ValidationMessage For="() => model.ConfirmPassword" />

        <RadzenButton Text="Opslaan"
                      ButtonStyle="ButtonStyle.Primary"
                      Click="@OnSave"
                      Style="margin-right: 5px;" />
        <RadzenButton Text="Annuleren"
                      ButtonStyle="ButtonStyle.Light"
                      Click="@OnCancel" />
    </div>
</EditForm>

@code {
    [Parameter] public PersonBaseDTO Person { get; set; }
    [Parameter] public EventCallback<string> OnPasswordChanged { get; set; }

    private ChangePasswordModel model = new();
    private EditContext editContext = default!;

    protected override void OnInitialized()
    {
        editContext = new EditContext(model);
    }

    private async Task OnSave()
    {
        // Valideer via data-annotaties; sluit alleen bij geldige invoer
        if (!editContext.Validate())
            return;

        try
        {
            await OnPasswordChanged.InvokeAsync(model.NewPassword);
            DialogService.Close(true);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Fout", ex.Message);
        }
    }

    private void OnCancel() => DialogService.Close();

    private class ChangePasswordModel
    {
        [Required(ErrorMessage = "Nieuw wachtwoord is vereist.")]
        [MinLength(6, ErrorMessage = "Minimaal 6 tekens.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Bevestiging is vereist.")]
        [Compare(nameof(NewPassword), ErrorMessage = "Wachtwoorden komen niet overeen.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}