@using System.ComponentModel.DataAnnotations
@using Radzen
@using Radzen.Blazor
@using VerlofBWZC.DataContracts.DTO
@inject DialogService DialogService
@inject NotificationService Notifications

<RadzenTemplateForm TItem="ChangePasswordModel"
                    Data="@model"
                    Submit="@OnSubmit"
                    InvalidSubmit="@OnInvalid"
                    Style="width:100%;">
    <ChildContent>
        <div class="pwd-dialog">
            <RadzenValidationSummary />

            <div class="mb-3">
                <label class="form-label">Nieuw wachtwoord</label>
                <RadzenPassword @bind-Value="model.NewPassword"
                                Name="new-password"
                                Placeholder="Minimaal 8 tekens"
                                Style="width:100%; font-size:1rem;"
                                Autocomplete="new-password" />
                <ValidationMessage For="() => model.NewPassword" />
            </div>

            <div class="mb-3">
                <label class="form-label">Bevestig wachtwoord</label>
                <RadzenPassword @bind-Value="model.ConfirmPassword"
                                Name="confirm-password"
                                Placeholder="Herhaal nieuw wachtwoord"
                                Style="width:100%; font-size:1rem;"
                                Autocomplete="new-password" />
                <ValidationMessage For="() => model.ConfirmPassword" />
            </div>

            <RadzenAlert Severity="AlertSeverity.Info"
                         Style="margin-bottom:.5rem"
                         Visible="@showInfo">
                Min. 8 tekens. Beide velden moeten gelijk zijn.
            </RadzenAlert>

            <div class="pw-actions">
                <RadzenButton Icon="save"
                              Text="Opslaan"
                              ButtonStyle="ButtonStyle.Primary"
                              Size="ButtonSize.Medium"
                              Submit="true"
                              Disabled="@busy" />
                <RadzenButton Icon="cancel"
                              Text="Annuleren"
                              ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Medium"
                              Click="@(args => DialogService.Close())"
                              Disabled="@busy" />
            </div>
        </div>
    </ChildContent>
</RadzenTemplateForm>
    
@code {
    [Parameter] public PersonBaseDTO Person { get; set; } = default!;
    [Parameter] public EventCallback<string> OnPasswordChanged { get; set; }

    private bool busy;
    private bool showInfo = true;

    private ChangePasswordModel model = new();

    private async Task OnSubmit(ChangePasswordModel _)
    {
        if (busy) return;
        busy = true;

        await OnPasswordChanged.InvokeAsync(model.NewPassword);
        busy = false;
        DialogService.Close();
    }

    private void OnInvalid(FormInvalidSubmitEventArgs _)
    {
        Notifications.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Warning,
            Summary = "Validatie",
            Detail = "Controleer de invoer. Wachtwoorden moeten minimaal 8 tekens zijn en gelijk aan elkaar."
        });
    }

    public class ChangePasswordModel
    {
        [Required(ErrorMessage = "Nieuw wachtwoord is vereist.")]
        [MinLength(8, ErrorMessage = "Minimaal 8 tekens.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Bevestiging is vereist.")]
        [Compare(nameof(NewPassword), ErrorMessage = "Wachtwoorden komen niet overeen.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
