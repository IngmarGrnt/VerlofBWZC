@page "/"
@using VerlofBWZC.DataContracts.DTO
@using VerlofBWZC.Handler
@using VerlofBWZC.Services
@inject IJSRuntime JS
@inject PersonApiService PersonApi

<PageTitle>Home</PageTitle>

<h1 class="mb-4">Persoonsgegevens</h1>

@if (person != null)
{
    <div class="card shadow-sm" style="max-width: 400px;">
        <div class="card-body">
            <div class="d-flex align-items-center mb-3">
                <div class="rounded-circle bg-primary text-white d-flex justify-content-center align-items-center" style="width:64px; height:64px; font-size:2rem;">
                    @person.FirstName.Substring(0,1)@person.LastName.Substring(0,1)
                </div>
                <div class="ms-3">
                    <h4 class="card-title mb-0">@person.FirstName @person.LastName</h4>
                    <small class="text-muted">@person.Role</small>
                </div>
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item"><b>Team:</b> @person.Team</li>
                <li class="list-group-item"><b>Specialiteit:</b> @person.Speciality</li>
                <li class="list-group-item"><b>Graad:</b> @person.Grade</li>
            </ul>
        </div>
    </div>
}
else
{
    <p>Loading...</p>
}

@code {
    private PersonBaseDTO? person;

    protected override async Task OnInitializedAsync()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        var userId = JwtUtils.GetUserIdFromToken(token);
        if (int.TryParse(userId, out var id))
        {
            person = await PersonApi.GetPersonByIdAsync(id);
        }
    }

   
}

