@page "/Quarterlyleave"
@using Radzen
@using Radzen.Blazor    
@using System.Text
@using VerlofBWZC.DataContracts
@using VerlofBWZC.DataContracts.DTO
@using VerlofBWZC.Handler
@using VerlofBWZC.Services
@inject HttpClient Http
@inject IJSRuntime JS
@inject PersonApiService PersonApi
@inject NotificationService NotificationService
@inject ScopeService Scope

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<!-- Kop: titel, jaar, ploeg/specialiteit -->
<div class="wc-header">
    <div class="wc-title">
        <h1>Kwartaalverlof</h1>
        <div class="wc-year" role="group" aria-label="Jaar kiezen">
            <button type="button" class="wc-year-btn" aria-label="Vorig jaar" disabled="@(SelectedYear <= Years.Min())" @onclick="() => ChangeYear(-1)">
                <i class="rzi">chevron_left</i>
            </button>
            <span class="wc-year-label">@SelectedYear</span>
            <button type="button" class="wc-year-btn" aria-label="Volgend jaar" disabled="@(SelectedYear >= Years.Max())" @onclick="() => ChangeYear(1)">
                <i class="rzi">chevron_right</i>
            </button>
        </div>
    </div>
    @if (Scope.HasChoice)
    {
        @* Admin: elke ploeg en specialiteit; Manager: wat hij beheert; anderen hun eigen ploeg *@
        <div class="ql-scope">
            <RadzenDropDown TValue="string" @bind-Value="SelectedTeam" Data="@TeamOptions" Placeholder="Ploeg" class="ql-filter"
                            Change="@(async _ => { SelectedSpeciality = Scope.FixSpeciality(SelectedTeam, SelectedSpeciality); SpecialityOptions = Scope.SpecialitiesFor(SelectedTeam); await LoadQuarterlyData(); })" />
            <RadzenDropDown TValue="string" @bind-Value="SelectedSpeciality" Data="@SpecialityOptions" Placeholder="Specialiteit" class="ql-filter"
                            Change="@(async _ => await LoadQuarterlyData())" />
        </div>
    }
    else
    {
        <span class="tc-scope">@SelectedTeam · @SelectedSpeciality</span>
    }
</div>

<!-- Samenvatting: hoeveel shiften hebben 1, 2, ... personen in verlof -->
<div class="ql-summary">
    <div class="ql-summary-title">Shiften met … personen in verlof <span class="ql-total">· totaal @ShiftsCount verlofshiften</span></div>
    <div class="ql-buckets">
        @foreach (var (n, count) in Buckets)
        {
            <span class="@(count > 0 ? "ql-bucket" : "ql-bucket ql-bucket-zero")" title="@($"{count} shift(en) met {n} {(n == "1" ? "persoon" : "personen")} in verlof")">
                <span class="ql-bucket-n">@n</span>
                <span class="ql-bucket-count">@count</span>
            </span>
        }
    </div>
</div>

@if (PersonQuarterCounts == null)
{
    <p class="wc-loading">Kwartaalverlof laden…</p>
}
else if (!PersonQuarterCounts.Any())
{
    <p class="wc-loading">Geen personen in deze ploeg en specialiteit.</p>
}
else
{
    <!-- Per persoon: KW1 jan-apr, KW2 mei-aug, KW3 sep-dec -->
    <div class="ql-list">
        <div class="ql-row ql-head" aria-hidden="true">
            <span class="ql-name">Naam</span>
            <span class="ql-q">KW1<small>jan–apr</small></span>
            <span class="ql-q">KW2<small>mei–aug</small></span>
            <span class="ql-q">KW3<small>sep–dec</small></span>
            <span class="ql-q">Totaal</span>
        </div>
        @foreach (var p in PersonQuarterCounts)
        {
            var person = TeamMembers.FirstOrDefault(m => m.Id == p.PersonId);
            <div class="ql-row">
                <span class="ql-name">
                    <span class="ql-initials">@GetInitials(person)</span>
                    <span class="ql-fullname">@p.Name</span>
                </span>
                <span class="ql-q" data-label="KW1">@p.Q1</span>
                <span class="ql-q" data-label="KW2">@p.Q2</span>
                <span class="ql-q" data-label="KW3">@p.Q3</span>
                <span class="ql-q ql-q-total" data-label="Totaal">@(p.Q1 + p.Q2 + p.Q3)</span>
            </div>
        }
    </div>
}

@code {
    private int SelectedYear { get; set; } = DateTime.Now.Year + 1;
    private List<int> Years { get; set; } = Enumerable.Range(DateTime.Now.Year - 1, 5).ToList();

    private List<PersonBaseDTO> TeamMembers = new();
    private List<TeamDayOffDTO> TeamDaysOff = new();

    private List<PersonQuarterCountsDto>? PersonQuarterCounts;

    // Totaal aantal verlofshiften
    private int ShiftsCount { get; set; }
    private bool isAdmin;
    private string? SelectedTeam;
    private string? SelectedSpeciality;
    private List<string> TeamOptions = new();
    private List<string> SpecialityOptions = new();

    protected override async Task OnInitializedAsync()
    {
        // Standaard de eigen ploeg en specialiteit (in demo modus de gekozen waarden)
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        var userId = JwtUtils.GetUserIdFromToken(token);
        var person = await PersonApi.GetPersonByIdAsync(int.Parse(userId));
        SelectedTeam = person?.Team;
        SelectedSpeciality = person?.Speciality;
        isAdmin = string.Equals(person?.Role, "Admin", StringComparison.OrdinalIgnoreCase);

        // Admin: alle ploegen; Manager: de ploegen en specialiteiten die hij beheert
        await Scope.LoadAsync(refresh: true);
        if (Scope.HasChoice)
        {
            TeamOptions = Scope.Teams;
            if (!TeamOptions.Contains(SelectedTeam ?? "")) SelectedTeam = TeamOptions.FirstOrDefault();
            SelectedSpeciality = Scope.FixSpeciality(SelectedTeam, SelectedSpeciality);
            SpecialityOptions = Scope.SpecialitiesFor(SelectedTeam);
        }

        await LoadQuarterlyData();
    }
        
    private async Task ChangeYear(int delta)
    {
        var year = SelectedYear + delta;
        if (year < Years.Min() || year > Years.Max()) return;
        SelectedYear = year;
        await LoadQuarterlyData();
    }

    // Aantal shiften met 1, 2, ... 8 personen in verlof (en meer dan 8 bij de laatste, als dat voorkomt)
    private List<int> shiftCounts = new();
    private IEnumerable<(string N, int Count)> Buckets
    {
        get
        {
            for (var n = 1; n <= 8; n++)
                yield return (n.ToString(), shiftCounts.Count(c => c == n));
            var more = shiftCounts.Count(c => c > 8);
            if (more > 0)
                yield return ("9+", more);
        }
    }

    private async Task LoadQuarterlyData()
    {
        PersonQuarterCounts = null;

        var teamName = SelectedTeam;
        var speciality = SelectedSpeciality;

        TeamMembers = await Http.GetFromJsonAsync<List<PersonBaseDTO>>($"api/person/team/{teamName}/{speciality}") ?? new List<PersonBaseDTO>();

        TeamDaysOff = await Http.GetFromJsonAsync<List<TeamDayOffDTO>>($"api/person/team-days-off/{teamName}/{SelectedYear}/{speciality}") ?? new List<TeamDayOffDTO>();

        // Per persoon de aantallen per kwartaal (KW1 = jan-apr, KW2 = mei-aug, KW3 = sep-dec)
        PersonQuarterCounts = TeamMembers
            .Select(m => new PersonQuarterCountsDto
            {
                PersonId = m.Id,
                Name = string.IsNullOrWhiteSpace(m.FirstName) ? m.LastName : $"{m.FirstName} {m.LastName}",
                Q1 = TeamDaysOff.Count(d => d.PersonId == m.Id && d.Date.Year == SelectedYear && d.Date.Month >= 1 && d.Date.Month <= 4),
                Q2 = TeamDaysOff.Count(d => d.PersonId == m.Id && d.Date.Year == SelectedYear && d.Date.Month >= 5 && d.Date.Month <= 8),
                Q3 = TeamDaysOff.Count(d => d.PersonId == m.Id && d.Date.Year == SelectedYear && d.Date.Month >= 9 && d.Date.Month <= 12)
            })
            .OrderByDescending(p => p.Q1 + p.Q2 + p.Q3)
            .ToList();

        // Per shift (datum + shift) het aantal personen in verlof
        shiftCounts = TeamDaysOff
            .Where(d => d.Date.Year == SelectedYear)
            .GroupBy(d => new { Date = d.Date.Date, d.Shift })
            .Select(g => g.Select(x => x.PersonId).Distinct().Count())
            .ToList();
        ShiftsCount = shiftCounts.Sum();

        StateHasChanged();
    }

    // Initialen: opgeslagen per persoon, anders de standaardregel op de achternaam
    private static string GetInitials(PersonBaseDTO? person) => PersonInitials.For(person);

    public class TeamDayOffDTO
    {
        public int PersonId { get; set; }
        public DateTime Date { get; set; }
        public string Shift { get; set; }
    }

    public class PersonQuarterCountsDto
    {
        public int PersonId { get; set; }
        public string Name { get; set; } = string.Empty;
        public int Q1 { get; set; }
        public int Q2 { get; set; }
        public int Q3 { get; set; }
    }
}
