@page "/verlofregels"
@attribute [Authorize(Roles = "Admin,Manager")]
@using Microsoft.AspNetCore.Authorization
@using Radzen
@using Radzen.Blazor
@using System.Net.Http.Json
@using VerlofBWZC.DataContracts.DTO.Leave
@inject HttpClient Http
@inject ScopeService Scope
@inject NotificationService Notifications
@inject DialogService DialogService
@inject VerlofBWZC.Services.CurrentPersonService CurrentPerson
@using VerlofBWZC.Services

<PageTitle>Verlofcategorieën</PageTitle>

<h3>Verlofcategorieën</h3>
<p class="rz-text-secondary" style="max-width:900px;">
    Per ploeg en specialiteit stel je verlofcategorieën in, bv. <em>Groot verlof</em> (max 8 shiften), <em>Verlof 4</em> (max 4) en <em>Verlof 2</em> (max 2).
    Medewerkers duiden die aan in hun werkkalender; in de teamkalender verschijnen ze in hun kleur.
    Een categorie zonder jaar geldt voor alle jaren; categorieën met een jaar vervangen voor dat jaar de standaard.
</p>

<!-- Filters -->
<RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="0.5rem" AlignItems="AlignItems.End" Style="margin-bottom:1rem">
    <div>
        <label>Ploeg</label>
        <RadzenDropDown TValue="string" Data="@teams" @bind-Value="teamFilter" AllowClear="@(isAdmin || Scope.HasChoice)" Placeholder="Alle" Style="width:160px" />
    </div>
    <div>
        <label>Specialiteit</label>
        <RadzenDropDown TValue="string" Data="@specialities" @bind-Value="specialityFilter" AllowClear="@(isAdmin || Scope.HasChoice)" Placeholder="Alle" Style="width:200px" />
    </div>
    <RadzenButton Icon="add" Text="Categorie toevoegen" Click="@StartCreate" Disabled="@(editing != null)" />
</RadzenStack>

@if (editing != null)
{
    <RadzenCard Style="margin-bottom:1rem; max-width:900px;">
        <h5>@(editing.Id == 0 ? "Nieuwe categorie" : "Categorie wijzigen")</h5>
        <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="1rem">
            @if (editing.Id == 0)
            {
                <div>
                    <label>Ploeg(en)</label>
                    <RadzenDropDown TValue="IEnumerable<string>" Data="@teams" @bind-Value="createTeams" Multiple="true" Chips="true" Style="width:260px" />
                </div>
                <div>
                    <label>Specialiteit(en)</label>
                    <RadzenDropDown TValue="IEnumerable<string>" Data="@specialities" @bind-Value="createSpecialities" Multiple="true" Chips="true" Style="width:320px" />
                </div>
            }
            else
            {
                <div>
                    <label>Ploeg</label>
                    <RadzenDropDown TValue="string" Data="@teams" @bind-Value="editing.Team" Style="width:160px" />
                </div>
                <div>
                    <label>Specialiteit</label>
                    <RadzenDropDown TValue="string" Data="@specialities" @bind-Value="editing.Speciality" Style="width:200px" />
                </div>
            }
            <div>
                <label>Jaar (leeg = alle jaren)</label>
                <RadzenDropDown TValue="int?" Data="@years" @bind-Value="editing.Year" AllowClear="true" Placeholder="Alle jaren" Style="width:160px" />
            </div>
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="1rem" Style="margin-top:1rem">
            <div>
                <label>Naam</label>
                <RadzenTextBox @bind-Value="editing.Name" MaxLength="50" Placeholder="bv. Groot verlof" Style="width:220px" />
            </div>
            <div>
                <label>Max. shiften</label>
                <RadzenNumeric TValue="int" @bind-Value="editing.MaxShifts" Min="0" Max="366" Style="width:120px" />
            </div>
            <div>
                <label>Volgorde</label>
                <RadzenNumeric TValue="int" @bind-Value="editing.SortOrder" Min="0" Max="99" Style="width:100px" />
            </div>
            <div>
                <label>Aansluitend</label>
                <div style="display:flex; align-items:center; gap:.4rem; height:2.25rem;">
                    <RadzenCheckBox TValue="bool" @bind-Value="editing.MustBeConsecutive" Name="consecutive" />
                    <RadzenLabel Text="Shiften moeten een ononderbroken reeks zijn" Component="consecutive" />
                </div>
            </div>
            <div>
                <label>Kleur</label>
                <div style="display:flex; align-items:center; gap:.35rem;">
                    @foreach (var color in palette)
                    {
                        <button type="button" title="@color" @onclick="() => editing.Color = color"
                                style="@($"width:24px; height:24px; border-radius:50%; background:{color}; cursor:pointer; border:{(string.Equals(editing.Color, color, StringComparison.OrdinalIgnoreCase) ? "3px solid #000" : "1px solid #ccc")};")"></button>
                    }
                    <RadzenTextBox @bind-Value="editing.Color" MaxLength="7" Style="width:100px" />
                </div>
            </div>
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Style="margin-top:1rem">
            <RadzenButton Icon="save" Text="Opslaan" Click="@Save" />
            <RadzenButton Icon="close" Text="Annuleren" ButtonStyle="ButtonStyle.Light" Click="@(() => editing = null)" />
        </RadzenStack>
    </RadzenCard>
}

<RadzenDataGrid TItem="LeaveCategoryDTO" Data="@FilteredRules" AllowSorting="true" AllowPaging="true" PageSize="25" EmptyText="Nog geen verlofcategorieën.">
    <Columns>
        <RadzenDataGridColumn TItem="LeaveCategoryDTO" Property="Team" Title="Ploeg" Width="110px" />
        <RadzenDataGridColumn TItem="LeaveCategoryDTO" Property="Speciality" Title="Specialiteit" Width="150px" />
        <RadzenDataGridColumn TItem="LeaveCategoryDTO" Property="Year" Title="Jaar" Width="100px">
            <Template Context="r">@(r.Year?.ToString() ?? "Alle jaren")</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="LeaveCategoryDTO" Property="Name" Title="Categorie">
            <Template Context="r">
                <span style="display:inline-flex; align-items:center; gap:.4rem;">
                    <span style="@($"display:inline-block; width:14px; height:14px; border-radius:50%; background:{r.Color};")"></span>
                    @r.Name
                </span>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="LeaveCategoryDTO" Property="MaxShifts" Title="Max. shiften" Width="120px" />
        <RadzenDataGridColumn TItem="LeaveCategoryDTO" Property="MustBeConsecutive" Title="Aansluitend" Width="120px">
            <Template Context="r">@(r.MustBeConsecutive ? "Ja" : "Nee")</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="LeaveCategoryDTO" Property="SortOrder" Title="Volgorde" Width="100px" />
        <RadzenDataGridColumn TItem="LeaveCategoryDTO" Title="" Width="120px" Sortable="false">
            <Template Context="r">
                <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => StartEdit(r))" Disabled="@(editing != null)" />
                <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Click="@(() => Delete(r))" Disabled="@(editing != null)" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    private List<LeaveCategoryDTO> rules = new();
    private List<string> teams = new();
    private List<string> specialities = new();
    private List<int> years = Enumerable.Range(DateTime.Now.Year - 1, 12).ToList();
    // Goed te onderscheiden van de huisstijl (rood #F13F3F, blauw #2F80ED) en verlof (blauwgroen), leesbaar met witte tekst
    private readonly string[] palette = { "#E53935", "#FB8C00", "#FDD835", "#43A047", "#1E88E5", "#8E24AA", "#6D4C41", "#546E7A" };

    private string? teamFilter;
    private string? specialityFilter;

    private LeaveCategoryDTO? editing;
    private IEnumerable<string> createTeams = Array.Empty<string>();
    private IEnumerable<string> createSpecialities = Array.Empty<string>();

    private IEnumerable<LeaveCategoryDTO> FilteredRules => rules
        .Where(r => teamFilter == null || r.Team == teamFilter)
        .Where(r => specialityFilter == null || r.Speciality == specialityFilter);

    protected override async Task OnInitializedAsync()
    {
        teams = await Http.GetFromJsonAsync<List<string>>("api/meta/teams") ?? new();
        specialities = await Http.GetFromJsonAsync<List<string>>("api/meta/specialities") ?? new();

        // Manager: enkel zijn eigen ploeg en specialiteit (de API controleert dit ook)
        var me = await CurrentPerson.GetAsync();
        isAdmin = CurrentPersonService.IsAdmin(me);
        if (!isAdmin && me != null)
        {
            // Manager: de ploegen en specialiteiten die hij beheert (de API controleert dit ook)
            await Scope.LoadAsync(refresh: true);
            teams = Scope.Teams;
            specialities = teams.SelectMany(t => Scope.SpecialitiesFor(t)).Distinct().OrderBy(s => Scope.AllSpecialityNames.IndexOf(s)).ToList();
            if (!Scope.HasChoice)
            {
                teamFilter = me.Team;
                specialityFilter = me.Speciality;
            }
        }

        await LoadRules();
    }

    private bool isAdmin;

    private async Task LoadRules()
        => rules = await Http.GetFromJsonAsync<List<LeaveCategoryDTO>>("api/leave-categories/rules") ?? new();

    private void StartCreate()
    {
        editing = new LeaveCategoryDTO { MaxShifts = 8, Color = palette[0], SortOrder = 1 };
        createTeams = teamFilter != null ? new[] { teamFilter } : Array.Empty<string>();
        createSpecialities = specialityFilter != null ? new[] { specialityFilter } : Array.Empty<string>();
    }

    private void StartEdit(LeaveCategoryDTO r) => editing = new LeaveCategoryDTO
    {
        Id = r.Id, Team = r.Team, Speciality = r.Speciality, Year = r.Year,
        Name = r.Name, MaxShifts = r.MaxShifts, Color = r.Color, SortOrder = r.SortOrder, MustBeConsecutive = r.MustBeConsecutive
    };

    private async Task Save()
    {
        if (editing == null) return;

        if (editing.Id == 0)
        {
            if (!createTeams.Any() || !createSpecialities.Any())
            {
                Notify(NotificationSeverity.Warning, "Kies minstens één ploeg en één specialiteit.");
                return;
            }

            // Eén categorie per gekozen combinatie ploeg x specialiteit
            var created = 0;
            foreach (var team in createTeams)
            foreach (var spec in createSpecialities)
            {
                var dto = new LeaveCategoryDTO
                {
                    Team = team, Speciality = spec, Year = editing.Year, Name = editing.Name,
                    MaxShifts = editing.MaxShifts, Color = editing.Color, SortOrder = editing.SortOrder, MustBeConsecutive = editing.MustBeConsecutive
                };
                var resp = await Http.PostAsJsonAsync("api/leave-categories/rules", dto);
                if (!resp.IsSuccessStatusCode)
                {
                    Notify(NotificationSeverity.Error, await resp.Content.ReadAsStringAsync());
                    await LoadRules();
                    return;
                }
                created++;
            }
            Notify(NotificationSeverity.Success, $"{created} categorie(ën) toegevoegd.");
        }
        else
        {
            var resp = await Http.PutAsJsonAsync($"api/leave-categories/rules/{editing.Id}", editing);
            if (!resp.IsSuccessStatusCode)
            {
                Notify(NotificationSeverity.Error, await resp.Content.ReadAsStringAsync());
                return;
            }
            Notify(NotificationSeverity.Success, "Categorie bijgewerkt.");
        }

        editing = null;
        await LoadRules();
    }

    private async Task Delete(LeaveCategoryDTO r)
    {
        var ok = await DialogService.Confirm(
            $"'{r.Name}' voor {r.Team}/{r.Speciality} verwijderen? Aangeduide shiften worden weer gewoon verlof.",
            "Verwijderen", new ConfirmOptions { OkButtonText = "Verwijderen", CancelButtonText = "Annuleren" });
        if (ok != true) return;

        var resp = await Http.DeleteAsync($"api/leave-categories/rules/{r.Id}");
        if (resp.IsSuccessStatusCode)
        {
            Notify(NotificationSeverity.Success, "Categorie verwijderd.");
            await LoadRules();
        }
        else
        {
            Notify(NotificationSeverity.Error, "Verwijderen mislukt.");
        }
    }

    private void Notify(NotificationSeverity severity, string detail)
        => Notifications.Notify(new NotificationMessage { Severity = severity, Summary = "Verlofcategorieën", Detail = detail, Duration = 4000 });
}
