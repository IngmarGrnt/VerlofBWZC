@using Radzen
@using Radzen.Blazor
@using VerlofBWZC.Handler
@inject IJSRuntime JS
@inject NavigationManager Navigation




@if (isLoggedIn)
{
    <div class="top-row ps-3 navbar navbar-dark">
        <div class="container-fluid">
            <img src="LogoBWZC.png" alt="BWZC" class="navbar-logo" />
            <a class="navbar-brand" href="">Verlof BWZC</a>
            <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
        </div>
    </div>
    <div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
        <nav class="nav flex-column">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="WorkCalendar">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Werkkalender
                </NavLink>
            </div>
            @if (userRole == "Admin"|| userRole == "Manager")
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="TeamCalendar">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Teamkalender
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Random-picker">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Naam Loterij
                    </NavLink>
                </div>
            }
            @if (userRole == "Admin") 
            {  
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="person-crud">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Personen
                    </NavLink>
                </div>
            }
            <div class="nav-item px-3">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="20rem" Wrap="FlexWrap.Wrap">
                <RadzenButton ButtonStyle="ButtonStyle.Primary"
                              ButtonType="ButtonType.Button"
                              Text="Log Uit"
                              Icon="report"
                              Click="Logout"
                              class="logout-nav" />
                </RadzenStack>
            </div>
        </nav>
    </div>

}

@code {
    private bool collapseNavMenu = true;
    private bool isLoggedIn;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    string? userRole;
    string? token;  

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        await CheckLoginStatus();
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        await CheckLoginStatus();
    }

    private async Task CheckLoginStatus()
    {
        token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        isLoggedIn = !string.IsNullOrEmpty(token);
        userRole = JwtUtils.GetUserRolFromToken(token);
        //Console.WriteLine($"User Role: {userRole}");
        StateHasChanged();
    }


    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
    private string? userName;
    private async Task Logout()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "authToken");
        isLoggedIn = false;
        userName = null;
        StateHasChanged();
        Navigation.NavigateTo("/login", true);
    }
}
}
