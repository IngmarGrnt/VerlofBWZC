@using Radzen
@using Radzen.Blazor
@using VerlofBWZC.Handler
@using VerlofBWZC.DataContracts.DTO.Access
@using System.Net.Http
@using System.Net.Http.Headers
@using System.Net.Http.Json
@inject VerlofBWZC.Services.JwtAuthenticationStateProvider AuthProvider
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject HttpClient Http
@inject VerlofBWZC.Services.DemoModeService Demo
@inject DialogService DialogService
@inject VerlofBWZC.Services.AppInstallService Install
@implements IDisposable

@if (isLoggedIn)
{
    <div class="nav-scrollable">
        <nav class="nav flex-column">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <i class="bi bi-house-door-fill" aria-hidden="true"></i>
                    <span class="menu-text">Home</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="WorkCalendar">
                    <i class="bi bi-calendar-event" aria-hidden="true"></i>
                    <span class="menu-text">Werkkalender</span>
                </NavLink>
            </div>

            @* Toon Teamkalender als Admin/Manager of als permissie CanSeeTeamCalendar = true *@
            @if ((userRole == "Admin" || userRole == "Manager") || canSeeTeamCalendar)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="TeamCalendar">
                        <i class="bi bi-people-fill" aria-hidden="true"></i>
                        <span class="menu-text">Teamkalender</span>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Quarterlyleave">
                        <i class="bi bi-layers-half" aria-hidden="true"></i>
                        <span class="menu-text">Kwartaalverlof</span>
                    </NavLink>
                </div>
            }
        
            @if (userRole == "Admin" || userRole == "Manager")
            {
                <div class="nav-item px-3 nav-desktop-only">
                    <NavLink class="nav-link" href="Random-picker">
                        <i class="bi bi-dice-5-fill" aria-hidden="true"></i>
                        <span class="menu-text">Loterij</span>
                    </NavLink>
                </div>

                @* Verlofregels en beheer: Admin voor alle ploegen, Manager voor de ploegen en specialiteiten die hij beheert. Loterij en Verlofregels niet op gsm (nav-desktop-only) *@
                <div class="nav-section nav-desktop-only">Verlofregels</div>
                <div class="nav-item px-3 nav-desktop-only">
                    <NavLink class="nav-link" href="verlofregels">
                        <i class="bi bi-list-check" aria-hidden="true"></i>
                        <span class="menu-text">Verlofcategorieën</span>
                    </NavLink>
                </div>
                <div class="nav-item px-3 nav-desktop-only">
                    <NavLink class="nav-link" href="kwartaalmaxima">
                        <i class="bi bi-bar-chart-steps" aria-hidden="true"></i>
                        <span class="menu-text">Kwartaalmaxima</span>
                    </NavLink>
                </div>
                <div class="nav-item px-3 nav-desktop-only">
                    <NavLink class="nav-link" href="max-per-shift">
                        <i class="bi bi-people" aria-hidden="true"></i>
                        <span class="menu-text">Max per shift</span>
                    </NavLink>
                </div>

                <div class="nav-section">Beheer</div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="ManagerPanel">
                        <i class="bi bi-shield-lock" aria-hidden="true"></i>
                        <span class="menu-text">Manager Paneel</span>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="person-crud">
                        <i class="bi bi-person-lines-fill" aria-hidden="true"></i>
                        <span class="menu-text">Personen</span>
                    </NavLink>
                </div>
            }
            @if (canStartDemo)
            {
                <div class="nav-item px-3">
                    <button type="button" class="nav-link nav-demo" @onclick="OpenDemo">
                        <i class="bi bi-eye" aria-hidden="true"></i>
                        <span class="menu-text">Demo modus</span>
                    </button>
                </div>
            }
            @if (installReady && !Install.Current.Standalone)
            {
                @* Als app op het beginscherm zetten (niet getoond als ze al als app open is) *@
                <div class="nav-item px-3">
                    <button type="button" class="nav-link nav-demo" @onclick="InstallAppAsync">
                        <i class="bi bi-phone" aria-hidden="true"></i>
                        <span class="menu-text">App installeren</span>
                    </button>
                </div>
            }
            <div class="nav-item px-3">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="20rem" Wrap="FlexWrap.Wrap">
                    <RadzenButton ButtonStyle="ButtonStyle.Danger"
                                  Variant="Variant.Outlined"
                                  ButtonType="ButtonType.Button"
                                  Text="Uitloggen"
                                  Icon="logout"
                                  Click="Logout"
                                  class="logout-nav" />
                </RadzenStack>
            </div>
        </nav>
    </div>
}

@code {
    private bool isLoggedIn;
    private string? userRole;
    private string? token;
    private string? userName;
    private bool canSeeTeamCalendar; // permissie-flag uit ManagerPanel regels
    private CalendarPermissionsDTO? _perms;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        await CheckLoginStatus();
    }

    // --- App installeren ---
    private bool installReady;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        Install.Changed += OnInstallChanged;
        await Install.InitAsync();
        installReady = true;
        StateHasChanged();
    }

    private void OnInstallChanged() => InvokeAsync(StateHasChanged);

    private async Task InstallAppAsync()
    {
        // Android/Chrome/Edge: meteen de installatievraag; anders (iPhone, andere browsers) uitleg
        if (Install.Current.CanPrompt)
            await Install.PromptAsync();
        else
            await InstallHelpDialog.ShowAsync(DialogService, Install.Current);
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        await CheckLoginStatus();
    }

    private async Task CheckLoginStatus()
    {
        token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        isLoggedIn = !string.IsNullOrEmpty(token);
        userRole = VerlofBWZC.Handler.JwtUtils.GetUserRolFromToken(token);
        canStartDemo = isLoggedIn && await Demo.CanStartAsync();

        if (isLoggedIn)
        {
            await LoadPermissions(); // laad CanSeeTeamCalendar
        }
        else
        {
            _perms = null;
            canSeeTeamCalendar = false;
        }

        StateHasChanged();
    }

    private async Task LoadPermissions()
    {
        try
        {
            var year = DateTime.Now.AddYears(1).Year; // zelfde “open jaar” als in de kalenders
            using var req = new HttpRequestMessage(HttpMethod.Get, $"api/access/calendar-permissions?year={year}");
            if (!string.IsNullOrEmpty(token))
                req.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var resp = await Http.SendAsync(req);
            if (resp.IsSuccessStatusCode)
            {
                _perms = await resp.Content.ReadFromJsonAsync<CalendarPermissionsDTO>();
                canSeeTeamCalendar = _perms?.CanSeeTeamCalendar ?? false;
            }
            else
            {
                _perms = null;
                canSeeTeamCalendar = false;
            }
        }
        catch
        {
            _perms = null;
            canSeeTeamCalendar = false;
        }
    }

    // Demo modus: enkel voor een echte admin (niet vanuit een demo-sessie)
    private bool canStartDemo;

    private async Task OpenDemo()
    {
        await DialogService.OpenAsync<DemoDialog>("Demo modus", options: new DialogOptions { Width = "460px" });
    }

    private async Task Logout()
    {
        await AuthProvider.MarkUserAsLoggedOut();
        isLoggedIn = false;
        userName = null;
        _perms = null;
        canSeeTeamCalendar = false;
        StateHasChanged();
        Navigation.NavigateTo("/login", true);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        Install.Changed -= OnInstallChanged;
    }
}
