@inject IJSRuntime JS
@inject NavigationManager Navigation
@using Radzen
@using Radzen.Blazor

@if (isLoggedIn)
{

   @*  <button class="nav-link btn btn-link" @onclick="Logout">Log uit</button> *@

            <RadzenButton 
            ButtonStyle="ButtonStyle.Primary"
            ButtonType="ButtonType.Button"
            Text="Log Uit"
            click="Logout">
        </RadzenButton>
}


@code {
    private bool isLoggedIn;
    private string? userName;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        await CheckLoginStatus();
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        await CheckLoginStatus();
    }

    private async Task CheckLoginStatus()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        isLoggedIn = !string.IsNullOrEmpty(token);
        userName = isLoggedIn ? GetNameFromToken(token) : null;
        Console.WriteLine($"Login status checked. IsLoggedIn: {isLoggedIn}, UserName: {userName}");
        StateHasChanged();
    }

    private string? GetNameFromToken(string token)
    {
        try
        {
            var parts = token.Split('.');
            if (parts.Length != 3)
                return null;

            var payload = parts[1];
            switch (payload.Length % 4)
            {
                case 2: payload += "=="; break;
                case 3: payload += "="; break;
            }
            var json = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(payload));
            var doc = System.Text.Json.JsonDocument.Parse(json);

            // Zoek naar de volledige claimnaam
            foreach (var prop in doc.RootElement.EnumerateObject())
            {
                if (prop.Name.EndsWith("/name", StringComparison.OrdinalIgnoreCase))
                    return prop.Value.GetString();
            }

            return null;
        }
        catch
        {
            return null;
        }
    }

    private async Task Logout()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "authToken");
        isLoggedIn = false;
        userName = null;
        StateHasChanged();
        Navigation.NavigateTo("/login", true);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}