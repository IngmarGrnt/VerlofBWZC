@inject NavigationManager Navigation
@inject VerlofBWZC.Services.JwtAuthenticationStateProvider AuthProvider
@using Radzen
@using Radzen.Blazor

@code {
    private bool isLoggedIn;
    private string? userName;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        await CheckLoginStatus();
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        await CheckLoginStatus();
    }

    private async Task CheckLoginStatus()
    {
        // Laat bestaande UI intact; optioneel kun je hier AuthenticationState gebruiken.
        var token = await Microsoft.JSInterop.JSRuntimeExtensions.InvokeAsync<string>(
            (Microsoft.JSInterop.IJSRuntime)AuthProvider.GetType()
                .GetProperty("JSRuntime", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)?.GetValue(AuthProvider) ?? default!,
            "localStorage.getItem",
            "authToken");

        isLoggedIn = !string.IsNullOrEmpty(token);
        userName = null; // Simplified; naam kan uit claims gehaald worden indien gewenst
        StateHasChanged();
    }

    private async Task Logout()
    {
        await AuthProvider.MarkUserAsLoggedOut();
        StateHasChanged();
        Navigation.NavigateTo("/login", true);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}