@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject VerlofBWZC.Services.DemoModeService Demo
@using Radzen
@using Radzen.Blazor

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0" Style="width:100%; padding:0 .75rem;">
            @if (isLoggedIn)
            {
                <RadzenSidebarToggle class="toggle-desktop" Click="@(() => sidebarExpanded = !sidebarExpanded)" />
            }
            <img src="LogoBWZC.png" alt="BWZC" class="navbar-logo" />
        </RadzenStack>
    </RadzenHeader>

    @if (isLoggedIn)
    {
        <RadzenSidebar @bind-Expanded="@sidebarExpanded">
            <div class="rz-p-3">
                <NavMenu />
            </div>
        </RadzenSidebar>

        @* Gsm/tablet: donkere achtergrond achter het menu; tikken sluit het menu (enkel zichtbaar via CSS op kleine schermen) *@
        @if (sidebarExpanded)
        {
            <div class="mobile-menu-backdrop" @onclick="@(() => sidebarExpanded = false)"></div>
        }
    }

    <RadzenBody>
        <article class="content px-4">
            <RadzenNotification />
            @if (demo != null)
            {
                <div class="demo-banner" role="status">
                    <i class="bi bi-eye" aria-hidden="true"></i>
                    <span><strong>Demo modus</strong> · @demo.Role · @demo.Team · @demo.Speciality · alleen bekijken, opslaan is niet mogelijk</span>
                    <RadzenButton Text="Stoppen" Icon="close" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@StopDemo" />
                </div>
            }
            @Body
        </article>
    </RadzenBody>
</RadzenLayout>

<RadzenDialog />
@code {
    private bool isLoggedIn;
    private bool sidebarExpanded = true;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        await CheckLoginStatus();
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Gsm/tablet: menu sluiten zodra een pagina gekozen is
        if (isMobile)
            sidebarExpanded = false;
        await CheckLoginStatus();
    }

    // Gsm/tablet (<= 768px): menu als schuiflade over de pagina, standaard dicht
    private bool isMobile;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        isMobile = await JS.InvokeAsync<bool>("bwzcIsMobile");
        if (isMobile && sidebarExpanded)
        {
            sidebarExpanded = false;
            StateHasChanged();
        }
    }

    private async Task CheckLoginStatus()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        var wasLoggedIn = isLoggedIn;
        isLoggedIn = !string.IsNullOrEmpty(token);

        // Tijdelijk of zwak wachtwoord: niets anders gebruiken tot er een nieuw wachtwoord gekozen is
        if (VerlofBWZC.Handler.JwtUtils.MustChangePassword(token)
            && !Navigation.Uri.Contains("/wachtwoord-wijzigen", StringComparison.OrdinalIgnoreCase)
            && !Navigation.Uri.Contains("/login", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/wachtwoord-wijzigen");
            return;
        }
        demo = isLoggedIn ? await Demo.GetActiveAsync() : null;
        if (!isLoggedIn) sidebarExpanded = false;
        else if (!wasLoggedIn) sidebarExpanded = !isMobile; // na inloggen: menu open op desktop, dicht op gsm
        StateHasChanged();
    }

    // Demo modus (admin bekijkt de app als andere rol/ploeg/specialiteit)
    private VerlofBWZC.Services.DemoModeService.DemoInfo? demo;

    private Task StopDemo() => Demo.StopAsync();

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}